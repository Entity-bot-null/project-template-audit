# API environment. Copy to .env for local development (pnpm dev starts the
# database and the mail catcher below). Every variable is declared and validated in
# src/env/env.schema.ts: the API refuses to boot on a missing or malformed
# value. Production values come from the deployment platform's secret store,
# never from a committed file. Documented in docs/environment.md.

NODE_ENV=development
PORT=3200
# Interface to listen on. Default: 127.0.0.1 outside production; in production,
# every interface, IPv4 and IPv6 (containers).
# HOST=127.0.0.1

# PostgreSQL from docker-compose.yml (local development only).
DATABASE_URL=postgresql://app:app@localhost:5452/app

# Signs the access tokens (HS256): 64+ characters, one per environment.
#   openssl rand -hex 32
JWT_ACCESS_SECRET=
# During a planned rotation only: the old secret, still accepted when
# verifying until the tokens it signed expire (docs/security.md#secret-rotation).
# JWT_ACCESS_SECRET_PREVIOUS=

# Browser origins allowed to call the API cross-origin, comma separated.
# Empty: same-origin only (the web app reaches /api through its own origin).
# CORS_ORIGINS=https://app.example.com

# The origin the web app is served from: links in emails point to it (never
# to a request's Host), and behind the proxy browsers that send no Fetch
# Metadata (older Safari) pass the CSRF guard with it
# (docs/security.md#csrf-cors-xss). Required with MAIL_SMTP_URL; https in
# production, e.g. https://app.example.com.
APP_ORIGIN=http://localhost:5273

# Which proxies may set X-Forwarded-For (client IP for rate limiting and
# logs): a hop count, or addresses/subnets. Required in production (1 behind
# the web image); default elsewhere: loopback.
# TRUST_PROXY=loopback

# SameSite of the refresh cookie: strict (default), lax, or none (cross-site
# deployments, production only since it requires Secure).
# AUTH_COOKIE_SAMESITE=strict

# Requests per window per client IP, counted per route. Sign-in and refresh
# also have tighter limits of their own, counted on top of this one.
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_SEC=60

# fatal, error, warn, log, debug or verbose; json or text (default: json in
# production, text elsewhere).
# LOG_LEVEL=log
# LOG_FORMAT=text

# --- Deployment identity (docs/observability.md#identity) ------------------
# On every JSON log line, error report and span. APP_ENVIRONMENT tells staging
# from production (default: NODE_ENV); APP_RELEASE is set by the image build
# (the commit SHA).
# APP_ENVIRONMENT=development
# APP_RELEASE=unversioned

# Queries slower than this many milliseconds are logged (statement only, never
# values). 0 turns the log off.
# DB_SLOW_QUERY_MS=500
# Connections this API instance may hold. Instances x DB_POOL_MAX must fit in
# the database's connection limit (docs/database.md#connections).
# DB_POOL_MAX=10
# The database cancels a statement that runs longer than this many
# milliseconds (a lock wait, a runaway query): no request holds a connection
# forever (docs/database.md#connections).
# DB_STATEMENT_TIMEOUT_MS=30000

# Email (docs/architecture.md#email). Locally, Mailpit (pnpm dev starts it):
# every message lands at http://localhost:8045, nothing leaves the machine.
# Unset MAIL_SMTP_URL: email is off. Production: your provider's SMTP server,
# encrypted (smtps://, or smtp:// with STARTTLS), credentials percent-encoded
# in the URL (docs/environment.md).
MAIL_SMTP_URL=smtp://localhost:1045
MAIL_FROM="Project template <no-reply@example.test>"
# Delivery attempts per message, and messages an address may get per day from
# requests anyone can make (at most one a minute besides).
# MAIL_MAX_ATTEMPTS=8
# MAIL_DAILY_LIMIT_PER_ADDRESS=10

# Public sign-up (docs/security.md#sign-up) stays off: Audit Hub's accounts
# come from invitations or user:create, and `true` stops the boot.
SIGN_UP_ENABLED=false

# --- Everything below is OPTIONAL: the API runs without any of it. ----------

# Error tracking (docs/observability.md#error-tracking): the Sentry DSN of the
# API project. Unset: errors are only logged.
# SENTRY_DSN=https://<public key>@<host>/<project id>
# SENTRY_SAMPLE_RATE=1

# Tracing and metrics (docs/observability.md#opentelemetry): an OTLP/HTTP
# endpoint. Unset: OpenTelemetry is not loaded at all. Local backend:
#   docker compose --profile observability up -d   (then http://localhost:4328)
# Provider credentials go in OTEL_EXPORTER_OTLP_HEADERS, never in code.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4328
# Incident kill switch: true turns telemetry off whatever the endpoint.
# OTEL_SDK_DISABLED=false
# OTEL_SERVICE_NAME=api
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_METRIC_EXPORT_INTERVAL=60000
# Extra resource attributes, read by the SDK: the API sends no host name of
# its own (docs/observability.md#identity).
# OTEL_RESOURCE_ATTRIBUTES=host.name=app-1

# Redis (docs/architecture.md#redis). Unset: nothing connects to Redis and
# every feature uses its in-process implementation. Local Redis:
#   docker compose --profile redis up -d   (password from the root .env)
# REDIS_URL=redis://:<REDIS_PASSWORD from the root .env>@127.0.0.1:6389
# REDIS_KEY_PREFIX=app:
# REDIS_REQUIRED=false
# REDIS_COMMAND_TIMEOUT_MS=500
# Shared counters and cache for several instances (both need REDIS_URL).
# RATE_LIMIT_STORE=memory
# CACHE_STORE=memory

# --- Audit Hub ---------------------------------------------------------------
# Encrypts the secrets Audit Hub keeps (applications' signing keys, webhook
# secrets, pseudonymization keys, second factors) with AES-256-GCM. Required
# in production (openssl rand -hex 32, kept in the secret store; docs/adr/0006).
# Unset outside production: derived from JWT_ACCESS_SECRET, with a warning.
# AUDIT_SECRETS_KEY=
# During a rotation only: the previous key, which decrypts and never encrypts.
# AUDIT_SECRETS_KEY_PREVIOUS=
# Signs the audit log's integrity seals (HMAC-SHA256, docs/adr/0008); never
# stored in the database. Required in production; unset outside production:
# derived from JWT_ACCESS_SECRET, with a warning.
# AUDIT_INTEGRITY_KEY=
# During a rotation only: verifies older seals, never signs.
# AUDIT_INTEGRITY_KEY_PREVIOUS=
# New alerts in a Slack channel or a Teams workflow (their incoming webhook
# URL, https; a secret: whoever has it can post). Unset: off (docs/adr/0013).
# AUDIT_SLACK_WEBHOOK_URL=
# AUDIT_TEAMS_WEBHOOK_URL=
# true lets webhooks reach private addresses (applications in the same private
# network). Default false: such a URL is refused when sent (SSRF).
# AUDIT_WEBHOOKS_ALLOW_PRIVATE_NETWORKS=false
# IP geolocation, optional (docs/adr/0011): .mmdb files, read-only. Unset: off.
# A path that is set but unreadable fails the boot.
# GEOIP_CITY_DB_PATH=
# GEOIP_ASN_DB_PATH=
# Hosting and VPN networks for the hosting IP rule, one ASN per line.
# GEOIP_HOSTING_ASNS_PATH=
