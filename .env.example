# Read by docker compose from a root .env (copy this file to .env).
# The API has its own apps/api/.env.example; apps/web/.env.example lists the
# web app's optional settings.

# Host port of the development database (127.0.0.1 only). 5452 by default,
# not PostgreSQL's 5432, so it does not collide with a PostgreSQL installed on
# the machine. Change it when 5452 is taken too, and update DATABASE_URL in
# apps/api/.env to match.
# DB_PORT=5452

# Host ports of the development mail catcher, Mailpit (127.0.0.1 only): SMTP
# and its web UI. 1045 and 8045 by default, not Mailpit's 1025 and 8025, so
# it does not share ports with another project's Mailpit. Change them when
# taken, and MAIL_SMTP_URL in apps/api/.env to match.
# MAILPIT_SMTP_PORT=1045
# MAILPIT_UI_PORT=8045

# Production-like stack only (docker compose --profile stack up --build):
# the API refuses to boot without these three. Generate each with:
# openssl rand -hex 32
JWT_ACCESS_SECRET=
AUDIT_SECRETS_KEY=
AUDIT_INTEGRITY_KEY=
# WEB_PORT=8180
# The build the stack's images report on logs and error reports, baked in at
# build time (default: local): letters, digits, ".", "_", "+", "-", such as a
# commit SHA.
# APP_RELEASE=local

# --- Optional services -------------------------------------------------------

# Redis (docker compose --profile redis up -d). Required by that profile only:
# the container refuses to start without it. Generate: openssl rand -hex 24
# Then in apps/api/.env: REDIS_URL=redis://:<this password>@127.0.0.1:6389
REDIS_PASSWORD=
# REDIS_PORT=6389

# Local OpenTelemetry backend (docker compose --profile observability up -d).
# OTLP_HTTP_PORT=4328
# GRAFANA_PORT=3201
# PROMETHEUS_PORT=9190

# The production-like stack with optional integrations (all off by default):
# STACK_REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379   (with --profile redis)
# STACK_RATE_LIMIT_STORE=redis
# STACK_CACHE_STORE=redis
# STACK_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318   (with --profile observability)
# STACK_SENTRY_DSN=
# STACK_WEB_SENTRY_DSN=
