# The API container's configuration (copy to api.env, chmod 600). Secrets:
# never commit the filled-in file. Every variable: docs/environment.md.

# The runtime role: data access only, no schema changes. TLS to the database.
# On DigitalOcean or Amazon RDS, end the URL with ?sslmode=require&uselibpqcompat=true
# (docs/deploy-vps.md#6-the-files-on-the-server); the Terraform outputs do.
# A placeholder, not a credential: filled in on the server only.
# secretlint-disable-next-line @secretlint/secretlint-rule-database-connection-string
DATABASE_URL=postgresql://app_runtime:<password>@<database host>:5432/app?sslmode=require
# openssl rand -hex 32 (one per environment).
JWT_ACCESS_SECRET=
# openssl rand -hex 32, kept in the secret store: encrypts the secrets Audit
# Hub keeps (applications' keys, webhook secrets, second factors). Losing it
# makes them unusable (docs/adr/0006).
AUDIT_SECRETS_KEY=
# openssl rand -hex 32, kept in the secret store and nowhere else: signs the
# audit log's integrity seals (docs/adr/0008).
AUDIT_INTEGRITY_KEY=
# Optional (docs/adr/0013): new alerts in a Slack channel or a Teams workflow,
# their incoming webhook URLs (secrets).
# AUDIT_SLACK_WEBHOOK_URL=
# AUDIT_TEAMS_WEBHOOK_URL=
# Optional (docs/adr/0011): IP geolocation from .mmdb files mounted read-only
# into the API container (deploy-vps.md, "IP geolocation").
# GEOIP_CITY_DB_PATH=/geoip/dbip-city-lite.mmdb
# GEOIP_ASN_DB_PATH=/geoip/dbip-asn-lite.mmdb
# GEOIP_HOSTING_ASNS_PATH=/geoip/hosting-asns.txt
# staging or production: tags every log line and error report.
APP_ENVIRONMENT=production
# The public origin of the app (https:// + APP_DOMAIN): browsers that send no
# Fetch Metadata (older Safari) are refused by the CSRF guard without it, and
# links in emails point to it.
APP_ORIGIN=https://app.example.com

# Email, optional (docs/manual.md#115-email): your provider's SMTP server,
# encrypted (smtps://, or smtp:// with STARTTLS), the password percent-encoded.
# Unset: email is off. Then: authenticate the sending domain (SPF, DKIM, DMARC).
# MAIL_SMTP_URL=smtps://<user>:<password>@<provider host>:465
# MAIL_FROM="<Product> <no-reply@app.example.com>"
# No public sign-up (docs/security.md#sign-up): accounts come from invitations
# or user:create. SIGN_UP_ENABLED=true stops the boot.

# Optional (docs/environment.md):
# SENTRY_DSN=
# DB_POOL_MAX=10
# LOG_LEVEL=log
