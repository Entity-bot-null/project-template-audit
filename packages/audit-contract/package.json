{
  "name": "audit-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Integration contract of Audit Hub: event, catalog, ingestion and webhook schemas, canonical JSON, UUIDv7 and request signing.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "scripts": {
    "postinstall": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "schemas": "tsc -p tsconfig.build.json && node scripts/generate-schemas.mjs"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
