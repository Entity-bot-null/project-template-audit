{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "security",
              "audit",
              "access",
              "system",
              "audit_access"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "success",
              "failure",
              "denied"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "role": {
            "type": "string",
            "enum": [
              "actor",
              "resource"
            ]
          },
          "details": {},
          "change": {
            "type": "object",
            "properties": {
              "before": {},
              "after": {}
            },
            "additionalProperties": false
          },
          "client": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "web",
                  "ios",
                  "android",
                  "api",
                  "job"
                ]
              },
              "os": {
                "type": "string",
                "maxLength": 32
              },
              "deviceModel": {
                "type": "string",
                "maxLength": 64
              },
              "appVersion": {
                "type": "string",
                "maxLength": 32
              }
            },
            "additionalProperties": false
          },
          "network": {
            "type": "object",
            "properties": {
              "ip": {
                "type": "string",
                "maxLength": 64
              },
              "userAgent": {
                "type": "string",
                "maxLength": 1024
              },
              "country": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "city": {
                "type": "string",
                "maxLength": 128
              }
            },
            "additionalProperties": false
          },
          "location": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              },
              "capturedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "latitude",
              "longitude",
              "capturedAt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "eventId",
          "action",
          "category",
          "outcome",
          "occurredAt",
          "recordedAt",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "nextCursor": {
      "type": "string",
      "maxLength": 256
    },
    "attribution": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "$id": "https://audit-hub.invalid/schema/v1/subject-export-page.schema.json",
  "title": "SubjectExportPage"
}
