{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "connector": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9@/._-]{1,64}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d{1,6}\\.\\d{1,6}\\.\\d{1,6}(?:[+-][A-Za-z0-9.-]{1,32})?$"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "instanceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "appVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.+_-]{1,32}$"
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "sequenceEpoch": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "lastAssignedSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "queue": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "oldestAgeSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retrying": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "discardedAtSignOut": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "size",
        "oldestAgeSeconds",
        "retrying",
        "discardedAtSignOut"
      ],
      "additionalProperties": false
    },
    "responseActions": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      }
    }
  },
  "required": [
    "contractVersion",
    "connector",
    "instanceId",
    "appVersion",
    "catalogVersion",
    "sequenceEpoch",
    "lastAssignedSeq",
    "queue",
    "responseActions"
  ],
  "additionalProperties": false,
  "$id": "https://audit-hub.invalid/schema/v1/heartbeat.schema.json",
  "title": "Heartbeat"
}
