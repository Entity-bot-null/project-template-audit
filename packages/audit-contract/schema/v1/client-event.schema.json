{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "denied"
      ]
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "resource": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "parent": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "client": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "web",
            "ios",
            "android",
            "api",
            "job"
          ]
        },
        "appVersion": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+_-]{1,32}$"
        },
        "appBuild": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+_-]{1,32}$"
        },
        "updateId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "osVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "deviceModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "deviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{8,64}$"
        },
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8}){0,3}$"
        },
        "timeZone": {
          "type": "string",
          "pattern": "^[A-Za-z_]{1,32}(?:\\/[A-Za-z0-9_+-]{1,32}){0,2}$"
        },
        "networkType": {
          "type": "string",
          "enum": [
            "wifi",
            "cellular",
            "ethernet",
            "vpn",
            "none",
            "other",
            "unknown"
          ]
        },
        "route": {
          "type": "string",
          "pattern": "^\\/[A-Za-z0-9/:[\\]()._~-]{0,255}$"
        },
        "sdk": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9@/._-]{1,64}$"
            },
            "version": {
              "type": "string",
              "pattern": "^\\d{1,6}\\.\\d{1,6}\\.\\d{1,6}(?:[+-][A-Za-z0-9.-]{1,32})?$"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "accuracyM": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "latitude",
        "longitude",
        "accuracyM",
        "capturedAt"
      ],
      "additionalProperties": false
    },
    "details": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 128
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "eventId",
    "occurredAt",
    "action",
    "outcome",
    "client"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "https://audit-hub.invalid/schema/v1/client-event.schema.json",
  "title": "ClientEvent"
}
