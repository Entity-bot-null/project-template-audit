{
  "name": "audit-nestjs",
  "version": "0.3.1",
  "private": true,
  "description": "Audit Hub connector for the API of a project created from project-template-web: a transactional outbox, the forwarder, client events, account activity, webhooks and security prompts. Installed as source (docs/adr/0009).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@opentelemetry/api": "^1.10.0",
    "audit-contract": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
