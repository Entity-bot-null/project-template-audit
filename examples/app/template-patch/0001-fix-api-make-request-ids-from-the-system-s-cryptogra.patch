diff --git a/src/api/http.ts b/src/api/http.ts
index 02481aa..4962d71 100644
--- a/src/api/http.ts
+++ b/src/api/http.ts
@@ -1,3 +1,5 @@
+import { getRandomValues } from 'expo-crypto';
+
 import { AppError } from '@/lib/errors';
 import { addBreadcrumb } from '@/lib/observability/errorReporter';
 
@@ -128,13 +130,13 @@ function isAborted(signal: AbortSignal): boolean {
   return signal.aborted;
 }
 
-/** 128 random bits as hex: unique enough to find one request in the logs. */
+/**
+ * 128 random bits as hex, from the system's cryptographic source (not
+ * Math.random, whose sequence is predictable): unique enough to find one
+ * request in the logs.
+ */
 function newRequestId(): string {
-  let id = '';
-  for (let index = 0; index < 4; index += 1) {
-    id += Math.floor(Math.random() * 0x100000000)
-      .toString(16)
-      .padStart(8, '0');
-  }
-  return id;
+  return Array.from(getRandomValues(new Uint8Array(16)), (byte) =>
+    byte.toString(16).padStart(2, '0'),
+  ).join('');
 }
