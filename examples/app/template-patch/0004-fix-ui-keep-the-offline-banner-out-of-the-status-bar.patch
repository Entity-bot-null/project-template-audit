-/** Tells the user why fresh data is not coming; cached screens keep working. */
-export function OfflineBanner() {
+/**
+ * Tells the user why fresh data is not coming; cached screens keep working.
+ *
+ * The app draws edge to edge (Android 15 and later, iOS): the banner takes the
+ * status bar's place, and the screens below it (`children`) get no top inset
+ * while it shows, so their headers do not leave that space again. The tree
+ * below is the same online and offline: its navigation state is kept.
+ */
+export function OfflineBanner({ children }: { children?: ReactNode }) {
   const styles = useStyles();
-  if (useIsOnline()) return null;
+  const theme = useTheme();
+  const insets = useSafeAreaInsets();
+  const online = useIsOnline();
+  const below = useMemo(() => (online ? insets : { ...insets, top: 0 }), [online, insets]);
   return (
-    <View style={styles.banner}>
-      <Icon name="cloud-offline-outline" size="sm" color="textMuted" />
-      <AlertText variant="caption" tone="muted">
-        You are offline. Showing saved data.
-      </AlertText>
-    </View>
+    <>
+      {!online && (
+        <View
+          style={[styles.banner, { paddingTop: insets.top + theme.spacing.sm }]}
+          testID="offline-banner"
+        >
+          <Icon name="cloud-offline-outline" size="sm" color="textMuted" />
+          <AlertText variant="caption" tone="muted">
+            You are offline. Showing saved data.
+          </AlertText>
+        </View>
+      )}
+      <SafeAreaInsetsContext.Provider value={below}>{children}</SafeAreaInsetsContext.Provider>
+    </>
   );
 }
