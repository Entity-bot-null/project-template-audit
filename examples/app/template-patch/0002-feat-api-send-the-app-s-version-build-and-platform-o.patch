diff --git a/src/api/client.spec.ts b/src/api/client.spec.ts
new file mode 100644
index 0000000..189691a
--- /dev/null
+++ b/src/api/client.spec.ts
@@ -0,0 +1,33 @@
+import { Platform } from 'react-native';
+
+import { ok, stubFetch } from '@/test/http';
+
+import { publicApi, setRequestHeaders } from './client';
+
+// The headers every request carries, so the API can refuse a version it no
+// longer supports (docs/RELEASES.md#minimum-supported-version).
+
+describe('the API clients', () => {
+  afterEach(() => {
+    setRequestHeaders(() => Promise.resolve({}));
+  });
+
+  it("send the app's version, build and platform, public endpoints included", async () => {
+    const fetch = stubFetch({ 'POST /api/auth/logout': () => ok(null) });
+    await publicApi.POST('/api/auth/logout', { body: { refreshToken: 'refresh-1' } });
+    const [sent] = fetch.requests;
+    expect(sent?.headers.get('X-App-Version')).toEqual(expect.any(String));
+    expect(sent?.headers.get('X-App-Build')).toEqual(expect.any(String));
+    expect(sent?.headers.get('X-App-Platform')).toBe(Platform.OS);
+    fetch.restore();
+  });
+
+  it("add an integration's own headers to them", async () => {
+    setRequestHeaders(() => Promise.resolve({ 'X-Device-Id': 'installation-1' }));
+    const fetch = stubFetch({ 'POST /api/auth/logout': () => ok(null) });
+    await publicApi.POST('/api/auth/logout', { body: { refreshToken: 'refresh-1' } });
+    expect(fetch.requests[0]?.headers.get('X-Device-Id')).toBe('installation-1');
+    expect(fetch.requests[0]?.headers.get('X-App-Platform')).toBe(Platform.OS);
+    fetch.restore();
+  });
+});
