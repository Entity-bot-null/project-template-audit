+  it("adds the app's own headers, never over the caller's, and never fails for them", async () => {
+    const fetch = jest.fn((_request: Request) => Promise.resolve(respond(200)));
+    const headers = () => Promise.resolve({ 'X-App-Version': '1.4.2', 'X-App-Build': '42' });
