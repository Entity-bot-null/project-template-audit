 }
 
+/**
+ * Which app sends every request, public ones included, so the API can refuse
+ * a version it no longer supports (docs/RELEASES.md#minimum-supported-version).
+ */
+function versionHeaders(): Record<string, string> {
+  return {
+    'X-App-Version': Application.nativeApplicationVersion ?? 'unknown',
+    'X-App-Build': Application.nativeBuildVersion ?? 'unknown',
+    'X-App-Platform': Platform.OS,
+  };
+}
+
+let extraHeaders: (() => Promise<Record<string, string>>) | undefined;
+
+/**
+ * Registered by an integration that sends headers of its own on every request
+ * (the Audit Hub connector: the installation's id), besides the version ones.
+ */
+export function setRequestHeaders(provider: () => Promise<Record<string, string>>): void {
+  extraHeaders = provider;
+}
+
+const appHeaders = async (): Promise<Record<string, string>> => ({
+  ...versionHeaders(),
+  ...(await extraHeaders?.()),
+});
+
 const sessionAuth: AuthHandlers = {
   getAccessToken: () => authHandlers?.getAccessToken() ?? Promise.resolve(null),
   refreshAfterRejection: (rejected) =>
@@ -27,13 +56,13 @@ const sessionAuth: AuthHandlers = {
 /** Authenticated endpoints: every call carries the session's access token. */
 export const api = createClient<paths>({
   baseUrl: env.EXPO_PUBLIC_API_URL,
-  fetch: createHttp({ auth: sessionAuth }),
+  fetch: createHttp({ auth: sessionAuth, headers: appHeaders }),
 });
 
 /** Public endpoints (sign-in, refresh, logout): no token, no refresh. */
 export const publicApi = createClient<paths>({
   baseUrl: env.EXPO_PUBLIC_API_URL,
-  fetch: createHttp(),
+  fetch: createHttp({ headers: appHeaders }),
 });
 
