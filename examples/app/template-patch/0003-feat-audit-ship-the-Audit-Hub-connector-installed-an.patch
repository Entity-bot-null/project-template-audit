@@ -0,0 +1,106 @@
+# Another person signs in on the same phone: what the app kept for the first
+# one is sent at sign-out while the API answers, discarded if it does not,
+# and never sent with the second one's session. Ends signed in as the first
+# account again, for the flows after this one.
+appId: ${APP_ID}
+name: Another user on this phone
+env:
+  # REQUIERE CONFIGURACIÓN: the e2e variant of app.config.ts (<identifier>.e2e, <scheme>-e2e).
+  APP_ID: com.example.templateapp.e2e
+  SCHEME: templateapp-e2e
+onFlowComplete:
+  - runScript:
+      file: ../scripts/mock-api.js
+      env:
+        CONTROL: faults/clear
+---
+- runScript:
+    file: ../scripts/audit.js
+    env:
+      CONTROL: clear
+- runScript:
+    file: ../scripts/mock-api.js
+    env:
+      CONTROL: faults
+      ROUTE: POST /api/audit/client-events
+      STATUS: '0'
+- openLink: ${SCHEME}://admin/delete-everything
+- extendedWaitUntil:
+    visible:
+      id: items-list
+    timeout: 10000
+
+# Signing out while the API gets nothing: three seconds, then the event is dropped.
+- tapOn: Settings
+- scrollUntilVisible:
+    element:
+      id: settings-sign-out
+- tapOn:
+    id: settings-sign-out
+- tapOn: (?i)sign out
+- extendedWaitUntil:
+    visible:
+      id: sign-in-screen
+    timeout: 15000
+- runScript:
+    file: ../scripts/mock-api.js
+    env:
+      CONTROL: faults/clear
+
+- tapOn:
+    id: sign-in-email
+- eraseText
+- inputText: admin@example.com
+- tapOn:
+    id: sign-in-password
+- inputText: admin-password
+- hideKeyboard
+- tapOn:
+    id: sign-in-submit
+- extendedWaitUntil:
+    visible:
+      id: items-list
+    timeout: 15000
+# The second account's session started; the first one's event never came, and
+# the phone said it dropped it.
+- runScript:
+    file: ../scripts/audit.js
+    env:
+      CONTROL: expect
+      EMAIL: admin@example.com
+      ACTION: client.session.started
+      DISCARDED: '1'
+- runScript:
+    file: ../scripts/audit.js
+    env:
+      CONTROL: expect
+      EMAIL: member@example.com
+      ACTION: client.link.rejected
+      ABSENT: 'true'
+
+# Back to the first account.
+- tapOn: Settings
+- scrollUntilVisible:
+    element:
+      id: settings-sign-out
+- tapOn:
+    id: settings-sign-out
+- tapOn: (?i)sign out
+- extendedWaitUntil:
+    visible:
+      id: sign-in-screen
+    timeout: 15000
+- tapOn:
+    id: sign-in-email
+- eraseText
+- inputText: member@example.com
+- tapOn:
+    id: sign-in-password
+- inputText: member-password
+- hideKeyboard
+- tapOn:
+    id: sign-in-submit
+- extendedWaitUntil:
+    visible:
+      id: items-list
+    timeout: 15000
diff --git a/.maestro/scripts/audit.js b/.maestro/scripts/audit.js
new file mode 100644
index 0000000..64f7aa7
--- /dev/null
+++ b/.maestro/scripts/audit.js
@@ -0,0 +1,29 @@
+// The mock API's Audit Hub controls (scripts/mock-api.mjs) from a flow:
+//
+//   - runScript:
+//       file: ../scripts/audit.js
+//       env:
+//         CONTROL: prompts             # prompts, expect, clear
+//         EMAIL: member@example.com    # prompts, expect: the account
+//         ACTION: client.link.rejected # expect: the action it sent…
+//         ABSENT: 'true'               # …or did not send
+//         DISCARDED: '1'               # expect: drops reported, at least
+//
+// `prompts` leaves the new question's id in output.promptId. A control that
+// does not succeed (an expectation not met within 15 s) fails the flow.
+
+const base = typeof MOCK_API_URL === 'undefined' ? 'http://localhost:4010' : MOCK_API_URL;
+const body = {};
+if (typeof EMAIL !== 'undefined') body.email = EMAIL;
+if (typeof ACTION !== 'undefined') body.action = ACTION;
+if (typeof ABSENT !== 'undefined') body.absent = ABSENT === 'true';
+if (typeof DISCARDED !== 'undefined') body.discarded = Number(DISCARDED);
+
+const response = http.post(base + '/__mock/audit/' + CONTROL, {
+  headers: { 'Content-Type': 'application/json' },
+  body: JSON.stringify(body),
+});
+if (!(response.status >= 200 && response.status < 300)) {
+  throw new Error('Mock API audit/' + CONTROL + ': HTTP ' + response.status + ' ' + response.body);
+}
+if (CONTROL === 'prompts') output.promptId = json(response.body).data.id;
