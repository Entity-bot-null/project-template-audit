+// The part of the integration contract (packages/audit-contract) the connector
+// uses, copied by `pnpm connector add`: one module per file, as in the package.
+export * from './account-api';
+export * from './canonical-json';
+export * from './connector-api';
+export * from './event';
+export * from './patterns';
+export * from './unicode';
+export * from './uuidv7';
+export * from './version';
diff --git a/.audit-connector/pristine/src/lib/audit/contract/patterns.ts.orig b/.audit-connector/pristine/src/lib/audit/contract/patterns.ts.orig
