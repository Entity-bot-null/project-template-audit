+++ b/src/features/security/api.ts
@@ -0,0 +1,61 @@
+import type { ActivityItem, SecurityPrompt } from '@/lib/audit/contract';
+
+// The account's security, from the API's Audit Hub connector: TanStack Query
+// hooks over its routes (src/lib/audit/audit.wiring.ts), cleared with the rest
+// of the cache at sign-out.
+export {
+  useAccountActivity,
+  useAnswerSecurityPrompt,
+  useSecurityPrompt,
+  useSecurityPrompts,
+} from '@/lib/audit/audit.wiring';
+
+/** Why Audit Hub found a sign-in suspicious, as the person reads it. Unknown signals are left out. */
+const SIGNALS: Record<string, string> = {
+  new_device: 'on a phone or browser your account had not used',
+  new_country: 'from a country your account had not been used in',
+  impossible_travel: 'too far from where your account was used just before',
+  hosting_ip: 'from a server, not a home or phone network',
+  location_mismatch: "from a place that does not match the phone's own location",
+};
+
+export function signalsOf(prompt: Pick<SecurityPrompt, 'signals'>): string[] {
+  return prompt.signals.flatMap((signal) => {
+    const text = SIGNALS[signal];
+    return text === undefined ? [] : [text];
+  });
+}
+
+const CLIENTS: Record<string, string> = {
+  ios: 'iPhone app',
+  android: 'Android app',
+  web: 'Web browser',
+  api: 'API',
+  job: 'Background job',
+};
+
+/** "Android app · Pixel 9 · Guadalajara, MX": where and on what, as far as it is known. */
+export function placeOf(context: {
+  clientType?: string;
+  type?: string;
+  deviceModel?: string;
+  os?: string;
+  browser?: string;
+  city?: string;
+  country?: string;
+}): string {
+  const client = context.clientType ?? context.type;
+  const where = [context.city, context.country].filter((part) => part !== undefined).join(', ');
+  return [
+    client === undefined ? undefined : (CLIENTS[client] ?? client),
+    context.deviceModel ?? context.browser ?? context.os,
+    where === '' ? undefined : where,
+  ]
+    .filter((part) => part !== undefined)
+    .join(' · ');
+}
+
+/** One line of the activity: what happened, and where from. */
+export function activityLine(item: ActivityItem): string {
+  return placeOf({ ...item.client, ...item.location });
+}
