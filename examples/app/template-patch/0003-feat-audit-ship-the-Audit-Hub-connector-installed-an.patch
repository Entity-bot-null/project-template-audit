new file mode 100644
index 0000000..e1edf6c
--- /dev/null
+++ b/.maestro/flows/09-audit-offline.yaml
@@ -0,0 +1,62 @@
+# The device's own audit events (Audit Hub's connector) wait while the API
+# cannot be reached, and go once it can: a link the app refused, sent when the
+# app comes back to the foreground.
+#
+# The API's events route gets no answer at all (a fault of the mock API):
+# airplane mode would not do, `adb reverse` keeps the mock reachable.
+appId: ${APP_ID}
+name: Audit events wait for the network
+env:
+  # REQUIERE CONFIGURACIÓN: the e2e variant of app.config.ts (<identifier>.e2e, <scheme>-e2e).
+  APP_ID: com.example.templateapp.e2e
+  SCHEME: templateapp-e2e
+# Pass or fail, the mock API answers normally for the next flow.
+onFlowComplete:
+  - runScript:
+      file: ../scripts/mock-api.js
+      env:
+        CONTROL: faults/clear
+---
+- runScript:
+    file: ../scripts/audit.js
+    env:
+      CONTROL: clear
+- runScript:
+    file: ../scripts/mock-api.js
+    env:
+      CONTROL: faults
+      ROUTE: POST /api/audit/client-events
+      STATUS: '0'
+
+# A link the allowlist refuses: home, and an event for Audit Hub, queued.
+- openLink: ${SCHEME}://admin/delete-everything
+- extendedWaitUntil:
+    visible:
+      id: items-list
+    timeout: 10000
+- runScript:
+    file: ../scripts/audit.js
+    env:
+      CONTROL: expect
+      EMAIL: member@example.com
+      ACTION: client.link.rejected
+      ABSENT: 'true'
+
+# The API answers again; back in the foreground, the app sends what it kept.
+- runScript:
+    file: ../scripts/mock-api.js
+    env:
+      CONTROL: faults/clear
+- pressKey: home
+- launchApp:
+    stopApp: false
+- extendedWaitUntil:
+    visible:
+      id: items-list
+    timeout: 10000
+- runScript:
+    file: ../scripts/audit.js
+    env:
+      CONTROL: expect
+      EMAIL: member@example.com
+      ACTION: client.link.rejected
