diff --git a/src/features/security/ActivityScreen.tsx b/src/features/security/ActivityScreen.tsx
new file mode 100644
index 0000000..ff04599
--- /dev/null
+++ b/src/features/security/ActivityScreen.tsx
@@ -0,0 +1,163 @@
+import { router } from 'expo-router';
+import { ActivityIndicator, FlatList, View } from 'react-native';
+
+import type { ActivityItem } from '@/lib/audit/contract';
+import { toAppError } from '@/lib/errors';
+import {
+  Button,
+  Card,
+  createStyles,
+  EmptyState,
+  ErrorState,
+  LoadingState,
+  Text,
+  useTheme,
+} from '@/ui';
+
+import { activityLine, placeOf, useAccountActivity, useSecurityPrompts } from './api';
+
+// "Account security": the person's own sign-ins and changes, as Audit Hub
+// recorded them (the actions marked user-visible, never an address), newest
+// first, a page at a time; and the "Was it you?" questions still open.
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+
+const useStyles = createStyles((theme) => ({
+  root: { flex: 1, backgroundColor: theme.colors.background },
+  list: { padding: theme.spacing.lg, gap: theme.spacing.sm },
+  header: { gap: theme.spacing.sm, paddingBottom: theme.spacing.sm },
+  footer: { paddingVertical: theme.spacing.lg, gap: theme.spacing.sm },
+}));
+
+export function ActivityScreen() {
+  const styles = useStyles();
+  const activity = useAccountActivity();
+  const prompts = useSecurityPrompts();
+  const items = activity.data?.pages.flatMap((page) => page.items) ?? [];
+  const attribution = activity.data?.pages.find((page) => page.attribution)?.attribution;
+
+  const header = (
+    <View style={styles.header}>
+      {(prompts.data ?? []).map((prompt) => (
+        <Card key={prompt.id}>
+          <Text variant="heading">Was it you?</Text>
+          <Text>
+            A sign-in on {dateFormat.format(new Date(prompt.createdAt))} needs your answer.
+          </Text>
+          {placeOf(prompt.context) !== '' && <Text tone="muted">{placeOf(prompt.context)}</Text>}
+          <Button
+            label="Review this sign-in"
+            testID={`security-review-${prompt.id}`}
+            onPress={() => {
+              router.push(`/security/prompts/${prompt.id}`);
+            }}
+          />
+        </Card>
+      ))}
+    </View>
+  );
+
+  let placeholder;
+  if (activity.isPending) {
+    placeholder = <LoadingState label="Loading activity" />;
+  } else if (activity.isError) {
+    placeholder =
+      toAppError(activity.error).kind === 'notFound' ? (
+        <EmptyState
+          title="Not available"
+          description="This app does not keep an activity record yet."
+          icon="shield-outline"
+        />
+      ) : (
+        <ErrorState error={activity.error} onRetry={() => void activity.refetch()} />
+      );
+  } else {
+    placeholder = (
+      <EmptyState
+        title="No activity yet"
+        description="Your sign-ins and account changes appear here."
+        icon="shield-checkmark-outline"
+      />
+    );
+  }
+
+  return (
+    <FlatList
+      style={styles.root}
+      testID="security-activity-list"
+      data={items}
+      keyExtractor={(item) => item.eventId}
+      renderItem={({ item }) => <ActivityRow item={item} />}
+      ListHeaderComponent={header}
+      contentContainerStyle={styles.list}
+      onEndReachedThreshold={0.5}
+      onEndReached={() => {
+        if (activity.hasNextPage && !activity.isFetchingNextPage) void activity.fetchNextPage();
+      }}
+      refreshing={activity.isRefetching && !activity.isFetchingNextPage}
+      onRefresh={() => {
+        void activity.refetch();
+        void prompts.refetch();
+      }}
+      ListEmptyComponent={placeholder}
+      ListFooterComponent={
+        <Footer loading={activity.isFetchingNextPage} attribution={attribution} />
+      }
+    />
+  );
+}
+
+// One accessible element per row, read whole: what happened, when, where from.
+function ActivityRow({ item }: { item: ActivityItem }) {
+  const when = dateFormat.format(new Date(item.occurredAt));
+  const where = activityLine(item);
+  const outcome = item.outcome === 'success' ? '' : ' (failed)';
+  return (
+    <Card>
+      <View
+        accessible
+        accessibilityLabel={[`${item.description}${outcome}`, when, where]
+          .filter((part) => part !== '')
+          .join(', ')}
+      >
+        <Text>
+          {item.description}
+          {outcome}
+        </Text>
+        <Text variant="caption" tone="muted">
+          {when}
+        </Text>
+        {where !== '' && (
+          <Text variant="caption" tone="muted">
+            {where}
+          </Text>
+        )}
+      </View>
+    </Card>
+  );
+}
+
+function Footer({ loading, attribution }: { loading: boolean; attribution: string | undefined }) {
+  const theme = useTheme();
+  const styles = useStyles();
+  return (
+    <View style={styles.footer}>
+      {loading && (
+        <View
+          accessible
+          accessibilityRole="progressbar"
+          accessibilityLabel="Loading more activity"
+          accessibilityState={{ busy: true }}
+        >
+          <ActivityIndicator color={theme.colors.primary} />
+        </View>
+      )}
+      {/* The geolocation database's license asks for its name where its places show. */}
+      {attribution !== undefined && (
+        <Text variant="caption" tone="muted">
+          {attribution}
+        </Text>
+      )}
+    </View>
+  );
+}
