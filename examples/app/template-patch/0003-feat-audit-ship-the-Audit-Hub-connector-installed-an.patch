--- /dev/null
+++ b/src/lib/audit/hooks.ts
@@ -0,0 +1,30 @@
+import { useInfiniteQuery, useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import type { AuditTransport } from './audit.ports';
+import {
+  accountActivityQuery,
+  answerSecurityPromptMutation,
+  securityPromptQuery,
+  securityPromptsQuery,
+} from './queries';
+
+/**
+ * The account's security for the app's screens, with no UI of their own
+ * (the app's features render them): created once in audit.wiring.ts over the
+ * app's transport.
+ */
+export function createAuditHooks(transport: AuditTransport) {
+  return {
+    /** "My account's security": pages of the person's own activity. */
+    useAccountActivity: (limit?: number) =>
+      useInfiniteQuery(accountActivityQuery(transport, limit)),
+    /** The open "Was it you?" questions. */
+    useSecurityPrompts: () => useQuery(securityPromptsQuery(transport)),
+    /** One of them, for the screen a push opens: null once it is no longer open. */
+    useSecurityPrompt: (id: string) => useQuery(securityPromptQuery(transport, id)),
+    /** Answers one: "not_me" ends every session of the account. */
+    useAnswerSecurityPrompt: () => {
+      const client = useQueryClient();
+      return useMutation(answerSecurityPromptMutation(transport, client));
+    },
+  };
+}
diff --git a/src/lib/audit/queries.spec.ts b/src/lib/audit/queries.spec.ts
new file mode 100644
index 0000000..b97d199
--- /dev/null
+++ b/src/lib/audit/queries.spec.ts
@@ -0,0 +1,88 @@
+import { MutationObserver, QueryClient } from '@tanstack/react-query';
+import { FakeTransport } from './audit.testing';
+import type { SecurityPrompt } from './contract';
+import {
+  accountActivityQuery,
+  ACTIVITY_PAGE,
+  answerSecurityPromptMutation,
+  auditKeys,
+  securityPromptQuery,
+  securityPromptsQuery,
+} from './queries';
+
+const PROMPT: SecurityPrompt = {
+  id: '0199f0c4-0000-7000-8000-00000000a001',
+  signals: ['new_device'],
+  context: { clientType: 'android', country: 'MX' },
+  createdAt: '2026-10-17T12:00:00.000Z',
+  expiresAt: '2026-10-24T12:00:00.000Z',
+};
+const OTHER: SecurityPrompt = { ...PROMPT, id: '0199f0c4-0000-7000-8000-00000000a002' };
+
+const ITEM = {
+  eventId: '0199e0b1-6a2c-7d9e-9f1a-2b3c4d5e6f70',
+  action: 'auth.session.signed_in',
+  description: 'You signed in.',
+  outcome: 'success' as const,
+  occurredAt: '2026-10-17T11:00:00.000Z',
+};
+
+function setup() {
+  const transport = new FakeTransport();
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  return { transport, client };
+}
+
+describe("the account's security", () => {
+  it('reads the activity a page at a time, newest first', async () => {
+    const { transport, client } = setup();
+    transport.pages = [
+      { items: [ITEM], nextCursor: '1' },
+      { items: [{ ...ITEM, eventId: '0199e0b1-6a2c-7d9e-9f1a-2b3c4d5e6f71' }] },
+    ];
+
+    const data = await client.infiniteQuery({ ...accountActivityQuery(transport), pages: 2 });
+
+    expect(data.pages.map((page) => page.items.length)).toEqual([1, 1]);
+    expect(data.pageParams).toEqual([undefined, '1']);
+    expect(transport.activityQueries).toEqual([
+      { limit: ACTIVITY_PAGE },
+      { cursor: '1', limit: ACTIVITY_PAGE },
+    ]);
+    expect(accountActivityQuery(transport, 5).queryKey).toEqual(auditKeys.activity(5));
+
+    transport.pages = [{ items: [ITEM], nextCursor: '1' }];
+    await expect(
+      client.infiniteQuery({ ...accountActivityQuery(transport, 5), pages: 2 }),
+    ).rejects.toThrow('No page 1');
+  });
+
+  it('reads the open "Was it you?" questions, and one of them by id', async () => {
+    const { transport, client } = setup();
+    transport.prompts = [PROMPT, OTHER];
+
+    expect(await client.query(securityPromptsQuery(transport))).toEqual([PROMPT, OTHER]);
+    const one = securityPromptQuery(transport, OTHER.id);
+    expect(one.queryKey).toEqual(auditKeys.prompts());
+    expect(one.select?.([PROMPT, OTHER])).toEqual(OTHER);
+    expect(one.select?.([PROMPT])).toBeNull();
+  });
+
+  it('answers one, takes it off the list, and refreshes the activity', async () => {
+    const { transport, client } = setup();
+    transport.prompts = [PROMPT, OTHER];
+    await client.query(securityPromptsQuery(transport));
+    await client.infiniteQuery(accountActivityQuery(transport));
+
+    const answer = new MutationObserver(client, answerSecurityPromptMutation(transport, client));
+    const answered = await answer.mutate({ id: PROMPT.id, answer: 'not_me' });
+
+    expect(answered).toEqual({ ...PROMPT, answer: 'not_me' });
+    expect(transport.answers).toEqual([{ id: PROMPT.id, answer: 'not_me' }]);
+    expect(client.getQueryData(auditKeys.prompts())).toEqual([OTHER]);
+    expect(client.getQueryState(auditKeys.activity(ACTIVITY_PAGE))?.isInvalidated).toBe(true);
+
+    await expect(answer.mutate({ id: 'gone', answer: 'confirmed' })).rejects.toThrow('Not found');
+    client.clear();
+  });
+});
diff --git a/src/lib/audit/queries.ts b/src/lib/audit/queries.ts
new file mode 100644
index 0000000..a7d350f
--- /dev/null
+++ b/src/lib/audit/queries.ts
@@ -0,0 +1,69 @@
+import {
+  infiniteQueryOptions,
+  mutationOptions,
+  type QueryClient,
+  queryOptions,
+} from '@tanstack/react-query';
+import type { AuditTransport } from './audit.ports';
+import type { AnsweredSecurityPrompt, PromptAnswer, SecurityPrompt } from './contract';
+
+// The account's security as server state (docs/MOBILE_ARCHITECTURE.md#state):
+// TanStack Query queries over the API's routes, cached like the app's own and
+// cleared with them at sign-out (queryClient.clear()).
+
+export const auditKeys = {
+  all: ['audit'] as const,
+  activity: (limit: number) => ['audit', 'activity', limit] as const,
+  prompts: () => ['audit', 'security-prompts'] as const,
+};
+
+/** Rows of "My account's security" per page. */
+export const ACTIVITY_PAGE = 20;
+
+/** The person's own sign-ins and changes, newest first, a page at a time. */
+export function accountActivityQuery(transport: AuditTransport, limit = ACTIVITY_PAGE) {
+  return infiniteQueryOptions({
+    queryKey: auditKeys.activity(limit),
+    queryFn: ({ pageParam, signal }) =>
+      transport.activity(
+        pageParam === undefined ? { limit } : { cursor: pageParam, limit },
+        signal,
+      ),
+    initialPageParam: undefined as string | undefined,
+    getNextPageParam: (page) => page.nextCursor,
+  });
+}
+
+/** The open "Was it you?" questions. Fresh every time: an answer may come from another phone. */
+export function securityPromptsQuery(transport: AuditTransport) {
+  return queryOptions({
+    queryKey: auditKeys.prompts(),
+    queryFn: ({ signal }) => transport.securityPrompts(signal),
+    staleTime: 0,
+  });
+}
+
+/** One prompt of the open ones: null once answered, expired, or never this account's. */
+export function securityPromptQuery(transport: AuditTransport, id: string) {
+  return queryOptions({
+    ...securityPromptsQuery(transport),
+    select: (prompts: SecurityPrompt[]) => prompts.find((prompt) => prompt.id === id) ?? null,
+  });
+}
+
+/**
+ * Answers a prompt. The user decides on its screen; never retried by itself
+ * (the app's mutations never are): "not_me" ends the account's sessions.
+ */
+export function answerSecurityPromptMutation(transport: AuditTransport, client: QueryClient) {
+  return mutationOptions<AnsweredSecurityPrompt, Error, { id: string; answer: PromptAnswer }>({
+    mutationKey: [...auditKeys.all, 'answer'],
+    mutationFn: ({ id, answer }) => transport.answerPrompt(id, answer),
+    onSuccess: async (answered) => {
+      client.setQueryData<SecurityPrompt[]>(auditKeys.prompts(), (prompts) =>
+        prompts?.filter((prompt) => prompt.id !== answered.id),
+      );
+      await client.invalidateQueries({ queryKey: [...auditKeys.all, 'activity'] });
+    },
+  });
+}
diff --git a/src/lib/audit/queue.spec.ts b/src/lib/audit/queue.spec.ts
new file mode 100644
index 0000000..7b79302
--- /dev/null
+++ b/src/lib/audit/queue.spec.ts
@@ -0,0 +1,167 @@
+import type { SqlDatabase } from './audit.ports';
+import { memoryDatabase } from './audit.testing';
+import { openAuditQueue, QUEUE_SCHEMA_VERSION } from './queue';
+
+const row = (eventId: string, userRef: string, occurredAt: string) => ({
+  eventId,
+  userRef,
+  occurredAt,
+  payload: `{"eventId":"${eventId}"}`,
+});
+
+const T1 = '2026-10-17T12:00:01.000Z';
+const T2 = '2026-10-17T12:00:02.000Z';
+const T3 = '2026-10-17T12:00:03.000Z';
+
+describe('the audit queue', () => {
+  it("keeps each user's events apart, oldest first", async () => {
+    const queue = openAuditQueue(() => Promise.resolve(memoryDatabase()));
+    await queue.add(row('e3', 'ana', T3));
+    await queue.add(row('e1', 'ana', T1));
+    await queue.add(row('e2', 'luis', T2));
+    await queue.add(row('e1', 'ana', T3)); // the same event twice: kept once
+
+    expect(
+      (await queue.next('ana', 10)).map((queued) => [queued.eventId, queued.attempts]),
+    ).toEqual([
+      ['e1', 0],
+      ['e3', 0],
+    ]);
+    expect((await queue.next('ana', 1)).map((queued) => queued.eventId)).toEqual(['e1']);
+    expect(await queue.next('luis', 10)).toEqual([
+      { eventId: 'e2', userRef: 'luis', occurredAt: T2, payload: '{"eventId":"e2"}', attempts: 0 },
+    ]);
+
+    await queue.remove(['e1', 'e2']);
+    await queue.remove([]);
+    expect((await queue.next('ana', 10)).map((queued) => queued.eventId)).toEqual(['e3']);
+    expect(await queue.next('luis', 10)).toEqual([]);
+  });
+
+  it('counts failed attempts, and drops the events that reach the limit', async () => {
+    const queue = openAuditQueue(() => Promise.resolve(memoryDatabase()));
+    await queue.add(row('e1', 'ana', T1));
+    await queue.add(row('e2', 'ana', T2));
+
+    expect(await queue.failed(['e1', 'e2'], 2)).toBe(0);
+    expect(await queue.failed(['e1'], 2)).toBe(1);
+    expect(await queue.failed([], 2)).toBe(0);
+    expect(await queue.next('ana', 10)).toEqual([
+      { eventId: 'e2', userRef: 'ana', occurredAt: T2, payload: '{"eventId":"e2"}', attempts: 1 },
+    ]);
+  });
+
+  it("removes another user's events, one user's, or all of them", async () => {
+    const queue = openAuditQueue(() => Promise.resolve(memoryDatabase()));
+    for (const [id, user] of [
+      ['e1', 'ana'],
+      ['e2', 'luis'],
+      ['e3', 'luis'],
+      ['e4', 'eva'],
+    ] as const) {
+      await queue.add(row(id, user, T1));
+    }
+
+    expect(await queue.removeOthers('luis')).toBe(2);
+    expect((await queue.next('luis', 10)).length).toBe(2);
+    expect(await queue.removeUser('luis')).toBe(2);
+    await queue.add(row('e5', 'ana', T1));
+    expect(await queue.removeOthers(null)).toBe(1);
+    expect(await queue.next('ana', 10)).toEqual([]);
+  });
+
+  it('keeps the newest events when it is full', async () => {
+    const queue = openAuditQueue(() => Promise.resolve(memoryDatabase()));
+    await queue.add(row('e2', 'ana', T2));
+    await queue.add(row('e1', 'luis', T1));
+    await queue.add(row('e3', 'ana', T3));
+
+    expect(await queue.trim(5)).toBe(0);
+    expect(await queue.trim(2)).toBe(1);
+    expect(await queue.next('luis', 10)).toEqual([]);
+    expect((await queue.next('ana', 10)).map((queued) => queued.eventId)).toEqual(['e2', 'e3']);
+  });
+
+  it('remembers whose it is and what it dropped', async () => {
+    const queue = openAuditQueue(() => Promise.resolve(memoryDatabase()));
+    expect(await queue.meta('user')).toBeNull();
+    await queue.setMeta('user', 'ana');
+    await queue.setMeta('user', 'luis');
+    await queue.setMeta('discarded', '3');
+    expect(await queue.meta('user')).toBe('luis');
+    expect(await queue.meta('discarded')).toBe('3');
+    await queue.setMeta('user', null);
+    expect(await queue.meta('user')).toBeNull();
+  });
+
+  it('creates its tables once, survives a restart, and refuses a newer schema', async () => {
+    const database = memoryDatabase();
+    const first = openAuditQueue(() => Promise.resolve(database));
+    await first.add(row('e1', 'ana', T1));
+
+    const again = openAuditQueue(() => Promise.resolve(database));
+    expect((await again.next('ana', 10)).map((queued) => queued.eventId)).toEqual(['e1']);
+    expect(
+      await database.getFirstAsync<{ user_version: number }>('PRAGMA user_version', []),
+    ).toEqual({ user_version: QUEUE_SCHEMA_VERSION });
+
+    await database.execAsync(`PRAGMA user_version = ${String(QUEUE_SCHEMA_VERSION + 1)}`);
+    const older = openAuditQueue(() => Promise.resolve(database));
+    await expect(older.next('ana', 10)).rejects.toThrow('newer than this app');
+  });
+
+  it('opens the database again after a failure, and applies a migration whole or not at all', async () => {
+    let opens = 0;
+    const database = memoryDatabase();
+    const failingOnce: SqlDatabase = {
+      ...database,
+      execAsync: (source) => {
+        if (source.startsWith('BEGIN') && opens === 1) {
+          // Half the migration ran when it failed.
+          return database.execAsync('BEGIN; CREATE TABLE half (id INTEGER);').then(() => {
+            throw new Error('disk full');
+          });
+        }
+        return database.execAsync(source);
+      },
+    };
+    const queue = openAuditQueue(() => {
+      opens += 1;
+      return opens === 2 ? Promise.reject(new Error('locked')) : Promise.resolve(failingOnce);
+    });
+
+    await expect(queue.meta('user')).rejects.toThrow('disk full');
+    expect(
+      await database.getAllAsync("SELECT name FROM sqlite_master WHERE name = 'half'", []),
+    ).toEqual([]);
+    await expect(queue.meta('user')).rejects.toThrow('locked');
+    expect(await queue.meta('user')).toBeNull();
+    expect(opens).toBe(3);
+
+    // Failing before its transaction began: nothing to roll back.
+    const refusing = openAuditQueue(() =>
+      Promise.resolve({
+        ...memoryDatabase(),
+        execAsync: (source: string) =>
+          source.startsWith('BEGIN')
+            ? Promise.reject(new Error('read-only'))
+            : database.execAsync(source),
+      }),
+    );
+    await expect(refusing.meta('user')).rejects.toThrow('read-only');
+  });
+
+  it('migrates a database that cannot say its version', async () => {
+    const database = memoryDatabase();
+    const silent: SqlDatabase = {
+      ...database,
+      getFirstAsync: <T>(source: string, params: (string | number | null)[]) =>
+        source === 'PRAGMA user_version'
+          ? Promise.resolve(null)
+          : database.getFirstAsync<T>(source, params),
+    };
+    const queue = openAuditQueue(() => Promise.resolve(silent));
+    await queue.add(row('e1', 'ana', T1));
+    expect((await queue.next('ana', 10)).length).toBe(1);
+  });
+});
diff --git a/src/lib/audit/queue.ts b/src/lib/audit/queue.ts
new file mode 100644
index 0000000..b739440
--- /dev/null
+++ b/src/lib/audit/queue.ts
@@ -0,0 +1,172 @@
+import type { AuditQueue, MetaKey, QueuedRow, SqlDatabase } from './audit.ports';
+
+// The device's events waiting to be sent, in their own SQLite file
+// (docs/MOBILE_ARCHITECTURE.md#offline): one row per event, of one user, kept
+// until the API answers for it, the user signs out, or the queue is full.
+// The schema is the connector's: `pnpm connector update` brings its
+// migrations, numbered by PRAGMA user_version.
+
+const MIGRATIONS: readonly string[] = [
+  `CREATE TABLE IF NOT EXISTS audit_queue (
+     event_id TEXT PRIMARY KEY NOT NULL,
+     user_ref TEXT NOT NULL,
+     occurred_at TEXT NOT NULL,
+     payload TEXT NOT NULL,
+     attempts INTEGER NOT NULL DEFAULT 0
+   );
+   CREATE INDEX IF NOT EXISTS audit_queue_by_user ON audit_queue (user_ref, occurred_at, event_id);
+   CREATE TABLE IF NOT EXISTS audit_meta (key TEXT PRIMARY KEY NOT NULL, value TEXT NOT NULL);`,
+];
+
+/** The schema version this connector writes. */
+export const QUEUE_SCHEMA_VERSION = MIGRATIONS.length;
+
+interface Row {
+  event_id: string;
+  user_ref: string;
+  occurred_at: string;
+  payload: string;
+  attempts: number;
+}
+
+/** Brings the database to QUEUE_SCHEMA_VERSION; refuses one written by a newer connector. */
+async function migrate(db: SqlDatabase): Promise<void> {
+  const current = (await db.getFirstAsync<{ user_version: number }>('PRAGMA user_version', []))
+    ?.user_version;
+  const version = current ?? 0;
+  if (version > QUEUE_SCHEMA_VERSION) {
+    throw new Error(`Audit queue schema ${String(version)} is newer than this app's`);
+  }
+  for (const [index, sql] of MIGRATIONS.entries()) {
+    if (index < version) continue;
+    // One transaction each, its version with it: a migration is applied whole or not at all.
+    try {
+      await db.execAsync(`BEGIN;\n${sql}\nPRAGMA user_version = ${String(index + 1)};\nCOMMIT;`);
+    } catch (error) {
+      await db.execAsync('ROLLBACK;').catch(() => undefined);
+      throw error;
+    }
+  }
+}
+
+/** Placeholders for `count` values: (?, ?, ?). */
+const placeholders = (count: number) => `(${Array.from({ length: count }, () => '?').join(', ')})`;
+
+/**
+ * The queue over the database `open` gives, opened and migrated on first use.
+ * A database that cannot be opened fails each call; the client logs it and
+ * the app goes on without the queue.
+ */
+export function openAuditQueue(open: () => Promise<SqlDatabase>): AuditQueue {
+  let ready: Promise<SqlDatabase> | null = null;
+  const db = (): Promise<SqlDatabase> => {
+    ready ??= open().then(async (database) => {
+      await migrate(database);
+      return database;
+    });
+    // A failed open is tried again on the next call.
+    ready.catch(() => {
+      ready = null;
+    });
+    return ready;
+  };
+
+  return {
+    async add(row) {
+      await (
+        await db()
+      ).runAsync(
+        `INSERT OR IGNORE INTO audit_queue (event_id, user_ref, occurred_at, payload) VALUES (?, ?, ?, ?)`,
+        [row.eventId, row.userRef, row.occurredAt, row.payload],
+      );
+    },
+
+    async next(userRef, limit) {
+      const rows = await (
+        await db()
+      ).getAllAsync<Row>(
+        `SELECT event_id, user_ref, occurred_at, payload, attempts FROM audit_queue
+         WHERE user_ref = ? ORDER BY occurred_at, event_id LIMIT ?`,
+        [userRef, limit],
+      );
+      return rows.map((row): QueuedRow => ({
+        eventId: row.event_id,
+        userRef: row.user_ref,
+        occurredAt: row.occurred_at,
+        payload: row.payload,
+        attempts: row.attempts,
+      }));
+    },
+
+    async remove(eventIds) {
+      if (eventIds.length === 0) return;
+      await (
+        await db()
+      ).runAsync(`DELETE FROM audit_queue WHERE event_id IN ${placeholders(eventIds.length)}`, [
+        ...eventIds,
+      ]);
+    },
+
+    async failed(eventIds, max) {
+      if (eventIds.length === 0) return 0;
+      const database = await db();
+      const list = placeholders(eventIds.length);
+      await database.runAsync(
+        `UPDATE audit_queue SET attempts = attempts + 1 WHERE event_id IN ${list}`,
+        [...eventIds],
+      );
+      const { changes } = await database.runAsync(
+        `DELETE FROM audit_queue WHERE attempts >= ? AND event_id IN ${list}`,
+        [max, ...eventIds],
+      );
+      return changes;
+    },
+
+    async removeOthers(userRef) {
+      const database = await db();
+      const { changes } =
+        userRef === null
+          ? await database.runAsync('DELETE FROM audit_queue', [])
+          : await database.runAsync('DELETE FROM audit_queue WHERE user_ref <> ?', [userRef]);
+      return changes;
+    },
+
+    async removeUser(userRef) {
+      const { changes } = await (
+        await db()
+      ).runAsync('DELETE FROM audit_queue WHERE user_ref = ?', [userRef]);
+      return changes;
+    },
+
+    async trim(max) {
+      const { changes } = await (
+        await db()
+      ).runAsync(
+        `DELETE FROM audit_queue WHERE event_id NOT IN (
+           SELECT event_id FROM audit_queue ORDER BY occurred_at DESC, event_id DESC LIMIT ?
+         )`,
+        [max],
+      );
+      return changes;
+    },
+
+    async meta(key: MetaKey) {
+      const row = await (
+        await db()
+      ).getFirstAsync<{ value: string }>('SELECT value FROM audit_meta WHERE key = ?', [key]);
+      return row?.value ?? null;
+    },
+
+    async setMeta(key: MetaKey, value: string | null) {
+      const database = await db();
+      if (value === null) {
+        await database.runAsync('DELETE FROM audit_meta WHERE key = ?', [key]);
+      } else {
+        await database.runAsync(
+          'INSERT INTO audit_meta (key, value) VALUES (?, ?) ON CONFLICT (key) DO UPDATE SET value = excluded.value',
+          [key, value],
+        );
+      }
+    },
+  };
+}
