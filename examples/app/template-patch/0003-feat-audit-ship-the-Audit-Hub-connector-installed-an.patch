+import {
+  AnsweredSecurityPromptSchema,
+  PushTokenDeleteSchema,
+  PushTokenSchema,
+  SecurityPromptAnswerSchema,
+  SecurityPromptListSchema,
+  securityPromptPath,
+} from './account-api';
+
+const PROMPT = {
+  id: '0199f0c4-0000-7000-8000-00000000a001',
+  signals: ['new_device', 'impossible_travel'],
+  context: { clientType: 'android', country: 'MX', city: 'Guadalajara' },
+  createdAt: '2026-10-17T12:00:00.000Z',
+  expiresAt: '2026-10-24T12:00:00.000Z',
+};
+const PHONE = 'ExponentPushToken[phone-of-ana-1]';
+
+describe('"Was it you?"', () => {
+  it('reads the open prompts, and tolerates fields a newer API adds', () => {
+    expect(SecurityPromptListSchema.parse({ items: [PROMPT] })).toEqual({ items: [PROMPT] });
+    expect(
+      SecurityPromptListSchema.safeParse({ items: [{ ...PROMPT, severity: 'high' }] }).success,
+    ).toBe(true);
+    for (const wrong of [
+      { ...PROMPT, id: 'prompt-1' },
+      { ...PROMPT, expiresAt: 'next week' },
+      { ...PROMPT, context: { clientType: 3 } },
+    ]) {
+      expect(SecurityPromptListSchema.safeParse({ items: [wrong] }).success).toBe(false);
+    }
+  });
+
+  it('takes one of two answers, and reads the answered prompt', () => {
+    expect(SecurityPromptAnswerSchema.safeParse({ answer: 'not_me' }).success).toBe(true);
+    expect(SecurityPromptAnswerSchema.safeParse({ answer: 'confirmed' }).success).toBe(true);
+    expect(SecurityPromptAnswerSchema.safeParse({ answer: 'maybe' }).success).toBe(false);
+    expect(SecurityPromptAnswerSchema.safeParse({ answer: 'not_me', at: 1 }).success).toBe(false);
+    expect(AnsweredSecurityPromptSchema.parse({ ...PROMPT, answer: 'confirmed' }).answer).toBe(
+      'confirmed',
+    );
+  });
+
+  it("opens the prompt's own screen", () => {
+    expect(securityPromptPath(PROMPT.id)).toBe(`/security/prompts/${PROMPT.id}`);
+  });
+});
+
+describe('push tokens', () => {
+  it("accept an Expo push token and the phone's platform only", () => {
+    expect(PushTokenSchema.safeParse({ token: PHONE, platform: 'ios' }).success).toBe(true);
+    expect(
+      PushTokenSchema.safeParse({ token: 'ExpoPushToken[abc_DEF-123]', platform: 'android' })
+        .success,
+    ).toBe(true);
+    for (const body of [
+      { token: 'a1b2c3d4e5f6', platform: 'ios' }, // a device token: Expo's service cannot use it
+      { token: PHONE, platform: 'web' },
+      { token: PHONE },
+      { token: `ExponentPushToken[${'x'.repeat(260)}]`, platform: 'ios' },
+      { token: PHONE, platform: 'ios', extra: true },
+    ]) {
+      expect(PushTokenSchema.safeParse(body).success).toBe(false);
+    }
+    expect(PushTokenDeleteSchema.safeParse({ token: PHONE }).success).toBe(true);
+    expect(PushTokenDeleteSchema.safeParse({ token: 'nope' }).success).toBe(false);
+  });
+});
diff --git a/src/lib/audit/contract/account-api.ts b/src/lib/audit/contract/account-api.ts
new file mode 100644
index 0000000..e7d7e42
--- /dev/null
+++ b/src/lib/audit/contract/account-api.ts
@@ -0,0 +1,54 @@
+import { z } from 'zod';
+import { TimestampSchema } from './event';
+import { EXPO_PUSH_TOKEN_PATTERN } from './patterns';
+
+// The routes a connector adds to its project's API for the signed-in person
+// (docs/audit/connection-guide.md): "Was it you?" and the phone's push token.
+// The API answers with these schemas and its apps read them with the same
+// ones. Answers are read leniently (z.object): a field added by a newer API
+// never breaks an older app.
+
+export const PROMPT_ANSWERS = ['confirmed', 'not_me'] as const;
+export const PUSH_PLATFORMS = ['ios', 'android'] as const;
+export type PromptAnswer = (typeof PROMPT_ANSWERS)[number];
+export type PushPlatform = (typeof PUSH_PLATFORMS)[number];
+
+/** The app's screen of a "Was it you?" prompt: the path its push notification opens. */
+export const SECURITY_PROMPT_PATH = '/security/prompts/';
+
+export function securityPromptPath(id: string): string {
+  return `${SECURITY_PROMPT_PATH}${id}`;
+}
+
+/** An open "Was it you?" question about a sign-in of the person's account. */
+export const SecurityPromptSchema = z.object({
+  id: z.uuid(),
+  /** Why the sign-in looked suspicious: new_device, impossible_travel… */
+  signals: z.array(z.string()),
+  /** Where and on what it happened, as Audit Hub saw it: country, city, clientType, deviceModel. */
+  context: z.record(z.string(), z.string()),
+  createdAt: TimestampSchema,
+  expiresAt: TimestampSchema,
+});
+export type SecurityPrompt = z.infer<typeof SecurityPromptSchema>;
+
+export const SecurityPromptListSchema = z.object({ items: z.array(SecurityPromptSchema) });
+
+/** POST /api/account/security-prompts/:id/answer */
+export const SecurityPromptAnswerSchema = z.strictObject({ answer: z.enum(PROMPT_ANSWERS) });
+
+export const AnsweredSecurityPromptSchema = SecurityPromptSchema.extend({
+  answer: z.enum(PROMPT_ANSWERS),
+});
+export type AnsweredSecurityPrompt = z.infer<typeof AnsweredSecurityPromptSchema>;
+
+/** PUT /api/account/push-token: the phone's Expo push token, after each sign-in. */
+export const PushTokenSchema = z.strictObject({
+  token: z.string().max(255).regex(EXPO_PUSH_TOKEN_PATTERN),
+  platform: z.enum(PUSH_PLATFORMS),
+});
+
+/** DELETE /api/account/push-token: at sign-out, so the next person on the phone gets none of it. */
+export const PushTokenDeleteSchema = z.strictObject({
+  token: z.string().max(255).regex(EXPO_PUSH_TOKEN_PATTERN),
+});
