+  it('reads only the last known position, and only with the permission', async () => {
+    await expect(lastKnownPosition()).resolves.toBeNull();
+    expect(location.getLastKnownPositionAsync).not.toHaveBeenCalled();
+
+    location.getForegroundPermissionsAsync.mockResolvedValue(GRANTED);
+    await expect(lastKnownPosition()).resolves.toBeNull();
+    expect(location.getLastKnownPositionAsync).toHaveBeenCalledWith({
+      maxAge: LOCATION_MAX_AGE_MS,
+    });
+
+    location.getLastKnownPositionAsync.mockResolvedValueOnce({
+      coords: { latitude: 19.4326, longitude: -99.1332, accuracy: 35 },
+      timestamp: 1_760_000_000_000,
+    } as never);
+    await expect(lastKnownPosition()).resolves.toEqual({
+      latitude: 19.4326,
+      longitude: -99.1332,
+      accuracyM: 35,
+      capturedAt: 1_760_000_000_000,
+    });
+  });
+
+  it('tells precise from approximate as the person chose it, on either system', async () => {
+    await expect(preciseLocationAllowed()).resolves.toBe(false);
