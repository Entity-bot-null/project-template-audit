@@ -0,0 +1,82 @@
+# "Was it you?": Audit Hub found a sign-in suspicious and the API stored a
+# question; its push opens the question's screen (a link like the one tapped
+# here). The link only opens it: the user answers there. "It was me" changes
+# nothing; "No" ends every session of the account, this one included.
+appId: ${APP_ID}
+name: Was it you?
+env:
+  # REQUIERE CONFIGURACIÓN: the e2e variant of app.config.ts (<identifier>.e2e, <scheme>-e2e).
+  APP_ID: com.example.templateapp.e2e
+  SCHEME: templateapp-e2e
+---
+- runScript:
+    file: ../scripts/audit.js
+    env:
+      CONTROL: prompts
+      EMAIL: member@example.com
+- openLink: ${SCHEME}://security/prompts/${output.promptId}
+- extendedWaitUntil:
+    visible:
+      id: security-prompt-screen
+    timeout: 10000
+- assertVisible: Android app · Pixel 9 · Madrid, ES
+- tapOn:
+    id: security-prompt-confirm
+- extendedWaitUntil:
+    visible: Thanks for confirming
+    timeout: 10000
+- tapOn: Done
+
+# The account's own activity, with nothing left to answer.
+- tapOn: Settings
+- scrollUntilVisible:
+    element:
+      id: settings-security-activity
+- tapOn:
+    id: settings-security-activity
+- extendedWaitUntil:
+    visible: You signed in
+    timeout: 10000
+- assertNotVisible: Review this sign-in
+- back
+
+# A second question, answered "No": the account's sessions end.
+- runScript:
+    file: ../scripts/audit.js
+    env:
+      CONTROL: prompts
+      EMAIL: member@example.com
+- openLink: ${SCHEME}://security/prompts/${output.promptId}
+- extendedWaitUntil:
+    visible:
+      id: security-prompt-screen
+    timeout: 10000
+- tapOn:
+    id: security-prompt-not-me
+# The confirmation dialog (Android capitalizes its buttons on some themes).
+- tapOn: (?i)secure it
+- extendedWaitUntil:
+    visible:
+      id: security-prompt-secured
+    timeout: 10000
+- tapOn: Sign in again
+- extendedWaitUntil:
+    visible:
+      id: sign-in-screen
+    timeout: 10000
+
+# Signed in again, for the flows after this one.
+- tapOn:
+    id: sign-in-email
+- eraseText
+- inputText: member@example.com
+- tapOn:
+    id: sign-in-password
+- inputText: member-password
+- hideKeyboard
+- tapOn:
+    id: sign-in-submit
+- extendedWaitUntil:
+    visible:
+      id: items-list
+    timeout: 15000
diff --git a/.maestro/flows/11-switch-user.yaml b/.maestro/flows/11-switch-user.yaml
