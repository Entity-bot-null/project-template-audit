@@ -0,0 +1,110 @@
+import { router } from 'expo-router';
+import { Alert } from 'react-native';
+
+import { signOut } from '@/lib/audit/audit.wiring';
+import { AlertText, Button, Card, EmptyState, ErrorState, LoadingState, Screen, Text } from '@/ui';
+
+import { placeOf, signalsOf, useAnswerSecurityPrompt, useSecurityPrompt } from './api';
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+
+/**
+ * "Was it you?": the screen a security push opens (/security/prompts/<id>).
+ * The link only opens it; the person answers here, signed in. "No" ends every
+ * session of the account on the API's side, this one included.
+ */
+export function SecurityPromptScreen({ id }: { id: string }) {
+  const prompt = useSecurityPrompt(id);
+  const answer = useAnswerSecurityPrompt();
+
+  if (answer.data?.answer === 'not_me') {
+    return (
+      <Screen scroll edges={['bottom', 'left', 'right']} testID="security-prompt-secured">
+        <AlertText variant="title">Your account is secured</AlertText>
+        <Text>
+          Every session of your account was ended, this one included. Sign in again, and change your
+          password if you can.
+        </Text>
+        <Button label="Sign in again" onPress={() => void signOut()} />
+      </Screen>
+    );
+  }
+  if (answer.data?.answer === 'confirmed') {
+    return (
+      <EmptyState
+        title="Thanks for confirming"
+        description="Nothing changes: the sign-in was yours."
+        icon="checkmark-circle-outline"
+        announce
+        action={{
+          label: 'Done',
+          onPress: () => {
+            router.back();
+          },
+        }}
+      />
+    );
+  }
+  if (prompt.isPending) return <LoadingState label="Loading the question" />;
+  if (prompt.isError) {
+    return <ErrorState error={prompt.error} onRetry={() => void prompt.refetch()} />;
+  }
+  if (prompt.data === null) {
+    return (
+      <EmptyState
+        title="Nothing to answer"
+        description="This question was already answered, or it expired."
+        icon="checkmark-circle-outline"
+      />
+    );
+  }
+
+  const { data } = prompt;
+  const reasons = signalsOf(data);
+  const where = placeOf(data.context);
+  return (
+    <Screen scroll edges={['bottom', 'left', 'right']} testID="security-prompt-screen">
+      <Text variant="title">Was it you?</Text>
+      <Card>
+        <Text>
+          Someone signed in to your account on {dateFormat.format(new Date(data.createdAt))}.
+        </Text>
+        {where !== '' && <Text tone="muted">{where}</Text>}
+        {reasons.length > 0 && <Text tone="muted">It looked unusual: {reasons.join('; ')}.</Text>}
+      </Card>
+      {answer.isError && <ErrorState error={answer.error} title="Could not send your answer" />}
+      <Button
+        label="Yes, it was me"
+        testID="security-prompt-confirm"
+        loading={answer.isPending && answer.variables.answer === 'confirmed'}
+        disabled={answer.isPending}
+        onPress={() => {
+          answer.mutate({ id, answer: 'confirmed' });
+        }}
+      />
+      <Button
+        label="No, secure my account"
+        variant="danger"
+        testID="security-prompt-not-me"
+        loading={answer.isPending && answer.variables.answer === 'not_me'}
+        disabled={answer.isPending}
+        onPress={() => {
+          Alert.alert(
+            'Secure your account?',
+            'Every session of your account will end, on every device, this one included.',
+            [
+              { text: 'Cancel', style: 'cancel' },
+              {
+                text: 'Secure it',
+                style: 'destructive',
+                onPress: () => {
+                  answer.mutate({ id, answer: 'not_me' });
+                },
+              },
+            ],
+          );
+        }}
+      />
+    </Screen>
+  );
+}
