new file mode 100644
index 0000000..cbb7502
--- /dev/null
+++ b/src/lib/location.ts
@@ -0,0 +1,78 @@
+import * as Location from 'expo-location';
+
+import type { DevicePosition } from '@/lib/audit/audit.ports';
+import { LOCATION_MAX_AGE_MS } from '@/lib/audit/audit.constants';
+import type { PermissionSource } from '@/lib/permissions/usePermission';
+
+// The phone's location, for sign-in alerts only
+// (docs/MOBILE_ARCHITECTURE.md#permissions, STORE_COMPLIANCE.md): in the
+// foreground, with the user's separate consent (src/store/preferences.ts).
+// The system's own dialog lets the person choose precise or approximate
+// (Android 12+, iOS 14+): approximate, the Audit Hub connector rounds it to
+// 0.01° on the device; precise, it keeps it to five decimals, taken fresh
+// when a session starts only (a sign-in, or the app opened with its session
+// kept). Never in the background (app.config.ts blocks it).
+
+/** The foreground permission, asked from Settings when the user turns sign-in alerts on. */
+export const locationPermission: PermissionSource = {
+  get: () => Location.getForegroundPermissionsAsync(),
+  request: () => Location.requestForegroundPermissionsAsync(),
+};
+
+/** A fresh fix waits this long at most: a sign-in never waits for the GPS. */
+export const CURRENT_POSITION_TIMEOUT_MS = 10_000;
+
+const positionOf = (position: Location.LocationObject): DevicePosition => ({
+  latitude: position.coords.latitude,
+  longitude: position.coords.longitude,
+  accuracyM: position.coords.accuracy,
+  capturedAt: position.timestamp,
+});
+
+/**
+ * The last position the system already knows, if recent: never a prompt,
+ * never the GPS woken. Null without the permission or a recent position.
+ */
+export async function lastKnownPosition(): Promise<DevicePosition | null> {
+  const permission = await Location.getForegroundPermissionsAsync();
+  if (!permission.granted) return null;
+  const position = await Location.getLastKnownPositionAsync({ maxAge: LOCATION_MAX_AGE_MS });
+  return position === null ? null : positionOf(position);
+}
+
+/**
+ * Whether the person allowed the precise position in the system's dialog or
+ * settings (Android: fine; iOS: full accuracy), read when it is needed: it
+ * can change in the system's settings at any time.
+ */
+export async function preciseLocationAllowed(): Promise<boolean> {
+  const permission = await Location.getForegroundPermissionsAsync();
+  return (
+    permission.granted &&
+    (permission.android?.accuracy === 'fine' || permission.ios?.accuracy === 'full')
+  );
+}
+
+/**
+ * A fresh, precise position (the GPS woken once, briefly), only when the
+ * precise one is allowed: the connector asks for it when a session starts only. Null
+ * otherwise, or when no fix comes within CURRENT_POSITION_TIMEOUT_MS.
+ */
+export async function currentPosition(): Promise<DevicePosition | null> {
+  if (!(await preciseLocationAllowed())) return null;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const timeout = new Promise<null>((resolve) => {
+    timer = setTimeout(() => {
+      resolve(null);
+    }, CURRENT_POSITION_TIMEOUT_MS);
+  });
+  try {
+    const position = await Promise.race([
+      Location.getCurrentPositionAsync({ accuracy: Location.LocationAccuracy.High }),
+      timeout,
+    ]);
+    return position === null ? null : positionOf(position);
+  } finally {
+    clearTimeout(timer);
+  }
+}
