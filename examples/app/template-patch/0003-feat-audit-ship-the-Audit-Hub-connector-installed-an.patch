@@ -0,0 +1,88 @@
+import {
+  CanonicalJsonError,
+  canonicalJson,
+  canonicalJsonBytes,
+  jsonDepth,
+  utf8Length,
+} from './canonical-json';
+
+describe('canonicalJson (RFC 8785)', () => {
+  it('matches the example of RFC 8785 section 3.2.2', () => {
+    const input: unknown = JSON.parse(
+      '{"numbers":[333333333.33333329,1E30,4.50,2e-3,0.000000000000000000000000001],' +
+        '"string":"\\u20ac$\\u000F\\u000aA\'\\u0042\\u0022\\u005c\\\\\\"\\/",' +
+        '"literals":[null,true,false]}',
+    );
+    expect(canonicalJson(input)).toBe(
+      '{"literals":[null,true,false],"numbers":[333333333.3333333,1e+30,4.5,0.002,1e-27],' +
+        '"string":"€$\\u000f\\nA\'B\\"\\\\\\\\\\"/"}',
+    );
+  });
+
+  it('sorts keys by UTF-16 code units, as RFC 8785 section 3.2.3 shows', () => {
+    const input = {
+      '€': 'Euro Sign',
+      '\r': 'Carriage Return',
+      דּ: 'Hebrew Letter Dalet With Dagesh',
+      '1': 'One',
+      '😀': 'Emoji: Grinning Face',
+      '\u0080': 'Control',
+      ö: 'Latin Small Letter O With Diaeresis',
+    };
+    // Read the order off the text: JSON.parse would move the integer-like key first.
+    const text = canonicalJson(input);
+    const positions = [
+      'Carriage Return',
+      'One',
+      'Control',
+      'Latin Small Letter O With Diaeresis',
+      'Euro Sign',
+      'Emoji: Grinning Face',
+      'Hebrew Letter Dalet With Dagesh',
+    ].map((name) => text.indexOf(name));
+    expect(positions.every((position) => position > 0)).toBe(true);
+    expect([...positions].sort((a, b) => a - b)).toEqual(positions);
+  });
+
+  it('gives the same text whatever the key order and nesting', () => {
+    expect(canonicalJson({ b: [1, { d: 2, c: 3 }], a: null })).toBe(
+      canonicalJson({ a: null, b: [1, { c: 3, d: 2 }] }),
+    );
+    expect(canonicalJson({ a: undefined, b: -0 })).toBe('{"b":0}');
+    expect(canonicalJson(Object.create(null) as object)).toBe('{}');
+  });
+
+  it('refuses what JSON cannot carry exactly', () => {
+    expect(() => canonicalJson(Number.NaN)).toThrow(CanonicalJsonError);
+    expect(() => canonicalJson({ a: Infinity })).toThrow('$.a: not a finite number');
+    expect(() => canonicalJson('\ud800')).toThrow('lone surrogate');
+    expect(() => canonicalJson({ ['\udc00']: 1 })).toThrow('key with a lone surrogate');
+    expect(() => canonicalJson([1n])).toThrow('$[0]: bigint is not JSON');
+    expect(() => canonicalJson(new Date(0))).toThrow('only plain objects');
+    expect(() => canonicalJson(undefined)).toThrow('undefined is not JSON');
+  });
+});
+
+describe('sizes', () => {
+  it('counts UTF-8 bytes without TextEncoder', () => {
+    // One byte for ASCII, two for ñ, three for €, four for an emoji.
+    for (const [text, bytes] of [
+      ['', 0],
+      ['a', 1],
+      ['ñ', 2],
+      ['€', 3],
+      ['😀', 4],
+      ['añ€😀', 10],
+    ] as const) {
+      expect(utf8Length(text)).toBe(bytes);
+    }
+    expect(canonicalJsonBytes({ a: 'ñ' })).toBe(10);
+  });
+
+  it('measures nesting depth', () => {
+    expect(jsonDepth('x')).toBe(0);
+    expect(jsonDepth({ a: 1 })).toBe(1);
+    expect(jsonDepth({ a: [{ b: 1 }] })).toBe(3);
+    expect(jsonDepth([])).toBe(1);
+  });
+});
diff --git a/src/lib/audit/contract/canonical-json.ts b/src/lib/audit/contract/canonical-json.ts
new file mode 100644
index 0000000..de66f32
--- /dev/null
+++ b/src/lib/audit/contract/canonical-json.ts
@@ -0,0 +1,82 @@
+// JSON Canonicalization Scheme (RFC 8785) for the JSON values the contract
+// carries: what request signatures and content hashes cover, so the same
+// value gives the same bytes on every side, whatever the key order or the
+// spacing it travelled with.
+//
+// ECMAScript's JSON.stringify already serializes numbers and strings the way
+// RFC 8785 requires (section 3.2.2); what remains is sorting object keys by
+// UTF-16 code units, and refusing what JSON cannot represent exactly.
+
+import { isWellFormed } from './unicode';
+
+export type JsonValue =
+  null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue };
+
+export class CanonicalJsonError extends Error {
+  override readonly name = 'CanonicalJsonError';
+}
+
+export function canonicalJson(value: unknown): string {
+  return serialize(value, '$');
+}
+
+function serialize(value: unknown, path: string): string {
+  if (value === null) return 'null';
+  switch (typeof value) {
+    case 'boolean':
+      return value ? 'true' : 'false';
+    case 'number':
+      if (!Number.isFinite(value)) throw new CanonicalJsonError(`${path}: not a finite number`);
+      return JSON.stringify(value);
+    case 'string':
+      if (!isWellFormed(value)) throw new CanonicalJsonError(`${path}: lone surrogate`);
+      return JSON.stringify(value);
+    case 'object':
+      return Array.isArray(value) ? serializeArray(value, path) : serializeObject(value, path);
+    default:
+      throw new CanonicalJsonError(`${path}: ${typeof value} is not JSON`);
+  }
+}
+
+function serializeArray(items: readonly unknown[], path: string): string {
+  return `[${items.map((item, index) => serialize(item, `${path}[${String(index)}]`)).join(',')}]`;
+}
+
+function serializeObject(object: object, path: string): string {
+  const prototype: unknown = Object.getPrototypeOf(object);
+  if (prototype !== Object.prototype && prototype !== null) {
+    throw new CanonicalJsonError(`${path}: only plain objects are JSON`);
+  }
+  const entries = Object.entries(object).filter(([, item]) => item !== undefined);
+  // Default sort: UTF-16 code units, which is what RFC 8785 asks for.
+  entries.sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0));
+  const members = entries.map(([key, item]) => {
+    if (!isWellFormed(key)) throw new CanonicalJsonError(`${path}: key with a lone surrogate`);
+    return `${JSON.stringify(key)}:${serialize(item, `${path}.${key}`)}`;
+  });
+  return `{${members.join(',')}}`;
+}
+
+/** UTF-8 size of the canonical form: the size limits of the contract use it. */
+export function canonicalJsonBytes(value: unknown): number {
+  return utf8Length(canonicalJson(value));
+}
+
+/** Nesting depth: 0 for a scalar, 1 for an object of scalars. */
+export function jsonDepth(value: unknown): number {
+  if (value === null || typeof value !== 'object') return 0;
+  const children = Array.isArray(value) ? value : Object.values(value);
+  let deepest = 0;
+  for (const child of children) deepest = Math.max(deepest, jsonDepth(child));
+  return deepest + 1;
+}
+
+/** UTF-8 length of a well-formed string, without TextEncoder (React Native). */
+export function utf8Length(text: string): number {
+  let length = 0;
+  for (const char of text) {
+    const code = char.codePointAt(0) ?? 0;
+    length += code < 0x80 ? 1 : code < 0x800 ? 2 : code < 0x10000 ? 3 : 4;
+  }
+  return length;
+}
diff --git a/src/lib/audit/contract/connector-api.ts b/src/lib/audit/contract/connector-api.ts
new file mode 100644
index 0000000..712b51a
--- /dev/null
+++ b/src/lib/audit/contract/connector-api.ts
@@ -0,0 +1,119 @@
+import { z } from 'zod';
+import { CLIENT_TYPES, HUB_CATEGORIES, OUTCOMES, TimestampSchema, Uuidv7Schema } from './event';
+import { ACTION_PATTERN, COUNTRY_PATTERN } from './patterns';
+
+// The query API applications call on Audit Hub (/api/connector/*), signed
+// like ingestion. Each answer covers one subject (an application's user) and
+// only that application's data.
+
+/** One line of "My account's security": what the user may see of their own activity. */
+export const ActivityItemSchema = z.strictObject({
+  eventId: Uuidv7Schema,
+  action: z.string().regex(ACTION_PATTERN),
+  description: z.string().max(500),
+  outcome: z.enum(OUTCOMES),
+  occurredAt: TimestampSchema,
+  client: z
+    .strictObject({
+      type: z.enum(CLIENT_TYPES).optional(),
+      os: z.string().max(32).optional(),
+      deviceModel: z.string().max(64).optional(),
+      appVersion: z.string().max(32).optional(),
+      browser: z.string().max(64).optional(),
+    })
+    .optional(),
+  location: z
+    .strictObject({
+      country: z.string().regex(COUNTRY_PATTERN).optional(),
+      city: z.string().max(128).optional(),
+    })
+    .optional(),
+});
+export type ActivityItem = z.infer<typeof ActivityItemSchema>;
+
+export const ActivityPageSchema = z.strictObject({
+  items: z.array(ActivityItemSchema),
+  /** Absent on the last page. */
+  nextCursor: z.string().max(256).optional(),
+  /** "IP Geolocation by DB-IP" when a location came from it (ADR 0011). */
+  attribution: z.string().max(200).optional(),
+});
+export type ActivityPage = z.infer<typeof ActivityPageSchema>;
+
+export const ActivityQuerySchema = z.strictObject({
+  cursor: z.string().max(256).optional(),
+  limit: z.coerce.number().int().min(1).max(100).default(20),
+});
+
+/**
+ * What an erasure deletes: the personal data of every event of the subject
+ * (personal: the events stay, pseudonymous, until their retention), or the
+ * events too (events: once the controller cancels them, LFPDPPP art. 24).
+ */
+export const ERASURE_SCOPES = ['personal', 'events'] as const;
+export type ErasureScope = (typeof ERASURE_SCOPES)[number];
+
+/** The body of an erasure request; without one, the personal scope. */
+export const ErasureRequestSchema = z.strictObject({
+  scope: z.enum(ERASURE_SCOPES).default('personal'),
+});
+export type ErasureRequest = z.infer<typeof ErasureRequestSchema>;
+
+export const ErasureResultSchema = z.strictObject({
+  personalDeleted: z.int().min(0),
+  locationDeleted: z.int().min(0),
+  /** Rows a legal hold kept. */
+  held: z.int().min(0),
+  /** Scope events: the events deleted now. */
+  eventsDeleted: z.int().min(0).optional(),
+  /** Scope events: the ones not sealed yet, deleted once they are (within a day). */
+  eventsPending: z.int().min(0).optional(),
+});
+export type ErasureResult = z.infer<typeof ErasureResultSchema>;
+
+/**
+ * Right of access: one of the subject's events, with what Audit Hub still
+ * keeps of it (personal data for 90 days, a device location for 30).
+ */
+export const SubjectExportItemSchema = z.strictObject({
+  eventId: Uuidv7Schema,
+  action: z.string().regex(ACTION_PATTERN),
+  category: z.enum(HUB_CATEGORIES),
+  outcome: z.enum(OUTCOMES),
+  occurredAt: TimestampSchema,
+  recordedAt: TimestampSchema,
+  /** The subject acted, or the event was about them. */
+  role: z.enum(['actor', 'resource']),
+  details: z.unknown().optional(),
+  change: z
+    .strictObject({ before: z.unknown().optional(), after: z.unknown().optional() })
+    .optional(),
+  client: z
+    .strictObject({
+      type: z.enum(CLIENT_TYPES).optional(),
+      os: z.string().max(32).optional(),
+      deviceModel: z.string().max(64).optional(),
+      appVersion: z.string().max(32).optional(),
+    })
+    .optional(),
+  network: z
+    .strictObject({
+      ip: z.string().max(64).optional(),
+      userAgent: z.string().max(1024).optional(),
+      country: z.string().regex(COUNTRY_PATTERN).optional(),
+      city: z.string().max(128).optional(),
+    })
+    .optional(),
+  location: z
+    .strictObject({ latitude: z.number(), longitude: z.number(), capturedAt: TimestampSchema })
+    .optional(),
+});
+export type SubjectExportItem = z.infer<typeof SubjectExportItemSchema>;
+
+export const SubjectExportPageSchema = z.strictObject({
+  items: z.array(SubjectExportItemSchema),
+  /** Absent on the last page. */
+  nextCursor: z.string().max(256).optional(),
+  attribution: z.string().max(200).optional(),
+});
+export type SubjectExportPage = z.infer<typeof SubjectExportPageSchema>;
diff --git a/src/lib/audit/contract/event.spec.ts b/src/lib/audit/contract/event.spec.ts
new file mode 100644
index 0000000..af60cae
--- /dev/null
+++ b/src/lib/audit/contract/event.spec.ts
@@ -0,0 +1,133 @@
+import {
+  AuditEventDraftSchema,
+  AuditEventSchema,
+  ClientEventBatchSchema,
+  ClientEventSchema,
+  LocationSchema,
+} from './event';
+import { auditEvent, clientEvent } from './testing/events';
+import { LIMITS } from './version';
+
+const issues = (result: { success: boolean; error?: { issues: { path: PropertyKey[] }[] } }) =>
+  (result.error?.issues ?? []).map((issue) => issue.path.join('.'));
+
+describe('AuditEventSchema', () => {
+  it('accepts a complete event', () => {
+    expect(AuditEventSchema.parse(auditEvent())).toEqual(auditEvent());
+  });
+
+  it('accepts a minimal anonymous event', () => {
+    const event = {
+      schemaVersion: 1,
+      eventId: auditEvent().eventId,
+      sourceSeq: 9,
+      occurredAt: '2026-10-14T12:00:00Z',
+      catalogVersion: '0123456789abcdef',
+      category: 'security',
+      action: 'auth.session.sign_in_failed',
+      outcome: 'failure',
+      reason: 'invalid_credentials',
+      actor: { type: 'anonymous', emailHmac: 'b'.repeat(64) },
+    };
+    expect(AuditEventSchema.safeParse(event).success).toBe(true);
+  });
+
+  it('requires an id for a user and refuses one for an anonymous actor', () => {
+    expect(
+      issues(AuditEventSchema.safeParse(auditEvent({ actor: { type: 'user' } as never }))),
+    ).toContain('actor.id');
+    const anonymous = auditEvent({ actor: { type: 'anonymous', id: 'x' } as never });
+    expect(AuditEventSchema.safeParse(anonymous).success).toBe(false);
+  });
+
+  it('refuses ids that look like emails, unknown fields and invented status codes', () => {
+    expect(
+      AuditEventSchema.safeParse(auditEvent({ actor: { type: 'user', id: 'a@b.com' } })).success,
+    ).toBe(false);
+    expect(AuditEventSchema.safeParse({ ...auditEvent(), extra: true }).success).toBe(false);
+    expect(AuditEventSchema.safeParse(auditEvent({ request: { status: 999 } })).success).toBe(
+      false,
+    );
+  });
+
+  it('refuses the reserved category, bad actions and timestamps with an offset', () => {
+    expect(AuditEventSchema.safeParse({ ...auditEvent(), category: 'audit_access' }).success).toBe(
+      false,
+    );
+    expect(AuditEventSchema.safeParse(auditEvent({ action: 'auth.signed_in' })).success).toBe(
+      false,
+    );
+    expect(
+      AuditEventSchema.safeParse(auditEvent({ occurredAt: '2026-10-14T12:00:00+01:00' })).success,
+    ).toBe(false);
+  });
+
+  it('bounds details by size and depth, and clientDeclared by uniqueness', () => {
+    const big = { text: 'x'.repeat(9000) };
+    expect(issues(AuditEventSchema.safeParse(auditEvent({ details: big })))).toContain('details');
+    const deep = { a: { b: { c: { d: { e: 1 } } } } };
+    expect(issues(AuditEventSchema.safeParse(auditEvent({ details: deep })))).toContain('details');
+    expect(
+      AuditEventSchema.safeParse(auditEvent({ clientDeclared: ['client', 'client'] })).success,
+    ).toBe(false);
+  });
+
+  it('has a draft form without the sequence number', () => {
+    const { sourceSeq: _sequence, ...draft } = auditEvent();
+    expect(AuditEventDraftSchema.safeParse(draft).success).toBe(true);
+    expect(AuditEventSchema.safeParse(draft).success).toBe(false);
+  });
+
+  it('accepts IPv4 and IPv6 only', () => {
+    expect(AuditEventSchema.safeParse(auditEvent({ network: { ip: '2001:db8::1' } })).success).toBe(
+      true,
+    );
+    expect(AuditEventSchema.safeParse(auditEvent({ network: { ip: 'unknown' } })).success).toBe(
+      false,
+    );
+  });
+});
+
+describe('client events', () => {
+  it('accepts what a device may declare and nothing it may not', () => {
+    expect(ClientEventSchema.parse(clientEvent())).toEqual(clientEvent());
+    expect(
+      ClientEventSchema.safeParse({ ...clientEvent(), actor: { type: 'system' } }).success,
+    ).toBe(false);
+    expect(ClientEventSchema.safeParse({ ...clientEvent(), sourceSeq: 1 }).success).toBe(false);
+  });
+
+  it('limits a batch', () => {
+    expect(ClientEventBatchSchema.safeParse({ events: [] }).success).toBe(false);
+    const events = Array.from({ length: 51 }, () => clientEvent());
+    expect(ClientEventBatchSchema.safeParse({ events }).success).toBe(false);
+    expect(ClientEventBatchSchema.safeParse({ events: events.slice(0, 50) }).success).toBe(true);
+  });
+
+  it("carries how many events the device dropped at sign-out, within its queue's size", () => {
+    const events = [clientEvent()];
+    for (const discardedAtSignOut of [0, 7, LIMITS.clientQueueEvents]) {
+      expect(ClientEventBatchSchema.safeParse({ events, discardedAtSignOut }).success).toBe(true);
+    }
+    for (const discardedAtSignOut of [-1, 1.5, LIMITS.clientQueueEvents + 1, '3']) {
+      expect(ClientEventBatchSchema.safeParse({ events, discardedAtSignOut }).success).toBe(false);
+    }
+  });
+
+  it('takes an approximate location, and a precise one, within the planet and 100 km', () => {
+    const location = {
+      latitude: 19.43,
+      longitude: -99.13,
+      accuracyM: 1000,
+      capturedAt: '2026-10-14T12:00:00.000Z',
+    };
+    expect(LocationSchema.safeParse(location).success).toBe(true);
+    // Precise, with consent to the precise position.
+    expect(
+      LocationSchema.safeParse({ ...location, latitude: 19.43261, accuracyM: 5 }).success,
+    ).toBe(true);
+    expect(LocationSchema.safeParse({ ...location, accuracyM: 0 }).success).toBe(false);
+    expect(LocationSchema.safeParse({ ...location, accuracyM: 100_001 }).success).toBe(false);
+    expect(LocationSchema.safeParse({ ...location, latitude: 91 }).success).toBe(false);
+  });
+});
diff --git a/src/lib/audit/contract/event.ts b/src/lib/audit/contract/event.ts
new file mode 100644
index 0000000..068ad64
--- /dev/null
+++ b/src/lib/audit/contract/event.ts
@@ -0,0 +1,304 @@
+import { z } from 'zod';
+import { canonicalJsonBytes, jsonDepth } from './canonical-json';
+import {
+  ACTION_PATTERN,
+  CATALOG_VERSION_PATTERN,
+  CLIENT_ROUTE_PATTERN,
+  CODE_PATTERN,
+  DEVICE_ID_PATTERN,
+  HEX64_PATTERN,
+  ID_PATTERN,
+  LOCALE_PATTERN,
+  PHONE_LABEL_PATTERN,
+  REQUEST_ID_PATTERN,
+  RESOURCE_TYPE_PATTERN,
+  ROLE_PATTERN,
+  ROUTE_PATTERN,
+  SDK_NAME_PATTERN,
+  SEMVER_PATTERN,
+  TIME_ZONE_PATTERN,
+  TRACE_ID_PATTERN,
+  UUIDV7_PATTERN,
+  VERSION_TOKEN_PATTERN,
+} from './patterns';
+import { CONTRACT_VERSION, LIMITS } from './version';
+
+// The audit event, version 1 (docs/design/audit-hub/contract.md). These
+// schemas are strict: they describe exactly what a connector sends, and the
+// JSON Schema in schema/v1/ is generated from them. Audit Hub reads incoming
+// events more leniently (normalize.ts), field by field.
+
+/** What applications send. `audit_access` is Audit Hub's own (its use by people). */
+export const CATEGORIES = ['security', 'audit', 'access', 'system'] as const;
+export const HUB_CATEGORIES = [...CATEGORIES, 'audit_access'] as const;
+export const OUTCOMES = ['success', 'failure', 'denied'] as const;
+export const SEVERITIES = ['info', 'low', 'medium', 'high', 'critical'] as const;
+export const ACTOR_TYPES = ['user', 'service', 'system', 'anonymous'] as const;
+export const CLIENT_TYPES = ['web', 'ios', 'android', 'api', 'job'] as const;
+export const NETWORK_TYPES = [
+  'wifi',
+  'cellular',
+  'ethernet',
+  'vpn',
+  'none',
+  'other',
+  'unknown',
+] as const;
+export const HTTP_METHODS = ['GET', 'HEAD', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS'] as const;
+/** Sections of an event the application's server did not observe itself. */
+export const CLIENT_DECLARED_SECTIONS = [
+  'occurredAt',
+  'client',
+  'location',
+  'details',
+  'resource',
+  'change',
+] as const;
+
+export type Category = (typeof CATEGORIES)[number];
+export type HubCategory = (typeof HUB_CATEGORIES)[number];
+export type Outcome = (typeof OUTCOMES)[number];
+export type Severity = (typeof SEVERITIES)[number];
+export type ActorType = (typeof ACTOR_TYPES)[number];
+export type ClientType = (typeof CLIENT_TYPES)[number];
+export type ClientDeclaredSection = (typeof CLIENT_DECLARED_SECTIONS)[number];
+
+export const Uuidv7Schema = z.string().regex(UUIDV7_PATTERN);
+export const IdSchema = z.string().regex(ID_PATTERN);
+export const Hex64Schema = z.string().regex(HEX64_PATTERN);
+export const ActionSchema = z.string().regex(ACTION_PATTERN);
+export const TimestampSchema = z.iso.datetime();
+const label = z.string().min(1).max(LIMITS.label);
+
+/** A JSON object bounded in size and depth: details, before, after. */
+export const boundedObject = (maxBytes: number) =>
+  z
+    .record(z.string().max(128), z.json())
+    .refine((value) => canonicalJsonBytes(value) <= maxBytes, {
+      message: `at most ${String(maxBytes)} bytes`,
+    })
+    .refine((value) => jsonDepth(value) <= LIMITS.jsonDepth, {
+      message: `at most ${String(LIMITS.jsonDepth)} levels deep`,
+    });
+
+const actorFields = {
+  /** Role in the application at the time of the event. */
+  role: z.string().regex(ROLE_PATTERN).optional(),
+  /**
+   * Who it is, in words: the person's name, or their email masked at the
+   * origin (j***@e***.com) when the application has no name. Personal: Audit
+   * Hub keeps it in the satellite table.
+   */
+  label: label.optional(),
+  /** The person's phone, masked at the origin: its last four digits only (•••• 1234). Personal, like the label. */
+  phoneLabel: z.string().regex(PHONE_LABEL_PATTERN).optional(),
+  /** HMAC-SHA256 of the normalized email with the application's pseudonymization key. */
+  emailHmac: Hex64Schema.optional(),
+  /** Only when the application enabled cross-application correlation. */
+  emailHmacShared: Hex64Schema.optional(),
+  impersonatorId: IdSchema.optional(),
+  /** HMAC of the session family id: never the id itself. */
+  sessionRef: Hex64Schema.optional(),
+};
+
+export const ActorSchema = z.discriminatedUnion('type', [
+  z.strictObject({ type: z.literal('user'), id: IdSchema, ...actorFields }),
+  z.strictObject({ type: z.literal('service'), id: IdSchema.optional(), ...actorFields }),
+  z.strictObject({ type: z.literal('system'), id: IdSchema.optional(), ...actorFields }),
+  z.strictObject({ type: z.literal('anonymous'), ...actorFields }),
+]);
+
+const resourceType = z.string().regex(RESOURCE_TYPE_PATTERN);
+
+export const ResourceSchema = z.strictObject({
+  type: resourceType,
+  id: IdSchema.optional(),
+  label: label.optional(),
+  parent: z.strictObject({ type: resourceType, id: IdSchema }).optional(),
+});
+
+export const ChangeSchema = z.strictObject({
+  /** The explicit select, read in the transaction before the write. Sensitive values are "[REDACTED]". */
+  before: boundedObject(LIMITS.changeBytes).optional(),
+  after: boundedObject(LIMITS.changeBytes).optional(),
+  changedFields: z
+    .array(z.string().regex(/^[A-Za-z][A-Za-z0-9_.]{0,127}$/))
+    .max(LIMITS.changedFields)
+    .optional(),
+});
+
+export const RequestSchema = z.strictObject({
+  requestId: z.string().regex(REQUEST_ID_PATTERN).optional(),
+  traceId: z.string().regex(TRACE_ID_PATTERN).optional(),
+  method: z.enum(HTTP_METHODS).optional(),
+  /** The route template (/api/users/:id), never the URL. */
+  route: z.string().regex(ROUTE_PATTERN).optional(),
+  /** The status actually sent. */
+  status: z.int().min(100).max(599).optional(),
+  durationMs: z.int().min(0).max(3_600_000).optional(),
+});
+
+/**
+ * What a Chromium browser says of itself in its client hints (the Sec-CH-UA
+ * headers; clientHintsFromHeaders), where its user agent no longer tells:
+ * its real brand (Brave and Edge say Chrome), Windows 11 (which says 10), a
+ * phone's model. Firefox and Safari send none.
+ */
+export const ClientHintsSchema = z.strictObject({
+  /** Sec-CH-UA-Full-Version-List, else Sec-CH-UA, without the GREASE brand. */
+  brands: z
+    .array(
+      z.strictObject({
+        brand: z.string().min(1).max(LIMITS.hintBrand),
+        version: z.string().min(1).max(LIMITS.hintVersion),
+      }),
+    )
+    .min(1)
+    .max(LIMITS.hintBrands)
+    .optional(),
+  /** Sec-CH-UA-Platform: Windows, macOS, Linux, Android, Chrome OS. */
+  platform: z.string().min(1).max(LIMITS.hintPlatform).optional(),
+  /** Sec-CH-UA-Platform-Version: 13.0.0 and up on Windows 11. */
+  platformVersion: z.string().min(1).max(LIMITS.hintVersion).optional(),
+  /** Sec-CH-UA-Model: a phone's or a tablet's model. */
+  model: z.string().min(1).max(LIMITS.deviceModel).optional(),
+  /** Sec-CH-UA-Mobile. */
+  mobile: z.boolean().optional(),
+});
+
+export const NetworkSchema = z.strictObject({
+  /** clientIp(req) of the application's API (TRUST_PROXY applied). */
+  ip: z.union([z.ipv4(), z.ipv6()]).optional(),
+  userAgent: z.string().max(LIMITS.userAgent).optional(),
+  clientHints: ClientHintsSchema.optional(),
+});
+
+const versionToken = z.string().regex(VERSION_TOKEN_PATTERN);
+
+export const ClientSchema = z.strictObject({
+  type: z.enum(CLIENT_TYPES),
+  appVersion: versionToken.optional(),
+  appBuild: versionToken.optional(),
+  updateId: z.uuid().optional(),
+  os: z.string().min(1).max(LIMITS.os).optional(),
+  osVersion: z.string().min(1).max(LIMITS.osVersion).optional(),
+  deviceModel: z.string().min(1).max(LIMITS.deviceModel).optional(),
+  /** Per-installation random id: never an advertising id, IDFV or Android ID. */
+  deviceId: z.string().regex(DEVICE_ID_PATTERN).optional(),
+  locale: z.string().regex(LOCALE_PATTERN).optional(),
+  timeZone: z.string().regex(TIME_ZONE_PATTERN).optional(),
+  networkType: z.enum(NETWORK_TYPES).optional(),
+  /** Screen route pattern, never a path with ids. */
+  route: z.string().regex(CLIENT_ROUTE_PATTERN).optional(),
+  sdk: z
+    .strictObject({
+      name: z.string().regex(SDK_NAME_PATTERN),
+      version: z.string().regex(SEMVER_PATTERN),
+    })
+    .optional(),
+});
+
+/**
+ * Only with the user's location consent. An approximate position (accuracy
+ * of 1 km or more) is rounded to two decimals on the device; a precise one,
+ * only with consent to the precise position, keeps five (about a metre). Audit
+ * Hub rounds again by the same rule (locationDecimals).
+ */
+export const LocationSchema = z.strictObject({
+  latitude: z.number().min(-90).max(90),
+  longitude: z.number().min(-180).max(180),
+  accuracyM: z.int().min(1).max(100_000),
+  capturedAt: TimestampSchema,
+});
+
+const clientDeclared = z
+  .array(z.enum(CLIENT_DECLARED_SECTIONS))
+  .max(CLIENT_DECLARED_SECTIONS.length)
+  .refine((sections) => new Set(sections).size === sections.length, {
+    message: 'sections must be unique',
+  });
+
+const eventFields = {
+  schemaVersion: z.literal(CONTRACT_VERSION),
+  /** Idempotency key, generated once at the origin. */
+  eventId: Uuidv7Schema,
+  occurredAt: TimestampSchema,
+  /** First 16 hex characters of the catalog's SHA-256 the event was written against. */
+  catalogVersion: z.string().regex(CATALOG_VERSION_PATTERN),
+  category: z.enum(CATEGORIES),
+  /** domain.entity.verb, declared in the catalog. */
+  action: ActionSchema,
+  outcome: z.enum(OUTCOMES),
+  /** Absent: the catalog's default. */
+  severity: z.enum(SEVERITIES).optional(),
+  /** A code for failure or denied: invalid_credentials, rate_limited, … */
+  reason: z.string().regex(CODE_PATTERN).optional(),
+  actor: ActorSchema,
+  resource: ResourceSchema.optional(),
+  change: ChangeSchema.optional(),
+  request: RequestSchema.optional(),
+  network: NetworkSchema.optional(),
+  client: ClientSchema.optional(),
+  location: LocationSchema.optional(),
+  clientDeclared: clientDeclared.optional(),
+  /** Validated against the action's details spec in the catalog. */
+  details: boundedObject(LIMITS.detailsBytes).optional(),
+};
+
+/** An event as the connector's queue holds it, before it gets its sequence number. */
+export const AuditEventDraftSchema = z.strictObject(eventFields);
+
+/** An event as it travels to Audit Hub. */
+export const AuditEventSchema = z.strictObject({
+  ...eventFields,
+  /** Gapless per sequence epoch, assigned by the connector's queue in commit order. */
+  sourceSeq: z.int().min(1),
+});
+
+/** What a device sends to its own backend; the backend completes the rest. */
+export const ClientEventSchema = z.strictObject({
+  eventId: Uuidv7Schema,
+  occurredAt: TimestampSchema,
+  action: ActionSchema,
+  outcome: z.enum(OUTCOMES),
+  reason: z.string().regex(CODE_PATTERN).optional(),
+  resource: ResourceSchema.optional(),
+  client: ClientSchema,
+  location: LocationSchema.optional(),
+  details: boundedObject(LIMITS.detailsBytes).optional(),
+});
+
+export const ClientEventBatchSchema = z.strictObject({
+  events: z.array(ClientEventSchema).min(1).max(LIMITS.clientBatchEvents),
+  /**
+   * Events this device dropped since its last batch: queued for a user who
+   * signed out before they could be sent, so never sent as the next user.
+   * The API adds them up and its heartbeat reports them.
+   */
+  discardedAtSignOut: z.int().min(0).max(LIMITS.clientQueueEvents).optional(),
+});
+
+export const ClientEventResultSchema = z.strictObject({
+  eventId: z.string(),
+  status: z.enum(['accepted', 'duplicate', 'rejected']),
+  reason: z.string().regex(CODE_PATTERN).optional(),
+});
+
+export const ClientEventBatchResultSchema = z.strictObject({
+  results: z.array(ClientEventResultSchema),
+});
+
+export type Actor = z.infer<typeof ActorSchema>;
+export type Resource = z.infer<typeof ResourceSchema>;
+export type Change = z.infer<typeof ChangeSchema>;
+export type RequestInfo = z.infer<typeof RequestSchema>;
+export type NetworkInfo = z.infer<typeof NetworkSchema>;
+export type ClientHints = z.infer<typeof ClientHintsSchema>;
+export type ClientInfo = z.infer<typeof ClientSchema>;
+export type LocationInfo = z.infer<typeof LocationSchema>;
+export type AuditEventDraft = z.infer<typeof AuditEventDraftSchema>;
+export type AuditEvent = z.infer<typeof AuditEventSchema>;
+export type ClientEvent = z.infer<typeof ClientEventSchema>;
+export type ClientEventBatch = z.infer<typeof ClientEventBatchSchema>;
+export type ClientEventResult = z.infer<typeof ClientEventResultSchema>;
+export type ClientEventBatchResult = z.infer<typeof ClientEventBatchResultSchema>;
