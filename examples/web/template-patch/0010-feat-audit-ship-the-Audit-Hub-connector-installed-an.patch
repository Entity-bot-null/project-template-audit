index 0000000..4ced1ea
--- /dev/null
+++ b/apps/api/src/audit/request-scope.ts
@@ -0,0 +1,137 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+import { isIP } from 'node:net';
+import {
+  type CallHandler,
+  type ExecutionContext,
+  Injectable,
+  type NestInterceptor,
+} from '@nestjs/common';
+import type { Request } from 'express';
+import { Observable } from 'rxjs';
+import {
+  CLIENT_TYPES,
+  type ClientHints,
+  clientHintsFromHeaders,
+  type ClientInfo,
+  DEVICE_ID_PATTERN,
+  HTTP_METHODS,
+  LIMITS,
+  REQUEST_ID_PATTERN,
+  ROUTE_PATTERN,
+  TRACE_ID_PATTERN,
+  toWellFormed,
+  VERSION_TOKEN_PATTERN,
+} from './contract/index.js';
+import { clientIp, correlationIds } from './host.js';
+
+type HttpMethod = (typeof HTTP_METHODS)[number];
+type ClientType = (typeof CLIENT_TYPES)[number];
+
+/** What an event takes from the request it happened in. */
+export interface AuditScope {
+  /** clientIp(req): TRUST_PROXY applied, so a forged X-Forwarded-For changes nothing. */
+  ip?: string;
+  userAgent?: string;
+  /** What a Chromium browser says of itself beyond its user agent (Sec-CH-UA...). */
+  clientHints?: ClientHints;
+  requestId?: string;
+  traceId?: string;
+  method?: HttpMethod;
+  /** The route template (/api/users/:id), never the URL. */
+  route?: string;
+  /** The signed-in caller, as the access token says. */
+  user?: { id: string; role: string };
+  /** From the app's headers: X-App-Version, X-App-Build, X-Device-Id, X-App-Platform. */
+  client?: ClientInfo;
+}
+
+const storage = new AsyncLocalStorage<AuditScope>();
+
+/** The scope of the request being handled, if any (set by AuditScopeInterceptor). */
+export function currentScope(): AuditScope | undefined {
+  return storage.getStore();
+}
+
+/** Runs `work` with `scope` as the current one: for the specs, and for work done outside a request. */
+export function runInScope<T>(scope: AuditScope, work: () => T): T {
+  return storage.run(scope, work);
+}
+
+/** The scope of a request: what each event records of it, checked against the contract. */
+export function scopeOf(req: Request): AuditScope {
+  const scope: AuditScope = {};
+  const ip = clientIp(req);
+  if (isIP(ip) !== 0) scope.ip = ip;
+  const userAgent = req.get('user-agent');
+  if (userAgent !== undefined && userAgent.length > 0) {
+    scope.userAgent = toWellFormed(userAgent).slice(0, LIMITS.userAgent);
+  }
+  const clientHints = clientHintsFromHeaders((name) => req.get(name));
+  if (clientHints !== undefined) scope.clientHints = clientHints;
+  const ids = correlationIds();
+  if (ids.requestId !== undefined && REQUEST_ID_PATTERN.test(ids.requestId)) {
+    scope.requestId = ids.requestId;
+  }
+  if (ids.traceId !== undefined && TRACE_ID_PATTERN.test(ids.traceId)) scope.traceId = ids.traceId;
+  const method = req.method.toUpperCase();
+  if ((HTTP_METHODS as readonly string[]).includes(method)) scope.method = method as HttpMethod;
+  const route = routeOf(req);
+  if (route !== undefined) scope.route = route;
+  const user = (req as { user?: unknown }).user;
+  if (isUser(user)) scope.user = { id: user.id, role: user.role };
+  const client = clientOf(req);
+  if (client !== undefined) scope.client = client;
+  return scope;
+}
+
+function routeOf(req: Request): string | undefined {
+  const path = (req as { route?: { path?: unknown } }).route?.path;
+  if (typeof path !== 'string') return undefined;
+  const route = `${req.baseUrl}${path}`;
+  return ROUTE_PATTERN.test(route) ? route : undefined;
+}
+
+function isUser(value: unknown): value is { id: string; role: string } {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    'id' in value &&
+    typeof value.id === 'string' &&
+    'role' in value &&
+    typeof value.role === 'string'
+  );
+}
+
+/** The app's own headers (RELEASES.md of the app template); absent: no client section. */
+function clientOf(req: Request): ClientInfo | undefined {
+  const version = req.get('x-app-version');
+  const build = req.get('x-app-build');
+  const deviceId = req.get('x-device-id');
+  const platform = req.get('x-app-platform');
+  const client: Partial<ClientInfo> = {};
+  if (version !== undefined && VERSION_TOKEN_PATTERN.test(version)) client.appVersion = version;
+  if (build !== undefined && VERSION_TOKEN_PATTERN.test(build)) client.appBuild = build;
+  if (deviceId !== undefined && DEVICE_ID_PATTERN.test(deviceId)) client.deviceId = deviceId;
+  if (Object.keys(client).length === 0) return undefined;
+  const type: ClientType = (CLIENT_TYPES as readonly string[]).includes(platform ?? '')
+    ? (platform as ClientType)
+    : 'web';
+  return { type, ...client };
+}
+
+/**
+ * Makes each request's scope current while it is handled, so
+ * AuditService.record() needs no request argument. Registered for every
+ * route by AuditModule; it runs after the guards, so the signed-in user is
+ * known. A guard records with an explicit request instead.
+ */
+@Injectable()
+export class AuditScopeInterceptor implements NestInterceptor {
+  intercept(context: ExecutionContext, next: CallHandler): Observable<unknown> {
+    if (context.getType() !== 'http') return next.handle();
+    const scope = scopeOf(context.switchToHttp().getRequest<Request>());
+    return new Observable((subscriber) =>
+      storage.run(scope, () => next.handle().subscribe(subscriber)),
+    );
+  }
+}
diff --git a/apps/api/src/audit/security-prompts.service.spec.ts b/apps/api/src/audit/security-prompts.service.spec.ts
new file mode 100644
index 0000000..71476f2
--- /dev/null
+++ b/apps/api/src/audit/security-prompts.service.spec.ts
@@ -0,0 +1,184 @@
+import { randomUUID } from 'node:crypto';
+import { NotFoundException } from '@nestjs/common';
+import { beforeEach, describe, expect, it } from 'vitest';
+import type { AuditConfig } from './audit-env.js';
+import { PROMPT_TTL_MS } from './audit.constants.js';
+import type { AuditHandlers, SecurityPrompt } from './audit.ports.js';
+import { AuditService } from './audit.service.js';
+import { MemoryStore, TEST_CONFIG, TEST_TX } from './audit.testing.js';
+import { nodeRandomFill, uuidv7 } from './contract/index.js';
+import type { AuditTx } from './host.js';
+import { SecurityPromptsService } from './security-prompts.service.js';
+
+const NOW = Date.UTC(2026, 9, 15, 12, 0, 0);
+let now = NOW;
+const clock = () => now;
+
+function setup(handlers: AuditHandlers = {}, config: AuditConfig | null = TEST_CONFIG) {
+  const store = new MemoryStore();
+  store.now = clock;
+  store.users.add('user-2');
+  const audit = new AuditService(config, store, clock);
+  const service = new SecurityPromptsService(config, store, handlers, clock, audit);
+  return { store, service };
+}
+
+/** A prompt as the webhook stores it. */
+async function prompt(
+  store: MemoryStore,
+  userId = 'user-1',
+  expiresAt = new Date(now + PROMPT_TTL_MS),
+): Promise<SecurityPrompt> {
+  const saved = await store.savePrompt(TEST_TX, {
+    userId,
+    webhookId: randomUUID(),
+    hubEventId: uuidv7(nodeRandomFill, now),
+    signals: ['new_device', 'new_country'],
+    context: { country: 'MX', city: 'Monterrey', clientType: 'ios' },
+    expiresAt,
+  });
+  if (saved === null) throw new Error('The prompt was not stored');
+  return saved;
+}
+
+function viewOf(saved: SecurityPrompt) {
+  return {
+    id: saved.id,
+    signals: ['new_device', 'new_country'],
+    context: { country: 'MX', city: 'Monterrey', clientType: 'ios' },
+    createdAt: saved.createdAt.toISOString(),
+    expiresAt: saved.expiresAt.toISOString(),
+  };
+}
+
+beforeEach(() => {
+  now = NOW;
+});
+
+describe('SecurityPromptsService', () => {
+  it('answers 404 while the connector is off', async () => {
+    const { store, service } = setup({}, null);
+    const open = await prompt(store);
+
+    await expect(service.open('user-1')).rejects.toThrow(NotFoundException);
+    await expect(service.answer('user-1', open.id, 'confirmed')).rejects.toThrow(NotFoundException);
+    expect(store.prompts[0]?.answer).toBeNull();
+  });
+
+  it("lists only the user's open prompts, without Audit Hub's ids", async () => {
+    const { store, service } = setup();
+    const open = await prompt(store);
+    await prompt(store, 'user-1', new Date(now - 1));
+    const answered = await prompt(store);
+    await store.answerPrompt(TEST_TX, 'user-1', answered.id, 'confirmed', new Date(now));
+    await prompt(store, 'user-2');
+
+    await expect(service.open('user-1')).resolves.toEqual([viewOf(open)]);
+  });
+
+  describe('answering', () => {
+    it.each(['missing', 'expired', 'answered', "another user's"] as const)(
+      'answers 404 for a prompt %s, recording nothing',
+      async (kind) => {
+        const { store, service } = setup();
+        const target =
+          kind === 'missing'
+            ? randomUUID()
+            : kind === 'expired'
+              ? (await prompt(store, 'user-1', new Date(now - 1))).id
+              : kind === 'answered'
+                ? (await prompt(store)).id
+                : (await prompt(store, 'user-2')).id;
+        if (kind === 'answered') {
+          await store.answerPrompt(TEST_TX, 'user-1', target, 'confirmed', new Date(now));
+        }
+
+        await expect(service.answer('user-1', target, 'not_me')).rejects.toThrow(
+          new NotFoundException('Security prompt not found'),
+        );
+        expect(store.rows).toEqual([]);
+      },
+    );
+
+    it('records a confirmation as an event of the default severity', async () => {
+      let notMe = 0;
+      const { store, service } = setup({
+        onNotMe: () => {
+          notMe += 1;
+          return Promise.resolve();
+        },
+      });
+      const open = await prompt(store);
+      now += 60_000;
+
+      const answer = await service.answer('user-1', open.id, 'confirmed');
+
+      expect(answer).toEqual({ ...viewOf(open), answer: 'confirmed' });
+      expect(store.prompts[0]).toMatchObject({ answer: 'confirmed', answeredAt: new Date(now) });
+      expect(store.rows).toHaveLength(1);
+      const draft = store.rows[0]?.draft;
+      expect(draft).toMatchObject({
+        action: 'account.security_prompt.answered',
+        outcome: 'success',
+        actor: { type: 'user', id: 'user-1' },
+        details: { answer: 'confirmed' },
+      });
+      expect(draft).not.toHaveProperty('severity');
+      expect(notMe).toBe(0);
+    });
+
+    it('records "not me" as high severity and runs onNotMe in the transaction', async () => {
+      const calls: { tx: AuditTx; userId: string; queued: number }[] = [];
+      const { store, service } = setup({
+        onNotMe: (tx, userId) => {
+          calls.push({ tx, userId, queued: store.rows.length });
+          return Promise.resolve();
+        },
+      });
+      const open = await prompt(store);
+
+      const answer = await service.answer('user-1', open.id, 'not_me');
+
+      expect(answer).toEqual({ ...viewOf(open), answer: 'not_me' });
+      expect(calls).toEqual([{ tx: TEST_TX, userId: 'user-1', queued: 1 }]);
+      expect(store.rows[0]?.draft).toMatchObject({
+        action: 'account.security_prompt.answered',
+        severity: 'high',
+        details: { answer: 'not_me' },
+      });
+    });
+
+    it('records "not me" without onNotMe', async () => {
+      const { store, service } = setup();
+      const open = await prompt(store);
+
+      await expect(service.answer('user-1', open.id, 'not_me')).resolves.toMatchObject({
+        answer: 'not_me',
+      });
+      expect(store.rows).toHaveLength(1);
+    });
+
+    it('rolls everything back when onNotMe fails, so the prompt can be answered again', async () => {
+      let failing = true;
+      const { store, service } = setup({
+        onNotMe: () =>
+          failing ? Promise.reject(new Error('sessions table locked')) : Promise.resolve(),
+      });
+      const open = await prompt(store);
+
+      await expect(service.answer('user-1', open.id, 'not_me')).rejects.toThrow(
+        'sessions table locked',
+      );
+
+      expect(store.prompts[0]?.answer).toBeNull();
+      expect(store.rows).toEqual([]);
+      await expect(service.open('user-1')).resolves.toEqual([viewOf(open)]);
+
+      failing = false;
+      await expect(service.answer('user-1', open.id, 'not_me')).resolves.toMatchObject({
+        answer: 'not_me',
+      });
+      expect(store.rows).toHaveLength(1);
+    });
+  });
+});
diff --git a/apps/api/src/audit/security-prompts.service.ts b/apps/api/src/audit/security-prompts.service.ts
new file mode 100644
index 0000000..7c4c215
--- /dev/null
+++ b/apps/api/src/audit/security-prompts.service.ts
@@ -0,0 +1,63 @@
+import { Inject, Injectable, NotFoundException } from '@nestjs/common';
+import type { AuditConfig } from './audit-env.js';
+import { AUDIT_CLOCK, AUDIT_CONFIG, AUDIT_HANDLERS, AUDIT_STORE } from './audit.constants.js';
+import type { AuditHandlers, AuditStore, PromptAnswer, SecurityPrompt } from './audit.ports.js';
+import { AuditService } from './audit.service.js';
+
+/** A prompt as the user's app shows it: no ids of Audit Hub, no addresses. */
+export interface PromptView {
+  id: string;
+  signals: string[];
+  context: Record<string, string>;
+  createdAt: string;
+  expiresAt: string;
+}
+
+const viewOf = (prompt: SecurityPrompt): PromptView => ({
+  id: prompt.id,
+  signals: prompt.signals,
+  context: prompt.context,
+  createdAt: prompt.createdAt.toISOString(),
+  expiresAt: prompt.expiresAt.toISOString(),
+});
+
+/**
+ * "Was it you?": the sign-ins Audit Hub found suspicious, for the user they
+ * are about. Answering "not me" runs the project's onNotMe (end the
+ * sessions) in the answer's transaction; every answer is an event.
+ */
+@Injectable()
+export class SecurityPromptsService {
+  constructor(
+    @Inject(AUDIT_CONFIG) private readonly config: AuditConfig | null,
+    @Inject(AUDIT_STORE) private readonly store: AuditStore,
+    @Inject(AUDIT_HANDLERS) private readonly handlers: AuditHandlers,
+    @Inject(AUDIT_CLOCK) private readonly clock: () => number,
+    private readonly audit: AuditService,
+  ) {}
+
+  async open(userId: string): Promise<PromptView[]> {
+    if (this.config === null) throw new NotFoundException('Not found');
+    return (await this.store.openPrompts(userId, new Date(this.clock()))).map(viewOf);
+  }
+
+  async answer(
+    userId: string,
+    id: string,
+    answer: PromptAnswer,
+  ): Promise<PromptView & { answer: PromptAnswer }> {
+    if (this.config === null) throw new NotFoundException('Not found');
+    return this.store.transaction(async (tx) => {
+      const prompt = await this.store.answerPrompt(tx, userId, id, answer, new Date(this.clock()));
+      if (prompt === null) throw new NotFoundException('Security prompt not found');
+      await this.audit.record(tx, {
+        action: 'account.security_prompt.answered',
+        ...(answer === 'not_me' ? { severity: 'high' as const } : {}),
+        actor: { type: 'user', id: userId },
+        details: { answer },
+      });
+      if (answer === 'not_me') await this.handlers.onNotMe?.(tx, userId);
+      return { ...viewOf(prompt), answer };
+    });
+  }
+}
diff --git a/apps/api/src/audit/webhooks.service.spec.ts b/apps/api/src/audit/webhooks.service.spec.ts
new file mode 100644
index 0000000..8f2bd29
--- /dev/null
+++ b/apps/api/src/audit/webhooks.service.spec.ts
@@ -0,0 +1,545 @@
+import { randomUUID } from 'node:crypto';
+import {
+  BadRequestException,
+  ConsoleLogger,
+  Logger,
+  type LoggerService,
+  NotFoundException,
+  UnauthorizedException,
+} from '@nestjs/common';
+import type { Request } from 'express';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import type { AuditConfig } from './audit-env.js';
+import { CONTRACT_VERSION, PROMPT_TTL_MS, WEBHOOK_PATH } from './audit.constants.js';
+import type { AuditHandlers, ResponseActionResult, SecurityPrompt } from './audit.ports.js';
+import { AuditService } from './audit.service.js';
+import {
+  FakePushSender,
+  MemoryStore,
+  TEST_CONFIG,
+  TEST_PUSH_CONFIG,
+  TEST_TX,
+} from './audit.testing.js';
+import { PushService } from './push.service.js';
+import {
+  nodeRandomFill,
+  secretKey,
+  SIGNATURE_HEADERS,
+  SIGNATURE_WINDOW_SEC,
+  signWebhook,
+  uuidv7,
+} from './contract/index.js';
+import type { AuditTx } from './host.js';
+import { WebhooksService } from './webhooks.service.js';
+
+const NOW = Date.UTC(2026, 9, 15, 12, 0, 0);
+let now = NOW;
+const clock = () => now;
+
+const CURRENT_SECRET = TEST_CONFIG.webhookSecrets[0] ?? '';
+const NEXT_SECRET = Buffer.alloc(32, 7).toString('base64url');
+const OTHER_SECRET = Buffer.alloc(32, 9).toString('base64url');
+
+/** Nest's logger, recorded. */
+class LogCapture implements LoggerService {
+  readonly lines: { level: 'log' | 'warn' | 'error'; message: string }[] = [];
+  log(message: string): void {
+    this.lines.push({ level: 'log', message });
+  }
+  warn(message: string): void {
+    this.lines.push({ level: 'warn', message });
+  }
+  error(message: string): void {
+    this.lines.push({ level: 'error', message });
+  }
+  of(level: 'log' | 'warn' | 'error'): string[] {
+    return this.lines.filter((line) => line.level === level).map((line) => line.message);
+  }
+}
+
+/** Something thrown that is not an Error. */
+const notAnError = { toString: () => 'plain failure' } as unknown as Error;
+
+interface Envelope {
+  id: string;
+  type: string;
+  createdAt: string;
+  contractVersion: number;
+  data: unknown;
+}
+
+function envelope(type: string, data: unknown): Envelope {
+  return {
+    id: randomUUID(),
+    type,
+    createdAt: new Date(now).toISOString(),
+    contractVersion: CONTRACT_VERSION,
+    data,
+  };
+}
+
+interface DeliveryOptions {
+  /** The Audit-Webhook-Id signed and sent; the body's id by default. */
+  deliveryId?: string;
+  secrets?: string[];
+  appSlug?: string;
+  signedAt?: number;
+  /** What was signed, when it is not the body. */
+  signedBody?: unknown;
+  /** Headers replaced or, as undefined, left out. */
+  headers?: Record<string, string | undefined>;
+  url?: string;
+}
+
+/** A delivery as Audit Hub signs it, as Express hands it over. */
+function delivery(body: unknown, options: DeliveryOptions = {}): Request {
+  const deliveryId =
+    options.deliveryId ??
+    (typeof body === 'object' && body !== null && 'id' in body ? String(body.id) : randomUUID());
+  const signed = signWebhook({
+    keys: (options.secrets ?? [CURRENT_SECRET]).map((secret) => secretKey(secret)),
+    appSlug: options.appSlug ?? TEST_CONFIG.app,
+    deliveryId,
+    path: WEBHOOK_PATH,
+    body: 'signedBody' in options ? options.signedBody : body,
+    now: options.signedAt ?? now,
+  });
+  const headers: Record<string, string | undefined> = { ...signed, ...options.headers };
+  return {
+    body,
+    originalUrl: options.url ?? WEBHOOK_PATH,
+    get: (name: string) => headers[name.toLowerCase()],
+  } as unknown as Request;
+}
+
+function setup(
+  handlers: AuditHandlers = {},
+  config: AuditConfig | null = TEST_CONFIG,
+  sender: FakePushSender | null = null,
+) {
+  const store = new MemoryStore();
+  store.now = clock;
+  const audit = new AuditService(config, store, clock);
+  const push = new PushService(config, store, sender, handlers);
+  const service = new WebhooksService(config, store, handlers, clock, audit, push);
+  return { store, audit, service };
+}
+
+const alertData = () => ({
+  alertId: randomUUID(),
+  rule: 'auth.credential_stuffing',
+  severity: 'high' as const,
+  subject: 'user-1',
+  summary: '40 failed sign-ins from 12 addresses in 5 minutes',
+  firstEventId: uuidv7(nodeRandomFill, now),
+});
+
+const suspiciousData = (subject = 'user-1') => ({
+  subject,
+  eventId: uuidv7(nodeRandomFill, now),
+  occurredAt: new Date(now - 60_000).toISOString(),
+  signals: ['new_device', 'impossible_travel'],
+  context: { country: 'MX', city: 'Monterrey', clientType: 'ios', deviceModel: 'iPhone 16' },
+});
+
+const actionData = (overrides: Record<string, unknown> = {}) => ({
+  actionId: randomUUID(),
+  action: 'revoke_sessions',
+  subject: 'user-1',
+  reason: 'Credential stuffing against this account',
+  requestedAt: new Date(now).toISOString(),
+  expiresAt: new Date(now + 10 * 60_000).toISOString(),
+  ...overrides,
+});
+
+let logs: LogCapture;
+
+beforeEach(() => {
+  now = NOW;
+  logs = new LogCapture();
+  Logger.overrideLogger(logs);
+});
+
+afterEach(() => {
+  Logger.overrideLogger(new ConsoleLogger());
+});
+
+describe('WebhooksService', () => {
+  it.each([
+    ['while the connector is off', null],
+    ['without a webhook secret', { ...TEST_CONFIG, webhookSecrets: [] }],
+  ])('answers 404 %s', async (_case, config) => {
+    const { service } = setup({}, config);
+
+    await expect(service.receive(delivery(envelope('ping', {})))).rejects.toThrow(
+      NotFoundException,
+    );
+  });
+
+  describe('verifying the signature', () => {
+    const cases: [string, (body: Envelope) => Request][] = [
+      [
+        'no delivery id',
+        (body) => delivery(body, { headers: { [SIGNATURE_HEADERS.webhookId]: undefined } }),
+      ],
+      ['a delivery id that is not a UUID', (body) => delivery(body, { deliveryId: 'delivery-1' })],
+      [
+        'no timestamp',
+        (body) => delivery(body, { headers: { [SIGNATURE_HEADERS.timestamp]: undefined } }),
+      ],
+      [
+        'a timestamp that is not one',
+        (body) => delivery(body, { headers: { [SIGNATURE_HEADERS.timestamp]: '2026-10-15' } }),
+      ],
+      [
+        'a stale timestamp',
+        (body) => delivery(body, { signedAt: now - (SIGNATURE_WINDOW_SEC + 1) * 1000 }),
+      ],
+      [
+        'a timestamp ahead of the window',
+        (body) => delivery(body, { signedAt: now + (SIGNATURE_WINDOW_SEC + 1) * 1000 }),
+      ],
+      [
+        'no body digest',
+        (body) => delivery(body, { headers: { [SIGNATURE_HEADERS.bodyDigest]: undefined } }),
+      ],
+      [
+        'no signature',
+        (body) => delivery(body, { headers: { [SIGNATURE_HEADERS.signature]: undefined } }),
+      ],
+      [
+        'a signature of another scheme',
+        (body) =>
+          delivery(body, { headers: { [SIGNATURE_HEADERS.signature]: `v2=${'a'.repeat(43)}` } }),
+      ],
+      [
+        'a digest of another body',
+        (body) => delivery(body, { signedBody: { ...body, type: 'alert.created' } }),
+      ],
+      ['a signature with another key', (body) => delivery(body, { secrets: [OTHER_SECRET] })],
+      ['a signature for another application', (body) => delivery(body, { appSlug: 'blog' })],
+      ['a signature for another path', (body) => delivery(body, { url: '/api/other' })],
+      [
+        "a delivery id that is not the body's",
+        (body) => delivery(body, { deliveryId: randomUUID() }),
+      ],
+    ];
+
+    it.each(cases)('answers 401 for %s', async (_case, request) => {
+      const { store, service } = setup();
+
+      await expect(service.receive(request(envelope('ping', {})))).rejects.toThrow(
+        new UnauthorizedException('Invalid webhook signature'),
+      );
+      expect(store.receipts.size).toBe(0);
+    });
+
+    it('takes the path without its query', async () => {
+      const { service } = setup();
+
+      await expect(
+        service.receive(delivery(envelope('ping', {}), { url: `${WEBHOOK_PATH}?attempt=2` })),
+      ).resolves.toBe('accepted');
+    });
+
+    it.each([
+      ['the previous secret', [CURRENT_SECRET]],
+      ['both secrets', [NEXT_SECRET, CURRENT_SECRET]],
+      ['the new secret', [NEXT_SECRET]],
+    ])('accepts a delivery signed with %s during a rotation', async (_case, secrets) => {
+      const { service } = setup(
+        {},
+        { ...TEST_CONFIG, webhookSecrets: [NEXT_SECRET, CURRENT_SECRET] },
+      );
+
+      await expect(service.receive(delivery(envelope('ping', {}), { secrets }))).resolves.toBe(
+        'accepted',
+      );
+    });
+  });
+
+  it('answers 400 for a body that is not a webhook', async () => {
+    const { store, service } = setup();
+
+    await expect(
+      service.receive(delivery({ hello: 'world' }, { deliveryId: randomUUID() })),
+    ).rejects.toThrow(BadRequestException);
+    expect(store.receipts.size).toBe(0);
+  });
+
+  it.each([
+    ['an unknown type', envelope('report.ready', { reportId: 'r-1' })],
+    ['a known type with data it does not understand', envelope('alert.created', { alert: 1 })],
+  ])('answers unsupported for %s', async (_case, body) => {
+    const { store, service } = setup();
+
+    await expect(service.receive(delivery(body))).resolves.toBe('unsupported');
+    expect(store.receipts.size).toBe(0);
+    expect(logs.of('warn')).toEqual([`Webhook ${body.type} not understood: answered unsupported`]);
+  });
+
+  it('accepts a ping and remembers the delivery', async () => {
+    const { store, service } = setup();
+    const body = envelope('ping', {});
+
