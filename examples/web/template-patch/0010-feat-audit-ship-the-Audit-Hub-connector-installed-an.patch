@@ -0,0 +1,65 @@
+import { describe, expect, it } from 'vitest';
+import {
+  coarseAccuracy,
+  locationAccuracy,
+  locationDecimals,
+  maskEmail,
+  maskName,
+  maskPhone,
+  normalizeEmail,
+  roundCoordinate,
+} from './masking.js';
+import { PHONE_LABEL_PATTERN } from './patterns.js';
+
+describe('masking', () => {
+  it('normalizes emails as the template does', () => {
+    expect(normalizeEmail('  John.Doe@Example.COM ')).toBe('john.doe@example.com');
+  });
+
+  it('masks an email to its initials and top-level domain', () => {
+    expect(maskEmail('John.Doe@Example.com')).toBe('j***@e***.com');
+    expect(maskEmail('a@localhost')).toBe('a***@l***');
+    expect(maskEmail('no-at-sign')).toBe('n***');
+    expect(maskEmail('@example.com')).toBe('@***');
+  });
+
+  it('masks a name to the initials of its words', () => {
+    expect(maskName('  Ana  María López ')).toBe('A*** M*** L***');
+    expect(maskName('Ñandú')).toBe('Ñ***');
+    expect(maskName('   ')).toBe('');
+  });
+
+  it('rounds coordinates to two decimals and never claims better than 1 km', () => {
+    expect(roundCoordinate(19.432_608)).toBe(19.43);
+    expect(roundCoordinate(-99.133_209)).toBe(-99.13);
+    expect(coarseAccuracy(12)).toBe(1000);
+    expect(coarseAccuracy(2500.4)).toBe(2500);
+    expect(coarseAccuracy(10_000_000)).toBe(100_000);
+    expect(coarseAccuracy(null)).toBe(1000);
+  });
+
+  it('keeps five decimals of a precise position, as reported but never under a metre', () => {
+    expect(locationDecimals(4.6)).toBe(5);
+    expect(locationDecimals(999)).toBe(5);
+    expect(locationDecimals(1000)).toBe(2);
+    expect(locationDecimals(null)).toBe(2);
+    expect(locationDecimals(undefined)).toBe(2);
+    expect(roundCoordinate(19.432_608_1, 5)).toBe(19.432_61);
+    expect(roundCoordinate(-0.000_001, 5)).toBe(0);
+    expect(Object.is(roundCoordinate(-0.000_001, 5), -0)).toBe(false);
+    expect(locationAccuracy(4.6)).toBe(5);
+    expect(locationAccuracy(0.2)).toBe(1);
+    expect(locationAccuracy(12_000)).toBe(12_000);
+    expect(locationAccuracy(null)).toBe(1000);
+  });
+
+  it('masks a phone to its last four digits, whatever its format', () => {
+    for (const phone of ['+52 81 1234 5678', '(81) 1234-5678', '8112345678', '+1-415-555-5678']) {
+      const masked = maskPhone(phone);
+      expect(masked).toBe('•••• 5678');
+      expect(masked).toMatch(PHONE_LABEL_PATTERN);
+    }
+    expect(maskPhone('123')).toBeUndefined();
+    expect(maskPhone('no digits')).toBeUndefined();
+  });
+});
diff --git a/apps/api/src/audit/contract/masking.ts b/apps/api/src/audit/contract/masking.ts
new file mode 100644
index 0000000..3cac827
--- /dev/null
+++ b/apps/api/src/audit/contract/masking.ts
@@ -0,0 +1,87 @@
+// Minimization at the origin (brief, section 12): what leaves the application
+// is already masked. Audit Hub never needs the clear value to search: emails
+// travel as an HMAC (src/node/pseudonym.ts), labels as masks.
+
+/** The marker a sensitive value is replaced with before it is queued. */
+export const REDACTED = '[REDACTED]';
+
+/** What a personal value becomes in the event once it moved to the satellite table. */
+export const PERSONAL_PLACEHOLDER = Object.freeze({ $personal: true });
+
+/** Trimmed and lowercased, as the template stores addresses (normalizeEmail). */
+export function normalizeEmail(email: string): string {
+  return email.trim().toLowerCase();
+}
+
+/** j***@e***.com: enough to recognize an account, not to write to it. */
+export function maskEmail(email: string): string {
+  const normalized = normalizeEmail(email);
+  const at = normalized.lastIndexOf('@');
+  if (at <= 0) return maskWord(normalized);
+  const domain = normalized.slice(at + 1);
+  const dot = domain.lastIndexOf('.');
+  const host = dot > 0 ? domain.slice(0, dot) : domain;
+  const suffix = dot > 0 ? domain.slice(dot) : '';
+  return `${maskWord(normalized.slice(0, at))}@${maskWord(host)}${suffix}`;
+}
+
+/** J*** D***: the initials of a name. */
+export function maskName(name: string): string {
+  return name
+    .trim()
+    .split(/\s+/)
+    .filter((word) => word.length > 0)
+    .map(maskWord)
+    .join(' ');
+}
+
+function maskWord(word: string): string {
+  const first = Array.from(word)[0];
+  return first === undefined ? '' : `${first}***`;
+}
+
+/** •••• 1234: enough to recognize a phone, not to call it. Undefined without four digits. */
+export function maskPhone(phone: string): string | undefined {
+  const digits = phone.replace(/[^0-9]/g, '');
+  return digits.length < 4 ? undefined : `•••• ${digits.slice(-4)}`;
+}
+
+/** An approximate position's decimals: about 1.1 km of latitude. */
+export const COARSE_DECIMALS = 2;
+/** A precise position's decimals (consent to the precise position): about 1.1 m. */
+export const PRECISE_DECIMALS = 5;
+/** Accuracy from which a position counts as approximate. */
+export const COARSE_ACCURACY_M = 1000;
+
+/**
+ * A position's precision follows its accuracy: a precise one (better than
+ * COARSE_ACCURACY_M, which the device reports only when the person allowed
+ * the precise position) keeps five decimals; any other is rounded to two, on
+ * the device and again when Audit Hub receives it.
+ */
+export function locationDecimals(accuracyMeters: number | null | undefined): number {
+  return accuracyMeters !== null &&
+    accuracyMeters !== undefined &&
+    accuracyMeters < COARSE_ACCURACY_M
+    ? PRECISE_DECIMALS
+    : COARSE_DECIMALS;
+}
+
+export function roundCoordinate(value: number, decimals: number = COARSE_DECIMALS): number {
+  const factor = 10 ** decimals;
+  // + 0: never -0, which canonical JSON would write as 0 anyway.
+  return Math.round(value * factor) / factor + 0;
+}
+
+/** The accuracy a rounded position can claim: never better than 1 km. */
+export function coarseAccuracy(accuracyMeters: number | null | undefined): number {
+  const value = accuracyMeters ?? COARSE_ACCURACY_M;
+  return Math.min(100_000, Math.max(COARSE_ACCURACY_M, Math.round(value)));
+}
+
+/** A position's accuracy as stored: a precise one as reported (1 m at best), an approximate one coarse. */
+export function locationAccuracy(accuracyMeters: number | null | undefined): number {
+  return locationDecimals(accuracyMeters) === PRECISE_DECIMALS
+    ? Math.max(1, Math.round(accuracyMeters ?? COARSE_ACCURACY_M))
+    : coarseAccuracy(accuracyMeters);
+}
diff --git a/apps/api/src/audit/contract/node/crypto.ts b/apps/api/src/audit/contract/node/crypto.ts
new file mode 100644
index 0000000..1a60ee7
--- /dev/null
+++ b/apps/api/src/audit/contract/node/crypto.ts
@@ -0,0 +1,147 @@
+import { createHash, createHmac, randomBytes, timingSafeEqual, webcrypto } from 'node:crypto';
+import { canonicalJson } from '../canonical-json.js';
+import { normalizeEmail } from '../masking.js';
+import {
+  BODY_DIGEST_PREFIX,
+  formatSignatureHeader,
+  SIGNATURE_HEADERS,
+  type SignedParts,
+  stringToSign,
+} from '../signing.js';
+
+// The Node.js side of the contract: hashes, HMACs and the signing of requests
+// and webhooks. Secrets travel in environment variables as base64url (32
+// random bytes); keys are their decoded bytes.
+
+/** 32 random bytes as base64url: a new key, webhook secret or pseudonymization key. */
+export function newSecret(): string {
+  return randomBytes(32).toString('base64url');
+}
+
+/** The key bytes of a base64url secret; refuses anything shorter than 32 bytes. */
+export function secretKey(secret: string): Buffer {
+  const key = Buffer.from(secret, 'base64url');
+  if (key.length < 32 || key.toString('base64url') !== secret) {
+    throw new TypeError('secret must be at least 32 bytes as base64url');
+  }
+  return key;
+}
+
+export function sha256Hex(text: string | Uint8Array): string {
+  return createHash('sha256').update(text).digest('hex');
+}
+
+export function sha256Base64url(text: string | Uint8Array): string {
+  return createHash('sha256').update(text).digest('base64url');
+}
+
+export function hmacHex(key: Uint8Array, text: string): string {
+  return createHmac('sha256', key).update(text).digest('hex');
+}
+
+/** The pseudonym an email travels as: HMAC of the normalized address, with the app's key. */
+export function emailHmac(key: Uint8Array, email: string): string {
+  return hmacHex(key, normalizeEmail(email));
+}
+
+/** Audit-Body-Digest of a parsed JSON body (undefined: no body). */
+export function bodyDigest(body: unknown): string {
+  return `${BODY_DIGEST_PREFIX}${sha256Base64url(body === undefined ? '' : canonicalJson(body))}`;
+}
+
+export function signature(key: Uint8Array, parts: SignedParts): string {
+  return createHmac('sha256', key).update(stringToSign(parts)).digest('base64url');
+}
+
+/** 16 random bytes as base64url (22 characters). */
+export function newNonce(): string {
+  return randomBytes(16).toString('base64url');
+}
+
+export interface SignRequestInput {
+  keyId: string;
+  key: Uint8Array;
+  method: string;
+  path: string;
+  query?: string;
+  body?: unknown;
+  /** Milliseconds. */
+  now?: number;
+  nonce?: string;
+}
+
+/** The headers of a signed request to Audit Hub. */
+export function signRequest(input: SignRequestInput): Record<string, string> {
+  const parts: SignedParts = {
+    method: input.method,
+    path: input.path,
+    query: input.query ?? '',
+    timestamp: Math.floor((input.now ?? Date.now()) / 1000),
+    nonce: input.nonce ?? newNonce(),
+    keyId: input.keyId,
+    bodyDigest: bodyDigest(input.body),
+  };
+  return {
+    [SIGNATURE_HEADERS.keyId]: parts.keyId,
+    [SIGNATURE_HEADERS.timestamp]: String(parts.timestamp),
+    [SIGNATURE_HEADERS.nonce]: parts.nonce,
+    [SIGNATURE_HEADERS.bodyDigest]: parts.bodyDigest,
+    [SIGNATURE_HEADERS.signature]: formatSignatureHeader([signature(input.key, parts)]),
+  };
+}
+
+export interface SignWebhookInput {
+  /** Current key first; the previous one during a rotation. */
+  keys: readonly Uint8Array[];
+  appSlug: string;
+  deliveryId: string;
+  path: string;
+  body: unknown;
+  now?: number;
+}
+
+/** The headers of a signed webhook delivery (one signature per key). */
+export function signWebhook(input: SignWebhookInput): Record<string, string> {
+  const parts: SignedParts = {
+    method: 'POST',
+    path: input.path,
+    query: '',
+    timestamp: Math.floor((input.now ?? Date.now()) / 1000),
+    nonce: input.deliveryId,
+    keyId: input.appSlug,
+    bodyDigest: bodyDigest(input.body),
+  };
+  return {
+    [SIGNATURE_HEADERS.webhookId]: input.deliveryId,
+    [SIGNATURE_HEADERS.timestamp]: String(parts.timestamp),
+    [SIGNATURE_HEADERS.bodyDigest]: parts.bodyDigest,
+    [SIGNATURE_HEADERS.signature]: formatSignatureHeader(
+      input.keys.map((key) => signature(key, parts)),
+    ),
+  };
+}
+
+/** Constant-time comparison of two base64url strings. */
+export function safeEqual(a: string, b: string): boolean {
+  const left = Buffer.from(a);
+  const right = Buffer.from(b);
+  return left.length === right.length && timingSafeEqual(left, right);
+}
+
+/** Whether any of the signatures matches any of the keys. */
+export function verifySignature(
+  keys: readonly Uint8Array[],
+  parts: SignedParts,
+  signatures: readonly string[],
+): boolean {
+  let valid = false;
+  for (const key of keys) {
+    const expected = signature(key, parts);
+    // Every comparison runs: the time taken never says which one matched.
+    for (const candidate of signatures) valid = safeEqual(expected, candidate) || valid;
+  }
+  return valid;
+}
+
+/** The random source of the contract's UUIDv7 on Node.js. */
+export const nodeRandomFill = (bytes: Uint8Array): Uint8Array => webcrypto.getRandomValues(bytes);
