+    expect(screen.getByText('IP Geolocation by DB-IP')).toBeInTheDocument();
+    const asked = calls.find((request) => routeOf(request) === ACTIVITY);
+    expect(new URL(asked!.url).searchParams.get('limit')).toBe('20');
+  });
+
+  it('says when there is nothing yet, and offers a retry when Audit Hub cannot answer', async () => {
+    let answer = () => failure(503, 'Audit Hub unavailable');
+    stubFetch({ [CAPABILITIES]: withAudit, [ACTIVITY]: () => answer() });
+    renderRoute('/account');
+    const retry = await screen.findByRole('button', { name: 'Retry' });
+    answer = () => ok({ items: [] });
+    await userEvent.setup().click(retry);
+    expect(await screen.findByText('Nothing yet.')).toBeInTheDocument();
