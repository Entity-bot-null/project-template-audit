+      RETRY_FIRST_MS * 2,
+      RETRY_FIRST_MS * 4,
+      RETRY_FIRST_MS * 8,
+    ]);
+    expect(retryDelay(-1, middle)).toBe(RETRY_FIRST_MS);
+  });
+
+  it('never waits more than the longest wait', () => {
