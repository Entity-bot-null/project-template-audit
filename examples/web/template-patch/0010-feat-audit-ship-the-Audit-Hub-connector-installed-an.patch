+import request from 'supertest';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { createTestApp, type TestApp } from '../../test/app.js';
+import { envelopeOf } from '../../test/http.js';
+import { AUDIT_CONFIG } from '../audit/audit.constants.js';
+import { TEST_CONFIG } from '../audit/audit.testing.js';
+import { ForwarderService } from '../audit/forwarder.service.js';
+import type { AuthCapabilities } from './dto/auth.schemas.js';
+
+// The web app's switch for Audit Hub's SPA connector (apps/web/src/audit):
+// the capabilities say auditClientEvents when the API's connector is on, so
+// the page loads its reporter and shows the account's activity. Off, the
+// other auth specs see it false.
+
+describe('the capabilities, with the Audit Hub connector on', () => {
+  let t: TestApp;
+
+  beforeAll(async () => {
+    t = await createTestApp((builder) =>
+      builder.overrideProvider(AUDIT_CONFIG).useValue(TEST_CONFIG),
+    );
+    // No Audit Hub here: the forwarder never sends.
+    t.app.get(ForwarderService).onModuleDestroy();
+  });
+
+  afterAll(async () => {
+    await t.app.close();
+  });
+
+  it("say the web app may report its own events and show the account's activity", async () => {
+    const response = await request(t.server).get('/api/auth/capabilities').expect(200);
+    expect(envelopeOf<AuthCapabilities>(response).data.auditClientEvents).toBe(true);
+  });
+});
