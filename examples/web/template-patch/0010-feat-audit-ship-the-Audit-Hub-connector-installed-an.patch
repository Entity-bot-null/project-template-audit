+import { describe, expect, it } from 'vitest';
+import { isWellFormed, toWellFormed } from './unicode.js';
+
+const HIGH = '\uD83D';
+const LOW = '\uDE00';
+
+describe('well-formed strings', () => {
+  it('accepts text and surrogate pairs', () => {
+    for (const text of [
+      '',
+      'plain',
+      'añadir',
+      `smile ${HIGH}${LOW}`,
+      `${HIGH}${LOW}${HIGH}${LOW}`,
+    ]) {
+      expect(isWellFormed(text)).toBe(true);
+      expect(toWellFormed(text)).toBe(text);
+    }
+  });
+
+  it('finds a lone high or low surrogate anywhere', () => {
+    expect(isWellFormed(HIGH)).toBe(false);
+    expect(isWellFormed(LOW)).toBe(false);
+    expect(isWellFormed(`a${HIGH}b`)).toBe(false);
+    expect(isWellFormed(`${LOW}${HIGH}`)).toBe(false);
+    expect(isWellFormed(`ok ${HIGH}${LOW} then ${HIGH}`)).toBe(false);
+  });
+
+  it('replaces each lone surrogate with U+FFFD and keeps the pairs', () => {
+    expect(toWellFormed(HIGH)).toBe('�');
+    expect(toWellFormed(`a${LOW}b${HIGH}`)).toBe('a�b�');
+    expect(toWellFormed(`${HIGH}${HIGH}${LOW}`)).toBe(`�${HIGH}${LOW}`);
+    expect(toWellFormed(`${LOW}${LOW}x`)).toBe('��x');
+    expect(isWellFormed(toWellFormed(`${HIGH}x${LOW}`))).toBe(true);
+  });
+});
diff --git a/apps/api/src/audit/contract/unicode.ts b/apps/api/src/audit/contract/unicode.ts
new file mode 100644
index 0000000..a7bc539
--- /dev/null
+++ b/apps/api/src/audit/contract/unicode.ts
@@ -0,0 +1,41 @@
+// String.prototype.isWellFormed and toWellFormed are ES2024: the template
+// compiles against ES2023 and Hermes may lack them, so the contract carries
+// its own. A lone surrogate is a high surrogate not followed by a low one, or
+// a low surrogate not preceded by a high one.
+
+const isHigh = (code: number) => code >= 0xd800 && code <= 0xdbff;
+const isLow = (code: number) => code >= 0xdc00 && code <= 0xdfff;
+
+/** Index of the first lone surrogate, or -1. */
+function firstLoneSurrogate(text: string, from = 0): number {
+  for (let index = from; index < text.length; index += 1) {
+    const code = text.charCodeAt(index);
+    if (isHigh(code)) {
+      if (isLow(text.charCodeAt(index + 1))) {
+        index += 1;
+        continue;
+      }
+      return index;
+    }
+    if (isLow(code)) return index;
+  }
+  return -1;
+}
+
+export function isWellFormed(text: string): boolean {
+  return firstLoneSurrogate(text) === -1;
+}
+
+/** Every lone surrogate replaced by U+FFFD. */
+export function toWellFormed(text: string): string {
+  let lone = firstLoneSurrogate(text);
+  if (lone === -1) return text;
+  let result = '';
+  let start = 0;
+  while (lone !== -1) {
+    result += `${text.slice(start, lone)}�`;
+    start = lone + 1;
+    lone = firstLoneSurrogate(text, start);
+  }
+  return result + text.slice(start);
+}
