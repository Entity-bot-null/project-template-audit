+/** The contract version this package implements (ADR 0005). */
+export const CONTRACT_VERSION = 1;
+
+/**
+ * Versions Audit Hub accepts: the current one and the previous one, once
+ * there is a previous one.
+ */
+export const SUPPORTED_CONTRACT_VERSIONS: readonly number[] = [CONTRACT_VERSION];
+
+// Every limit of the wire format, in one place. A batch stays inside the
+// template's default JSON body limit (100 kB, docs/api-conventions.md).
+export const LIMITS = {
+  batchEvents: 100,
+  /** Serialized batch, leaving room for the envelope under 100 kB. */
+  batchBytes: 96 * 1024,
+  eventBytes: 16 * 1024,
+  clientBatchEvents: 50,
+  clientBatchBytes: 64 * 1024,
+  /** Events a device keeps queued at most: past it, the oldest are dropped. */
+  clientQueueEvents: 1000,
+  label: 128,
+  userAgent: 512,
+  os: 32,
+  osVersion: 32,
+  deviceModel: 64,
+  detailsBytes: 8 * 1024,
+  changeBytes: 16 * 1024,
+  changedFields: 64,
+  jsonDepth: 4,
+  catalogActions: 500,
+  catalogBytes: 512 * 1024,
+  catalogFields: 32,
+  description: 500,
+} as const;
+
+/** Seconds a signed request's timestamp may differ from the receiver's clock. */
+export const SIGNATURE_WINDOW_SEC = 300;
diff --git a/apps/web/src/audit/report.ts b/apps/web/src/audit/report.ts
new file mode 100644
index 0000000..c4c5364
--- /dev/null
+++ b/apps/web/src/audit/report.ts
@@ -0,0 +1,43 @@
+/** The page's queue, in memory: at most this many events, the oldest dropped first. */
+export const QUEUE_MAX = 20;
+
+// The part of the SPA connector in the initial bundle: a buffer the app's
+// code reports into (src/auth/return-path.ts, src/auth/session.ts) before
+// the reporter (reporter.ts, a lazy chunk) is loaded, and whether or not it
+// ever is: the API's capabilities decide (auditClientEvents).
+
+/** One of the page's own events, as the app's code reports it. */
+export interface Reported {
+  /** An action the API's catalog gives to clients. */
+  action: string;
+  details?: Record<string, string>;
+  /** Whose it is, when not the signed-in user's (an expired session's). */
+  userRef?: string;
+  /** Unix milliseconds. */
+  at: number;
+}
+
+const waiting: Reported[] = [];
+let sink: ((event: Reported) => void) | undefined;
+
+/** Reports one of the page's own events: queued until the reporter takes it, and then sent. */
+export function reportAudit(
+  action: string,
+  details?: Record<string, string>,
+  userRef?: string,
+): void {
+  const event: Reported = {
+    action,
+    at: Date.now(),
+    ...(details === undefined ? {} : { details }),
+    ...(userRef === undefined ? {} : { userRef }),
+  };
+  if (sink !== undefined) sink(event);
+  else if (waiting.push(event) > QUEUE_MAX) waiting.shift();
+}
+
+/** The reporter takes what was reported before it, and everything after. */
+export function attachAuditSink(next: ((event: Reported) => void) | undefined): void {
+  sink = next;
+  if (next !== undefined) for (const event of waiting.splice(0)) next(event);
+}
