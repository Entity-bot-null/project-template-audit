+      personalChange: null,
+    });
+    expect(personal).toContain('"v":"personal-v1"');
+    // The columns added later are in the document only when the row has them:
+    // a row without them hashes exactly as before they existed.
+    const base = {
+      eventPk: 'a',
+      ip: '203.0.113.7',
+      userAgent: null,
+      deviceId: null,
+      actorLabel: 'Ann Example',
+      resourceLabel: null,
