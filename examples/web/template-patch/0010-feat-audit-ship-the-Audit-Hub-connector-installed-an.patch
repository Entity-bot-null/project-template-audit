+const fetchActivity = () =>
+  call(api.GET('/api/account/activity', { params: { query: { limit: 20 } } }));
+
+// The account's own sign-ins and changes, as Audit Hub recorded them (the
+// actions marked user-visible, never an address): shown when the API's
+// connector is on. A list, not a table: it counts in the JavaScript budget.
+function ActivitySection() {
+  const { state, retry } = useLoader(fetchActivity);
+  return (
+    <section className="stack" aria-labelledby="activity-heading">
+      <h2 id="activity-heading">Recent activity</h2>
+      {state.kind === 'loading' && <p role="status">Loading your activity…</p>}
+      {state.kind === 'failed' && (
+        <LoadFailed
+          failure={state.failure}
+          retrying={state.retrying}
+          onRetry={() => void retry()}
+        />
+      )}
+      {state.kind === 'loaded' && (
+        <ul>
+          {state.data.items.map(
+            ({ eventId, occurredAt, description, outcome, location, client }) => (
+              <li key={eventId}>
+                {new Date(occurredAt).toLocaleString()}: {description}
+                {outcome === 'success' ? '' : ' (failed)'}
+                {[location?.city, location?.country, client?.browser ?? client?.os]
+                  .filter(Boolean)
+                  .map((part) => ` · ${String(part)}`)}
+              </li>
+            ),
+          )}
+        </ul>
+      )}
+      {state.kind === 'loaded' && state.data.items.length === 0 && <p>Nothing yet.</p>}
+      {/* The geolocation database's license asks for its name where its places show. */}
+      {state.kind === 'loaded' && state.data.attribution !== undefined && (
+        <p className="field-hint">{state.data.attribution}</p>
+      )}
+    </section>
+  );
+}
