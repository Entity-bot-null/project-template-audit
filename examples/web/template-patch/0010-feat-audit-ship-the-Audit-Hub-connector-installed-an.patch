+        for: 10m
+        labels:
+          severity: warning
+        annotations:
+          summary: 'Audit events wait for Audit Hub ({{ $labels.job }}, {{ $labels.deployment_environment_name }})'
+          description: 'The oldest event waiting for Audit Hub is {{ $value | humanizeDuration }} old, for more than 10 minutes. Audit Hub sees nothing new meanwhile; nothing is lost while the queue holds.'
+          runbook_url: docs/incident-response.md#17-audit-hub-connector-behind
