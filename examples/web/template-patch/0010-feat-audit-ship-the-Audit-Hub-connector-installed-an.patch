+      # Audit Hub refuses the connector's requests as a whole (400, 401, 403):
+      # a wrong or revoked key, or a contract it no longer accepts. The
+      # forwarder pauses 5 minutes between tries; it never fixes itself.
+      - alert: ApiAuditHubRefused
+        expr: |
