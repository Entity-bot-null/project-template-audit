+import { returnPath } from './return-path';
+
+afterEach(() => {
+  attachAuditSink(undefined);
+});
+
+describe('returnPath', () => {
+  it('tells Audit Hub of an open-redirect attempt it refused, never of the value', () => {
+    const reported: Reported[] = [];
+    attachAuditSink((event) => reported.push(event));
+
+    expect(returnPath({ from: '/account' })).toBe('/account');
+    expect(returnPath(undefined)).toBe('/');
+    expect(returnPath({})).toBe('/');
+    expect(reported).toEqual([]);
+
+    expect(returnPath({ from: '//evil.example.net' })).toBe('/');
+    expect(returnPath({ from: 'https://evil.example.net' })).toBe('/');
+    expect(returnPath({ from: 42 })).toBe('/');
+    expect(reported.map((event) => event.action)).toEqual([
+      'client.navigation.return_path_rejected',
+      'client.navigation.return_path_rejected',
+      'client.navigation.return_path_rejected',
+    ]);
+    expect(reported.every((event) => event.details === undefined)).toBe(true);
+  });
+
+  it('reports a refused navigation once, however often the guard reads it', () => {
+    const reported: Reported[] = [];
+    attachAuditSink((event) => reported.push(event));
+    const state = { from: '//evil.example.net' };
+
+    expect(returnPath(state)).toBe('/');
+    expect(returnPath(state)).toBe('/');
+    expect(returnPath({ from: undefined })).toBe('/');
+    expect(reported).toHaveLength(1);
+
+    returnPath({ from: '//evil.example.net' });
+    expect(reported).toHaveLength(2);
+  });
+});
