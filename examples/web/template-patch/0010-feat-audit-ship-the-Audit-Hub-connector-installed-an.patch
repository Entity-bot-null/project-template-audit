index 0000000..c4c5364
--- /dev/null
+++ b/apps/web/.audit-connector/pristine/src/audit/report.ts.orig
@@ -0,0 +1,43 @@
+/** The page's queue, in memory: at most this many events, the oldest dropped first. */
+export const QUEUE_MAX = 20;
+
+// The part of the SPA connector in the initial bundle: a buffer the app's
+// code reports into (src/auth/return-path.ts, src/auth/session.ts) before
+// the reporter (reporter.ts, a lazy chunk) is loaded, and whether or not it
+// ever is: the API's capabilities decide (auditClientEvents).
+
+/** One of the page's own events, as the app's code reports it. */
+export interface Reported {
+  /** An action the API's catalog gives to clients. */
+  action: string;
+  details?: Record<string, string>;
+  /** Whose it is, when not the signed-in user's (an expired session's). */
+  userRef?: string;
+  /** Unix milliseconds. */
+  at: number;
+}
+
+const waiting: Reported[] = [];
+let sink: ((event: Reported) => void) | undefined;
+
+/** Reports one of the page's own events: queued until the reporter takes it, and then sent. */
+export function reportAudit(
+  action: string,
+  details?: Record<string, string>,
+  userRef?: string,
+): void {
+  const event: Reported = {
+    action,
+    at: Date.now(),
+    ...(details === undefined ? {} : { details }),
+    ...(userRef === undefined ? {} : { userRef }),
+  };
+  if (sink !== undefined) sink(event);
+  else if (waiting.push(event) > QUEUE_MAX) waiting.shift();
+}
+
+/** The reporter takes what was reported before it, and everything after. */
+export function attachAuditSink(next: ((event: Reported) => void) | undefined): void {
+  sink = next;
+  if (next !== undefined) for (const event of waiting.splice(0)) next(event);
+}
diff --git a/apps/web/.audit-connector/pristine/src/audit/reporter.spec.ts.orig b/apps/web/.audit-connector/pristine/src/audit/reporter.spec.ts.orig
new file mode 100644
index 0000000..da36a70
--- /dev/null
+++ b/apps/web/.audit-connector/pristine/src/audit/reporter.spec.ts.orig
@@ -0,0 +1,198 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { FLUSH_INTERVAL_MS, SDK } from './audit.constants';
+import { ClientEventBatchSchema, type ClientEventBatch } from './contract';
+import { attachAuditSink, QUEUE_MAX, reportAudit } from './report';
+import { blockedOriginOf, type SendOutcome, startAuditReporter } from './reporter';
+
+const NOW = Date.UTC(2026, 9, 17, 12, 0, 0);
+
+function setup(outcome: SendOutcome | (() => Promise<SendOutcome>) = 'sent') {
+  const sent: { batch: ClientEventBatch; keepalive: boolean }[] = [];
+  const state = { user: 'user-ana' as string | null };
+  const stop = startAuditReporter({
+    send: (batch, keepalive) => {
+      sent.push({ batch: structuredClone(batch), keepalive });
+      return typeof outcome === 'function' ? outcome() : Promise.resolve(outcome);
+    },
+    currentUser: () => state.user,
+  });
+  return { sent, state, stop };
+}
+
+function visibility(state: 'visible' | 'hidden') {
+  Object.defineProperty(document, 'visibilityState', { value: state, configurable: true });
+  document.dispatchEvent(new Event('visibilitychange'));
+}
+
+/** The page is hidden (and may be going away): the reporter sends what it has, with keepalive. */
+async function pageHide() {
+  visibility('hidden');
+  await vi.waitFor(() => Promise.resolve());
+}
+
+function violation(effectiveDirective: string, blockedURI: string) {
+  const event = new Event('securitypolicyviolation');
+  Object.assign(event, { effectiveDirective, blockedURI });
+  document.dispatchEvent(event);
+}
+
+beforeEach(() => {
+  vi.useFakeTimers({ now: NOW, toFake: ['Date', 'setInterval', 'clearInterval'] });
+});
+
+afterEach(() => {
+  attachAuditSink(undefined);
+  vi.useRealTimers();
+});
+
+describe('the SPA reporter', () => {
+  it("sends the page's own events, from before it started too, as the contract has them", async () => {
+    reportAudit('client.navigation.return_path_rejected');
+    const { sent, stop } = setup();
+    reportAudit('client.session.expired', undefined, 'user-ana');
+    await pageHide();
+
+    expect(sent).toHaveLength(1);
+    expect(sent[0]?.keepalive).toBe(true);
+    expect(ClientEventBatchSchema.safeParse(sent[0]?.batch).success).toBe(true);
+    expect(sent[0]?.batch.events.map((event) => event.action)).toEqual([
+      'client.navigation.return_path_rejected',
+      'client.session.expired',
+    ]);
+    expect(sent[0]?.batch.events[0]).toMatchObject({
+      occurredAt: new Date(NOW).toISOString(),
+      outcome: 'success',
+      client: { type: 'web', sdk: { name: SDK.name, version: SDK.version } },
+    });
+    stop();
+  });
+
+  it('sends every 30 seconds, and when the page is hidden', async () => {
+    const { sent, stop } = setup();
+    reportAudit('client.navigation.return_path_rejected');
+    vi.advanceTimersByTime(FLUSH_INTERVAL_MS);
+    await vi.waitFor(() => {
+      expect(sent).toHaveLength(1);
+    });
+    expect(sent[0]?.keepalive).toBe(false);
+
+    reportAudit('client.navigation.return_path_rejected');
+    visibility('visible');
+    visibility('hidden');
+    await vi.waitFor(() => {
+      expect(sent).toHaveLength(2);
+    });
+    expect(sent[1]?.keepalive).toBe(true);
+    stop();
+  });
+
+  it('reports a CSP violation once a page, with its origin, never its path', async () => {
+    const { sent, stop } = setup();
+    violation('script-src-elem', 'https://evil.example/x.js?user=ana');
+    violation('script-src-elem', 'https://evil.example/y.js');
+    violation('style-src', 'inline');
+    await pageHide();
+    expect(sent[0]?.batch.events.map((event) => event.details)).toEqual([
+      { directive: 'script-src-elem', blockedOrigin: 'https://evil.example' },
+      { directive: 'style-src', blockedOrigin: 'inline' },
+    ]);
+    stop();
+  });
+
+  it('names where a blocked thing came from: an origin, a keyword, or other', () => {
+    expect(blockedOriginOf('https://cdn.example:8443/a.js?q=1')).toBe('https://cdn.example:8443');
+    expect(blockedOriginOf('eval')).toBe('eval');
+    expect(blockedOriginOf('trusted-types-sink')).toBe('trusted-types-sink');
+    expect(blockedOriginOf('not a url')).toBe('other');
+    expect(blockedOriginOf('about:blank')).toBe('other');
+  });
+
+  it("keeps nothing signed out, and never sends one person's events with another's session", async () => {
+    const { sent, state, stop } = setup();
+    state.user = null;
+    reportAudit('client.navigation.return_path_rejected'); // nobody to send it as: dropped
+    reportAudit('client.session.expired', undefined, 'user-ana'); // waits for Ana
+    await pageHide();
+    expect(sent).toEqual([]);
+
+    state.user = 'user-luis';
+    reportAudit('client.navigation.return_path_rejected');
+    await pageHide();
+    expect(sent[0]?.batch.events.map((event) => event.action)).toEqual([
+      'client.navigation.return_path_rejected',
+    ]);
+    expect(sent[0]?.batch.discardedAtSignOut).toBe(1);
+
+    reportAudit('client.navigation.return_path_rejected');
+    await pageHide();
+    expect(sent[1]?.batch.discardedAtSignOut).toBeUndefined();
+    stop();
+  });
+
+  it("sends an expired session's event when the same person signs in again", async () => {
+    const { sent, state, stop } = setup();
+    state.user = null;
+    reportAudit('client.session.expired', undefined, 'user-ana');
+    state.user = 'user-ana';
+    await pageHide();
+    expect(sent[0]?.batch.events.map((event) => event.action)).toEqual(['client.session.expired']);
+    stop();
+  });
+
+  it('keeps the events when the API cannot take them now, and drops what it refuses', async () => {
+    let outcome: SendOutcome = 'later';
+    const { sent, stop } = setup(() => Promise.resolve(outcome));
+    reportAudit('client.navigation.return_path_rejected');
+    await pageHide();
+    await pageHide();
+    expect(sent.map((attempt) => attempt.batch.events.length)).toEqual([1, 1]);
+
+    outcome = 'refused';
+    await pageHide();
+    await pageHide();
+    expect(sent).toHaveLength(3);
+    stop();
+  });
+
+  it('keeps the events when sending throws, sends one batch at a time, and keeps at most 20', async () => {
+    let answer: (outcome: SendOutcome) => void = () => undefined;
+    let fail = true;
+    const { sent, stop } = setup(() =>
+      fail
+        ? Promise.reject(new Error('bug'))
+        : new Promise<SendOutcome>((resolve) => {
+            answer = resolve;
+          }),
+    );
+    reportAudit('client.navigation.return_path_rejected');
+    await pageHide();
+    fail = false;
+    visibility('hidden');
+    visibility('hidden'); // still sending: no second request
+    for (let index = 0; index < QUEUE_MAX + 5; index += 1) {
+      reportAudit('client.navigation.return_path_rejected');
+    }
+    answer('sent');
+    await vi.waitFor(() => Promise.resolve());
+    await pageHide();
+    expect(sent.map((attempt) => attempt.batch.events.length)).toEqual([1, 1, QUEUE_MAX]);
+    stop();
+  });
+
+  it('stops listening when stopped, and its buffer keeps the newest 20 meanwhile', async () => {
+    const { sent, stop } = setup();
+    stop();
+    for (let index = 0; index < QUEUE_MAX + 3; index += 1) {
+      reportAudit('client.navigation.return_path_rejected', { n: String(index) });
+    }
+    await pageHide();
+    expect(sent).toEqual([]);
+
+    const again = setup();
+    await pageHide();
+    expect(again.sent[0]?.batch.events.map((event) => event.details?.n)).toEqual(
+      Array.from({ length: QUEUE_MAX }, (_, index) => String(index + 3)),
+    );
+    again.stop();
+  });
+});
diff --git a/apps/web/.audit-connector/pristine/src/audit/reporter.ts.orig b/apps/web/.audit-connector/pristine/src/audit/reporter.ts.orig
new file mode 100644
index 0000000..f3b9ea4
--- /dev/null
+++ b/apps/web/.audit-connector/pristine/src/audit/reporter.ts.orig
@@ -0,0 +1,130 @@
+import { FLUSH_INTERVAL_MS, SDK } from './audit.constants';
+// Types only from the contract's index, and uuidv7 from its own module: the
+// chunk gets no schema of the contract (and no Zod), only what it runs.
+import type { ClientEvent, ClientEventBatch, RandomFill } from './contract';
+import { uuidv7 } from './contract/uuidv7';
+import { attachAuditSink, QUEUE_MAX, type Reported } from './report';
+
+// The SPA's side of Audit Hub (docs/audit/connection-guide.md#the-web-app):
+// a lazy chunk, loaded after the first render and only when the API's
+// connector takes the browser's events. It queues the page's own events in
+// memory, per user, and sends them through the app's api client every 30 s
+// and when the page is hidden (keepalive: it may be going away). One
+// person's events are never sent with another's session: they are dropped,
+// and the next batch says how many. Kept small: it counts in the template's
+// total JavaScript budget.
+
+/** What became of a batch: the API answered for it, it may go later (offline, 401, 429, 5xx), or it was refused. */
+export type SendOutcome = 'sent' | 'later' | 'refused';
+
+export interface ReporterDependencies {
+  /** POST /api/audit/client-events through the app's api client; `keepalive` as the page hides. */
+  send(batch: ClientEventBatch, keepalive: boolean): Promise<SendOutcome>;
+  /** The signed-in user's id; null when anonymous. */
+  currentUser(): string | null;
+  /** crypto.getRandomValues by default. */
+  random?: RandomFill;
+}
+
+/** Where a blocked thing came from: an origin, or CSP's keyword (inline, eval…), never a path or a query. */
+export function blockedOriginOf(uri: string): string {
+  try {
+    const { origin } = new URL(uri);
+    if (origin !== 'null') return origin;
+  } catch {
+    if (/^[a-z-]{1,32}$/.test(uri)) return uri;
+  }
+  return 'other';
+}
+
+/** An event, and whose it is. */
+type Queued = [userRef: string, event: ClientEvent];
+
+/** Starts the reporter; answers the stop. */
+export function startAuditReporter(deps: ReporterDependencies): () => void {
+  // uuidv7 fills a new Uint8Array(16): an ArrayBuffer, as Web Crypto asks.
+  const random: RandomFill =
+    deps.random ?? ((bytes) => crypto.getRandomValues(bytes as Uint8Array<ArrayBuffer>));
+  let queue: Queued[] = [];
+  let discarded = 0;
+  let sending = false;
+  const violations = new Set<string>();
+
+  function take(reported: Reported): void {
+    const userRef = reported.userRef ?? deps.currentUser();
+    // Signed out: nothing could send it.
+    if (userRef === null) return;
+    if (
+      queue.push([
+        userRef,
+        {
+          eventId: uuidv7(random, reported.at),
+          occurredAt: new Date(reported.at).toISOString(),
+          action: reported.action,
+          outcome: 'success',
+          client: { type: 'web', sdk: SDK },
+          details: reported.details,
+        },
+      ]) > QUEUE_MAX
+    ) {
+      queue.shift();
+    }
+  }
+
+  async function flush(keepalive: boolean): Promise<void> {
+    const user = deps.currentUser();
+    if (sending || user === null) return;
+    const mine = queue.filter(([userRef]) => userRef === user);
+    discarded += queue.length - mine.length;
+    queue = mine;
+    if (mine.length === 0) return;
+    // A copy: what is recorded while it is sent waits for the next flush.
+    const batch = [...mine];
+    const reported = discarded;
+    sending = true;
+    try {
+      const outcome = await deps.send(
+        {
+          events: batch.map(([, event]) => event),
+          ...(reported > 0 ? { discardedAtSignOut: reported } : {}),
+        },
+        keepalive,
+      );
+      if (outcome !== 'later') queue = queue.filter((queued) => !batch.includes(queued));
+      if (outcome === 'sent') discarded -= reported;
+    } catch {
+      // Kept for the next flush.
+    } finally {
+      sending = false;
+    }
+  }
+
+  const onViolation = ({ effectiveDirective, blockedURI }: SecurityPolicyViolationEvent) => {
+    const directive = effectiveDirective.slice(0, 64);
+    const blockedOrigin = blockedOriginOf(blockedURI);
+    const key = `${directive} ${blockedOrigin}`;
+    // Once a page: a blocked script on every render is one finding.
+    if (violations.has(key)) return;
+    violations.add(key);
+    take({
+      action: 'client.security.csp_violation',
+      details: { directive, blockedOrigin },
+      at: Date.now(),
+    });
+  };
+  // The last moment a page is sure to get, closing or not (pagehide is not).
+  const onHidden = () => {
+    if (document.visibilityState === 'hidden') void flush(true);
+  };
+
+  attachAuditSink(take);
+  document.addEventListener('securitypolicyviolation', onViolation);
+  document.addEventListener('visibilitychange', onHidden);
+  const timer = setInterval(() => void flush(false), FLUSH_INTERVAL_MS);
+  return () => {
+    clearInterval(timer);
+    document.removeEventListener('securitypolicyviolation', onViolation);
+    document.removeEventListener('visibilitychange', onHidden);
+    attachAuditSink(undefined);
+  };
+}
