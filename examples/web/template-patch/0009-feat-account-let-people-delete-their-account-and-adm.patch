+// Deletes the account, with the current password, after a confirmation: it
+// cannot be undone. Every session ends and the sign-in page says so.
+function DeleteAccountForm() {
+  const auth = useAuth();
+  const { formRef, focusInvalid } = useFocusFirstInvalid();
+  const [current, setCurrent] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [failure, setFailure] = useState<string | null>(null);
+  const [submitting, setSubmitting] = useState(false);
+
+  async function submit() {
+    const problem = current.length === 0 ? 'Enter your current password.' : null;
+    setError(problem);
+    setFailure(null);
+    if (problem !== null) return;
+    if (!window.confirm('Delete your account? This cannot be undone.')) return;
+    setSubmitting(true);
+    // Signs this tab and the others out once the API answers (src/auth/session.ts).
+    const result = await auth.deleteAccount(current);
+    if (result.ok) return;
+    setSubmitting(false);
+    const { status } = result.failure;
+    if (status === 403) setError('Your current password is not correct.');
+    else if (status === 409) {
+      setFailure(
+        'You are the last administrator who can sign in: make another account an admin first.',
+      );
+    } else setFailure(describeFailure(result.failure));
+  }
+
+  return (
+    <form
+      className="stack auth-form"
+      noValidate
+      aria-labelledby="delete-heading"
+      ref={formRef}
+      onSubmit={(event) => {
+        event.preventDefault();
+        void submit().then(focusInvalid);
+      }}
+    >
+      <h2 id="delete-heading">Account deletion</h2>
+      <p>Your account and its sessions end at once, and your address gets a notice.</p>
+      {failure !== null && <Alert>{failure}</Alert>}
+      <PasswordField
+        label="Current password"
+        autoComplete="current-password"
+        value={current}
+        onChange={setCurrent}
+        error={error}
+      />
+      <button type="submit" disabled={submitting}>
+        {submitting ? 'Deleting…' : 'Delete my account'}
+      </button>
+    </form>
+  );
+}
