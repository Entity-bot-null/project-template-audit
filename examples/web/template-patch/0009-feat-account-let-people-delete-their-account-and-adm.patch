+import { Logger } from '@nestjs/common';
+import request from 'supertest';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { createTestApp, resetDatabase, type TestApp } from '../../test/app.js';
+import { asUser, bearer, cookiesOf, seedUser, signIn, TEST_PASSWORD } from '../../test/auth.js';
+import { envelopeOf } from '../../test/http.js';
+import {
+  deleteMessagesTo,
+  mailTestOptions,
+  messagesTo,
+  readMessage,
+  skipWithoutMailpit,
+  testAddress,
+} from '../../test/mailpit.js';
+import { MailWorker } from '../infrastructure/mail/mail-worker.service.js';
+import { MAIL_OPTIONS } from '../infrastructure/mail/mail.constants.js';
+
+// Deleting an account, against PostgreSQL and Mailpit: by its owner with the
+// current password, or by an admin. The account and what the schema cascades
+// go at once, every browser is signed out, and the address gets a notice.
+
+describe.skipIf(skipWithoutMailpit)('account deletion (PostgreSQL + Mailpit)', () => {
+  let t: TestApp;
+  let worker: MailWorker;
+  const addresses: string[] = [];
+
+  async function account(role: 'member' | 'admin' = 'member') {
+    const email = testAddress();
+    addresses.push(email);
+    return seedUser(t.prisma, { email, name: 'Grace Hopper', role });
+  }
+
+  /** The notice that reached the address, once the queue is delivered. */
+  async function noticeTo(email: string): Promise<string> {
+    await worker.runOnce();
+    const [newest] = await messagesTo(email);
+    if (newest === undefined) throw new Error(`no message to ${email}`);
+    expect(newest.Subject).toBe('Your Integration account was deleted');
+    return (await readMessage(newest.ID)).text;
+  }
+
+  const remove = (accessToken: string, currentPassword: string) =>
+    request(t.server)
+      .post('/api/account/deletion')
+      .set(bearer(accessToken))
+      .send({ currentPassword });
+
+  beforeEach(async () => {
+    t = await createTestApp((builder) =>
+      builder.overrideProvider(MAIL_OPTIONS).useValue(mailTestOptions()),
+    );
+    worker = t.app.get(MailWorker);
+    vi.spyOn(worker, 'wake').mockImplementation(() => undefined);
+    vi.spyOn(Logger.prototype, 'log').mockImplementation(() => undefined);
+    await resetDatabase(t.prisma);
+    await seedUser(t.prisma, { email: testAddress(), role: 'admin' });
+  });
+
+  afterEach(async () => {
+    for (const email of addresses.splice(0)) await deleteMessagesTo(email);
+    await t.app.close();
+  });
+
+  it('deletes the account with its password: every browser is signed out, the address told', async () => {
+    const owner = await account();
+    const here = await signIn(t.server, owner.email);
+    const elsewhere = await signIn(t.server, owner.email);
+
+    const res = await remove(here.accessToken, TEST_PASSWORD).expect(204);
+    // This browser's cookies are cleared.
+    expect(cookiesOf(res).some((cookie) => cookie.startsWith('refresh_token=;'))).toBe(true);
+    await expect(t.prisma.user.findUnique({ where: { id: owner.id } })).resolves.toBeNull();
+    await expect(t.prisma.session.count({ where: { userId: owner.id } })).resolves.toBe(0);
+
+    await request(t.server).get('/api/users/me').set(bearer(elsewhere.accessToken)).expect(401);
+    await request(t.server)
+      .post('/api/auth/refresh')
+      .set('Cookie', elsewhere.refreshCookie)
+      .expect(401);
+    await request(t.server)
+      .post('/api/auth/sign-in')
+      .send({ email: owner.email, password: TEST_PASSWORD })
+      .expect(401);
+    expect(await noticeTo(owner.email)).toContain(
+      'It was deleted from its account page, with its password.',
+    );
+  });
+
+  it('asks for the current password again: a wrong one deletes nothing', async () => {
+    const owner = await account();
+    const { accessToken } = await signIn(t.server, owner.email);
+    const res = await remove(accessToken, 'not-the-password').expect(403);
+    expect(envelopeOf(res).message).toBe('The current password is wrong');
+    await remove(accessToken, '').expect(400);
+    await expect(t.prisma.user.findUnique({ where: { id: owner.id } })).resolves.not.toBeNull();
+    await request(t.server)
+      .post('/api/account/deletion')
+      .send({ currentPassword: 'x' })
+      .expect(401);
+  });
+
+  it('keeps the last admin who may sign in', async () => {
+    await resetDatabase(t.prisma);
+    const only = await account('admin');
+    const { accessToken } = await signIn(t.server, only.email);
+    const res = await remove(accessToken, TEST_PASSWORD).expect(409);
+    expect(envelopeOf(res).message).toBe('The last admin cannot be deleted');
+
+    await account('admin');
+    await remove(accessToken, TEST_PASSWORD).expect(204);
+  });
+
+  it('lets an admin delete another account, which is told an administrator did', async () => {
+    const admin = await account('admin');
+    const member = await account();
+    const theirs = await signIn(t.server, member.email);
+    await request(t.server)
+      .delete(`/api/users/${member.id}`)
+      .set(asUser(t.app, admin.id, 'admin'))
+      .expect(204);
+    await expect(t.prisma.user.findUnique({ where: { id: member.id } })).resolves.toBeNull();
+    await request(t.server).get('/api/users/me').set(bearer(theirs.accessToken)).expect(401);
+    expect(await noticeTo(member.email)).toContain('An administrator deleted it.');
+  });
+});
