+    description:
+      "The account and its sessions end at once, this browser's cookies are cleared, and a notice goes to its address. 403: the current password is wrong. 409: the last admin who may sign in cannot be deleted, or the password changed meanwhile.",
+  })
+  @ZodBody(DeleteAccountSchema)
+  @ApiResponse({ status: 204, description: 'Deleted' })
+  @ApiErrors(400, 403, 409)
+  async deleteAccount(
