new file mode 100644
index 0000000..fd83525
--- /dev/null
+++ b/apps/api/src/users/admins.ts
@@ -0,0 +1,26 @@
+import { ConflictException } from '@nestjs/common';
+import type { Prisma } from '../prisma/generated/client.js';
+
+// The admin who may sign in that always remains: every change that may take
+// the last one away (a demotion, disabling or deleting an account) goes
+// through these, in its transaction.
+
+type Tx = Prisma.TransactionClient;
+
+/**
+ * Locks every admin's row, in one order: a change that may leave the project
+ * without an admin who may sign in runs one at a time, so two admins demoting,
+ * disabling or deleting each other at once cannot both succeed, and they wait
+ * for each other instead of deadlocking. Take it before the account's own lock.
+ */
+export async function lockAdmins(tx: Tx): Promise<void> {
+  await tx.$queryRaw`SELECT "id" FROM "users" WHERE "role" = 'admin' ORDER BY "id" FOR UPDATE`;
+}
+
+/** 409 unless an admin other than `id` who may sign in remains; under lockAdmins. */
+export async function assertAnotherAdmin(tx: Tx, id: string, refusal: string): Promise<void> {
+  const others = await tx.user.count({
+    where: { role: 'admin', disabledAt: null, id: { not: id } },
+  });
+  if (others === 0) throw new ConflictException(refusal);
+}
