+
+  /**
+   * Deletes the person's own account (the right to erasure), after the
+   * current password is checked again. In one transaction, under the admins'
+   * locks for an admin (the last admin who may sign in stays) and the
+   * account's: the account goes, and with it what the schema cascades (its
+   * sessions, links and queued messages; invitations it sent keep no
+   * sender), and a notice is queued to its address. The caller clears this
+   * browser's cookies.
+   */
+  async deleteAccount(userId: string, currentPassword: string): Promise<void> {
+    const user = await this.prisma.user.findUnique({
+      where: { id: userId },
+      select: { id: true, email: true, role: true, passwordHash: true },
+    });
+    if (user === null) throw new NotFoundException('User not found');
+    if (!(await checkPassword(user.passwordHash, currentPassword))) {
+      // 403, not 401: the session is fine, the confirmation is not.
+      throw new ForbiddenException('The current password is wrong');
+    }
+
+    const payload: AccountDeletedPayload = { deletedAt: new Date().toISOString(), by: 'owner' };
+    await this.prisma.$transaction(async (tx) => {
+      if (user.role === 'admin') await lockAdmins(tx);
+      await lockUser(tx, user.id);
+      const current = await tx.user.findUnique({
+        where: { id: user.id },
+        select: { email: true, role: true, passwordHash: true, disabledAt: true },
+      });
+      // A password change or reset got there first: checked against a
+      // password that is no longer the account's.
+      if (current?.passwordHash !== user.passwordHash) {
+        throw new ConflictException('The password changed meanwhile');
+      }
+      if (current.role === 'admin' && current.disabledAt === null) {
+        await assertAnotherAdmin(tx, user.id, 'The last admin cannot be deleted');
+      }
