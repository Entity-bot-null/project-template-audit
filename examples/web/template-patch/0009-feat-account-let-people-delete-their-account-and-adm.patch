+import { describe, expect, it } from 'vitest';
+import type { Prisma } from '../../../prisma/generated/client.js';
+import type { ClaimedMessage } from '../mail.types.js';
+import { accountDeletedTemplate } from './account-deleted.template.js';
+
+const message = (payload: unknown): ClaimedMessage => ({
+  id: 'm1',
+  kind: 'account_deleted',
+  recipient: 'ada@example.test',
+  // The account is gone: the message has no user.
+  userId: null,
+  payload,
+  attempts: 1,
+  expiresAt: new Date(Date.now() + 60_000),
+  createdAt: new Date(),
+  requestId: null,
+});
+const context = {
+  // The notice reads nothing: there is no account left.
+  tx: {} as Prisma.TransactionClient,
+  product: 'Acme',
+  appOrigin: 'https://app.acme.test',
+};
+
+describe('the account deleted notice', () => {
+  it('says when and by whom, and what to do if it was not the owner, with no link', async () => {
+    const rendered = await accountDeletedTemplate.compose({
+      message: message({ deletedAt: '2026-10-17T12:30:00.000Z', by: 'admin' }),
+      ...context,
+    });
+    expect(rendered?.subject).toBe('Your Acme account was deleted');
+    expect(rendered?.text).toContain('deleted on 2026-10-17 12:30:00 UTC');
+    expect(rendered?.text).toContain('An administrator deleted it.');
+    expect(rendered?.text).toContain('If you did not, tell the people who run Acme');
+    expect(rendered?.text).not.toContain('https://');
+    expect(accountDeletedTemplate.limited).toBe(false);
+  });
+
+  it('names the owner, and still tells with a malformed payload', async () => {
+    const owner = await accountDeletedTemplate.compose({
+      message: message({ deletedAt: '2026-10-17T12:30:00.000Z', by: 'owner' }),
+      ...context,
+    });
+    expect(owner?.text).toContain('It was deleted from its account page, with its password.');
+    const odd = await accountDeletedTemplate.compose({ message: message({}), ...context });
+    expect(odd?.text).toContain('deleted just now');
+  });
+});
diff --git a/apps/api/src/infrastructure/mail/templates/account-deleted.template.ts b/apps/api/src/infrastructure/mail/templates/account-deleted.template.ts
new file mode 100644
index 0000000..40bdf36
--- /dev/null
+++ b/apps/api/src/infrastructure/mail/templates/account-deleted.template.ts
@@ -0,0 +1,49 @@
+import { z } from 'zod';
+import { renderMail } from './layout.js';
+import type { MailTemplate } from './registry.js';
+
+/** What the message is about: queued with the deletion (account/, users/). */
+export const AccountDeletedPayloadSchema = z.object({
+  /** When the account was deleted, ISO 8601. */
+  deletedAt: z.iso.datetime(),
+  /** By its owner, with its password, or by an admin. */
+  by: z.enum(['owner', 'admin']),
+});
+export type AccountDeletedPayload = z.infer<typeof AccountDeletedPayloadSchema>;
+
+// A security notice to the former address of a deleted account: a person who
+// did not delete it learns it. Queued without a user (the deletion takes the
+// account's messages with it), it has no account to point to and no link, and
+// is never held back by the per-address limits.
+export const accountDeletedTemplate: MailTemplate = {
+  limited: false,
+  ttlMs: 24 * 60 * 60_000,
+  compose({ message, product }) {
+    const payload = AccountDeletedPayloadSchema.safeParse(message.payload);
+    const when = payload.success
+      ? `on ${payload.data.deletedAt.replace('T', ' ').replace(/\.\d+Z$|Z$/, '')} UTC`
+      : 'just now';
+    const by =
+      payload.success && payload.data.by === 'admin'
+        ? 'An administrator deleted it.'
+        : 'It was deleted from its account page, with its password.';
+    return Promise.resolve(
+      renderMail(
+        {
+          subject: `Your ${product} account was deleted`,
+          heading: 'Your account was deleted',
+          paragraphs: [
+            `The ${product} account of this address was deleted ${when}.`,
+            by,
+            'Every session of the account was signed out, and the account cannot be used again.',
+          ],
+          footer: [
+            'If you deleted it, there is nothing to do.',
+            `If you did not, tell the people who run ${product}: someone may know your password, and you may use it elsewhere.`,
+          ],
+        },
+        product,
+      ),
+    );
+  },
+};
