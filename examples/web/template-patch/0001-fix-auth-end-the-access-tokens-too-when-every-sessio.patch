+/**
+ * Ends every session of a user and, by raising the account's securityVersion,
+ * every access token already issued (JwtAuthGuard refuses them at once instead
+ * of up to 15 minutes later): an account disabled, a role taken away, a
+ * password change required. Inside a transaction that holds the user's lock.
+ * A change that raises securityVersion itself (a new password) calls
+ * revokeSessionsLocked instead.
+ */
+export async function endSessionsLocked(tx: Tx, userId: string, now = Date.now()): Promise<void> {
+  await revokeSessionsLocked(tx, userId, now);
+  await tx.user.update({ where: { id: userId }, data: { securityVersion: { increment: 1 } } });
+}
