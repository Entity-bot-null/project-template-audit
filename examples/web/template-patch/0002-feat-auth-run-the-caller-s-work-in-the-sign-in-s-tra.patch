From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Audit Hub <audit-hub@audit-hub.invalid>
Date: Sat, 17 Oct 2026 17:01:55 -0600
Subject: [PATCH 02/10] feat(auth): run the caller's work in the sign-in's
 transaction

SessionsService.create() owns the transaction that writes a new
session, so nothing could commit with it: an audit event of the sign-in
had to be written apart, and could survive a sign-in that rolled back.
An optional onCreated(tx) now runs in that transaction once the session
is written; if it fails, neither is kept.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/api/src/auth/auth.int.spec.ts         | 23 +++++++++++++++
 apps/api/src/auth/sessions.service.spec.ts | 34 +++++++++++++++++++++-
 apps/api/src/auth/sessions.service.ts      | 11 +++++--
 3 files changed, 65 insertions(+), 3 deletions(-)

diff --git a/apps/api/src/auth/auth.int.spec.ts b/apps/api/src/auth/auth.int.spec.ts
index 27e527f..6879168 100644
--- a/apps/api/src/auth/auth.int.spec.ts
+++ b/apps/api/src/auth/auth.int.spec.ts
@@ -190,6 +190,29 @@ describe('Auth (integration)', () => {
     await expect(t.prisma.session.count()).resolves.toBe(0);
   });
 
+  it('commits what onCreated writes with the session, or neither when it fails', async () => {
+    const sessions = t.app.get(SessionsService);
+    const user = await t.prisma.user.findUniqueOrThrow({ where: { email: EMAIL } });
+    await expect(
+      sessions.create(user.id, user.passwordHash, async (tx) => {
+        await tx.user.update({ where: { id: user.id }, data: { name: 'Renamed' } });
+        throw new Error('the caller failed');
+      }),
+    ).rejects.toThrow('the caller failed');
+    await expect(t.prisma.session.count()).resolves.toBe(0);
+    await expect(
+      t.prisma.user.findUniqueOrThrow({ where: { id: user.id } }),
+    ).resolves.toMatchObject({ name: user.name });
+
+    await sessions.create(user.id, user.passwordHash, async (tx) => {
+      await tx.user.update({ where: { id: user.id }, data: { name: 'Renamed' } });
+    });
+    await expect(t.prisma.session.count()).resolves.toBe(1);
+    await expect(
+      t.prisma.user.findUniqueOrThrow({ where: { id: user.id } }),
+    ).resolves.toMatchObject({ name: 'Renamed' });
+  });
+
   it('ends every session and every access token already issued at once (revokeAll)', async () => {
     const browser = await signIn(t.server, EMAIL);
     const user = await t.prisma.user.findUniqueOrThrow({ where: { email: EMAIL } });
diff --git a/apps/api/src/auth/sessions.service.spec.ts b/apps/api/src/auth/sessions.service.spec.ts
index 5c27a0a..c6858cb 100644
--- a/apps/api/src/auth/sessions.service.spec.ts
+++ b/apps/api/src/auth/sessions.service.spec.ts
@@ -84,7 +84,7 @@ function fakePrisma(rows: Row[], storedPasswordHash = PASSWORD_HASH) {
     ...tx,
     $transaction: <T>(work: (client: typeof tx) => Promise<T>) => work(tx),
   };
-  return { prisma: prisma as unknown as PrismaService, session, user, $queryRaw };
+  return { prisma: prisma as unknown as PrismaService, tx, session, user, $queryRaw };
 }
 
 function rowFor(token: string, overrides: Partial<Row> = {}): Row {
@@ -135,6 +135,38 @@ describe('SessionsService', () => {
     expect(rows).toEqual([]);
   });
 
+  it("runs onCreated in the session's transaction, once its row is written", async () => {
+    const rows: Row[] = [];
+    const { prisma, tx } = fakePrisma(rows);
+    const rowsSeen: number[] = [];
+    const onCreated = vi.fn(() => {
+      rowsSeen.push(rows.length);
+      return Promise.resolve();
+    });
+    await new SessionsService(prisma).create(USER.id, PASSWORD_HASH, onCreated);
+    // The transaction's own client: what it writes commits with the session.
+    expect(onCreated).toHaveBeenCalledOnce();
+    expect(onCreated).toHaveBeenCalledWith(tx);
+    expect(rowsSeen).toEqual([1]);
+  });
+
+  it('runs no onCreated when no session is started, and passes its failure on', async () => {
+    const onCreated = vi.fn(() => Promise.resolve());
+    const changed = fakePrisma([], '$argon2id$v=19$changed');
+    await expect(
+      new SessionsService(changed.prisma).create(USER.id, PASSWORD_HASH, onCreated),
+    ).rejects.toThrow(UnauthorizedException);
+    expect(onCreated).not.toHaveBeenCalled();
+
+    // Thrown inside the transaction, which the real client then rolls back.
+    const { prisma } = fakePrisma([]);
+    await expect(
+      new SessionsService(prisma).create(USER.id, PASSWORD_HASH, () =>
+        Promise.reject(new Error('the caller failed')),
+      ),
+    ).rejects.toThrow('the caller failed');
+  });
+
   it('rotates a valid token within its family, under the user lock', async () => {
     const rows = [rowFor('old')];
     const { prisma, $queryRaw } = fakePrisma(rows);
diff --git a/apps/api/src/auth/sessions.service.ts b/apps/api/src/auth/sessions.service.ts
