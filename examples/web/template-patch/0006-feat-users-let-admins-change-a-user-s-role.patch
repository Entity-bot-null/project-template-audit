+/** A transaction over one stored account; `otherAdmins` admins besides it. */
+function setupUpdate(current: { role: 'member' | 'admin' } | null, otherAdmins = 1) {
+  const stored = current === null ? null : { ...record(OTHER_ID), ...current };
+  const user = {
+    findUnique: vi.fn().mockResolvedValue(current),
+    findUniqueOrThrow: vi.fn().mockResolvedValue(stored),
+    update: vi.fn(({ data }: { data: { role: string } }) =>
+      Promise.resolve({ ...stored, role: data.role }),
+    ),
+    count: vi.fn().mockResolvedValue(otherAdmins),
+  };
+  // The admins' and the account's row locks (SELECT ... FOR UPDATE).
+  const $queryRaw = vi.fn().mockResolvedValue([]);
+  const tx = { user, $queryRaw };
+  const prisma = {
+    $transaction: vi.fn(<T>(work: (client: typeof tx) => Promise<T>) => work(tx)),
+  } as unknown as PrismaService;
+  vi.spyOn(Logger.prototype, 'log').mockImplementation(() => undefined);
+  return { service: new UsersService(prisma), user, $queryRaw };
+}
+
+describe('UsersService.update (role)', () => {
+  it("changes the role and raises the securityVersion: the account's access tokens end", async () => {
+    const { service, user, $queryRaw } = setupUpdate({ role: 'member' });
+    await expect(service.update(ADMIN.id, OTHER_ID, { role: 'admin' })).resolves.toMatchObject({
+      id: OTHER_ID,
+      role: 'admin',
+    });
+    expect(user.update).toHaveBeenCalledWith(
+      expect.objectContaining({
+        where: { id: OTHER_ID },
+        data: { role: 'admin', securityVersion: { increment: 1 } },
+      }),
+    );
+    // A promotion leaves every admin in place: only the account's lock.
+    expect($queryRaw).toHaveBeenCalledOnce();
+  });
+
+  it('locks the admins before a demotion, and keeps the last one', async () => {
+    const demoted = setupUpdate({ role: 'admin' }, 1);
+    await demoted.service.update(ADMIN.id, OTHER_ID, { role: 'member' });
+    // The admins, then the account.
+    expect(demoted.$queryRaw).toHaveBeenCalledTimes(2);
+    expect(demoted.user.count).toHaveBeenCalledWith({
+      where: { role: 'admin', id: { not: OTHER_ID } },
+    });
+
+    const last = setupUpdate({ role: 'admin' }, 0);
+    await expect(last.service.update(OTHER_ID, OTHER_ID, { role: 'member' })).rejects.toThrow(
+      new ConflictException('The last admin cannot stop being one'),
+    );
+    expect(last.user.update).not.toHaveBeenCalled();
+  });
+
+  it('changes nothing for the role the account already has', async () => {
+    const { service, user } = setupUpdate({ role: 'member' });
+    await expect(service.update(ADMIN.id, OTHER_ID, { role: 'member' })).resolves.toMatchObject({
+      role: 'member',
+    });
+    expect(user.update).not.toHaveBeenCalled();
+  });
+
+  it('answers 404 for an account that does not exist', async () => {
+    const { service } = setupUpdate(null);
+    await expect(service.update(ADMIN.id, OTHER_ID, { role: 'admin' })).rejects.toThrow(
+      NotFoundException,
+    );
+  });
+});
