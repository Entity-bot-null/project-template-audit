new file mode 100644
index 0000000..ae49a66
--- /dev/null
+++ b/apps/web/src/pages/AdminUserPage.tsx
@@ -0,0 +1,118 @@
+import { useState } from 'react';
+import { Link, useParams } from 'react-router';
+import { api } from '../api/client';
+import { type ApiFailure, call, describeFailure } from '../api/errors';
+import type { Role } from '../auth/types';
+import { Alert } from '../components/Alert';
+import { LoadFailed } from '../components/LoadFailed';
+import { useLoader } from '../hooks/useLoader';
+
+const fetchUser = (id: string) => call(api.GET('/api/users/{id}', { params: { path: { id } } }));
+
+type User = Extract<Awaited<ReturnType<typeof fetchUser>>, { ok: true }>['data'];
+
+/** What a refused change means here, in the words of this page. */
+function changeFailure(failure: ApiFailure): string {
+  if (failure.status === 404) return 'This account no longer exists.';
+  if (failure.status === 409) return 'This is the last admin: make another account an admin first.';
+  return describeFailure(failure);
+}
+
+/**
+ * Admins only: the route is guarded here and, authoritatively, by the API.
+ * One account, and what an admin changes about it: its role (its access
+ * ends at once, and its next refresh carries the new role).
+ */
+export function AdminUserPage() {
+  const { id = '' } = useParams();
+  const { state, retry } = useLoader(() => fetchUser(id), id);
+  // The account as the last change answered it, shown over the one loaded:
+  // no reload, so the page keeps its place and the focus.
+  const [updated, setUpdated] = useState<User | null>(null);
+  const user = updated?.id === id ? updated : state.kind === 'loaded' ? state.data : null;
+  const [notice, setNotice] = useState<string | null>(null);
+  const [failure, setFailure] = useState<string | null>(null);
+
+  async function changeRole(role: Role): Promise<void> {
+    setNotice(null);
+    setFailure(null);
+    const result = await call(
+      api.PATCH('/api/users/{id}', { params: { path: { id } }, body: { role } }),
+    );
+    if (result.ok) {
+      setUpdated(result.data);
+      setNotice(`${result.data.name} is now ${role === 'admin' ? 'an admin' : 'a member'}.`);
+    } else {
+      setFailure(changeFailure(result.failure));
+    }
+  }
+
+  return (
+    <section className="stack" aria-labelledby="user-heading">
+      <p>
+        <Link to="/admin/users">All users</Link>
+      </p>
+      <h1 id="user-heading">{user?.name ?? 'User'}</h1>
+      {user === null && state.kind === 'loading' && <p role="status">Loading the account…</p>}
+      {user === null && state.kind === 'failed' && (
+        <LoadFailed
+          failure={state.failure}
+          retrying={state.retrying}
+          onRetry={() => void retry()}
+        />
+      )}
+      {user !== null && (
+        <>
+          {notice !== null && <Alert tone="info">{notice}</Alert>}
+          {failure !== null && <Alert>{failure}</Alert>}
+          <dl className="account-details">
+            <dt>Email</dt>
+            <dd>{user.email}</dd>
+            <dt>Role</dt>
+            <dd>{user.role}</dd>
+            <dt>Account created</dt>
+            <dd>{new Date(user.createdAt).toLocaleString()}</dd>
+          </dl>
+          {/* A new form when the role it shows changes: it starts from the account's. */}
+          <RoleForm key={user.role} user={user} onChange={changeRole} />
+        </>
+      )}
+    </section>
+  );
+}
+
+function RoleForm({ user, onChange }: { user: User; onChange: (role: Role) => Promise<void> }) {
+  const [role, setRole] = useState<Role>(user.role);
+  const [submitting, setSubmitting] = useState(false);
+  return (
+    <form
+      className="stack auth-form"
+      aria-labelledby="role-heading"
+      onSubmit={(event) => {
+        event.preventDefault();
+        setSubmitting(true);
+        void onChange(role).finally(() => {
+          setSubmitting(false);
+        });
+      }}
+    >
+      <h2 id="role-heading">Change the role</h2>
+      <div className="field">
+        <label htmlFor="user-role">Role</label>
+        <select
+          id="user-role"
+          value={role}
+          onChange={(event) => {
+            setRole(event.target.value === 'admin' ? 'admin' : 'member');
+          }}
+        >
+          <option value="member">Member</option>
+          <option value="admin">Admin</option>
+        </select>
+      </div>
+      <button type="submit" disabled={submitting}>
+        {submitting ? 'Saving…' : 'Change role'}
+      </button>
+    </form>
+  );
+}
