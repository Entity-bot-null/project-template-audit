+import type { Page } from '@playwright/test';
+import { type Account, createAccount } from './support/accounts.js';
+import { expect, test } from './support/fixtures.js';
+
+// What an administrator changes about an account, in real browsers: the
+// administrator's, and the person's own, signed in at the same time.
+
+// The development administrator created by the API seed (apps/api/src/seed/seed.ts).
+const ADMIN = { email: 'admin@example.com', password: 'admin-password' };
+
+async function signIn(page: Page, email: string, password: string) {
+  await page.goto('/sign-in');
+  await page.getByLabel('Email').fill(email);
+  await page.getByLabel('Password', { exact: true }).fill(password);
+  await page.getByRole('button', { name: 'Sign in' }).click();
+}
+
+/**
+ * From the home page, through the list of users, to one account's page: by
+ * its row's address, as names repeat (other suites create accounts too).
+ */
+async function openAccount(page: Page, account: Account) {
+  await page.getByRole('link', { name: 'Users' }).click();
+  await page.getByRole('row').filter({ hasText: account.email }).getByRole('link').click();
+  await expect(page.getByRole('heading', { name: account.name, level: 1 })).toBeVisible();
+}
+
+test('an administrator makes a member an admin: their next page has the admin pages', async ({
+  page,
+  browser,
+}) => {
+  const person = createAccount('Katherine Johnson');
+  const theirs = await browser.newContext();
+  const theirPage = await theirs.newPage();
+  await signIn(theirPage, person.email, person.password);
+  await expect(theirPage.getByRole('heading', { name: `Welcome, ${person.name}` })).toBeVisible();
+  await expect(theirPage.getByRole('link', { name: 'Users' })).toHaveCount(0);
+
+  await signIn(page, ADMIN.email, ADMIN.password);
+  await expect(page.getByRole('heading', { name: 'Welcome, Admin' })).toBeVisible();
+  await openAccount(page, person);
+  await page.getByLabel('Role', { exact: true }).selectOption('admin');
+  await page.getByRole('button', { name: 'Change role' }).click();
+  await expect(
+    page.getByRole('status').filter({ hasText: `${person.name} is now an admin.` }),
+  ).toBeVisible();
+
+  // Their access token ended with the change; the session goes on, with the new role.
+  await theirPage.reload();
+  await expect(theirPage.getByRole('link', { name: 'Users' })).toBeVisible();
+  await theirs.close();
+});
