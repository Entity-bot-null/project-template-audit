+import { screen } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { resetForTests, setSession } from '../auth/session';
+import { admin, member } from '../test/fixtures';
+import { failure, ok, stubFetch } from '../test/http';
+import { renderRoute } from '../test/render';
+
+const USER = `GET /api/users/${member.id}`;
+const UPDATE = `PATCH /api/users/${member.id}`;
+const record = (changes: Partial<typeof member> = {}) => ({
+  ...member,
+  createdAt: '2026-01-01T00:00:00.000Z',
+  ...changes,
+});
+const PAGE = `/admin/users/${member.id}`;
+
+beforeEach(() => {
+  resetForTests();
+  setSession({ accessToken: 'admin-token', expiresIn: 900, user: admin });
+});
+afterEach(() => {
+  resetForTests();
+});
+
+describe('AdminUserPage', () => {
+  it('shows the account, with a way back to every user', async () => {
+    stubFetch({ [USER]: () => ok(record()) });
+    renderRoute(PAGE);
+
+    expect(await screen.findByRole('heading', { name: member.name })).toBeInTheDocument();
+    expect(screen.getByText(member.email)).toBeInTheDocument();
+    expect(screen.getByRole('link', { name: 'All users' })).toHaveAttribute('href', '/admin/users');
+  });
+
+  it('changes the role, and shows the account as the API answered', async () => {
+    const { calls } = stubFetch({
+      [USER]: () => ok(record()),
+      [UPDATE]: () => ok(record({ role: 'admin' })),
+    });
+    renderRoute(PAGE);
+    const user = userEvent.setup();
+    await user.selectOptions(await screen.findByLabelText('Role'), 'admin');
+    await user.click(screen.getByRole('button', { name: 'Change role' }));
+
+    expect(await screen.findByText(`${member.name} is now an admin.`)).toBeInTheDocument();
+    const update = calls.find((request) => request.method === 'PATCH');
+    expect(await update?.json()).toEqual({ role: 'admin' });
+    expect(screen.getByText('admin', { selector: 'dd' })).toBeInTheDocument();
+    expect(screen.getByLabelText('Role')).toHaveValue('admin');
+  });
+
+  it('says why the last admin keeps the role, and when the account is gone', async () => {
+    let answer = () => failure(409, 'The last admin cannot stop being one');
+    stubFetch({ [USER]: () => ok(record({ role: 'admin' })), [UPDATE]: () => answer() });
+    renderRoute(PAGE);
+    const user = userEvent.setup();
+    await user.selectOptions(await screen.findByLabelText('Role'), 'member');
+    await user.click(screen.getByRole('button', { name: 'Change role' }));
+    expect(await screen.findByRole('alert')).toHaveTextContent(
+      'This is the last admin: make another account an admin first.',
+    );
+
+    answer = () => failure(404, 'User not found');
+    await user.click(screen.getByRole('button', { name: 'Change role' }));
+    expect(await screen.findByText('This account no longer exists.')).toBeInTheDocument();
+  });
+
+  it('explains a failure to load and retries on demand', async () => {
+    let attempt = 0;
+    stubFetch({
+      [USER]: () => (attempt++ === 0 ? failure(503, 'Database unreachable') : ok(record())),
+    });
+    renderRoute(PAGE);
+
+    expect(await screen.findByRole('alert')).toHaveTextContent('The service is unavailable');
+    await userEvent.setup().click(screen.getByRole('button', { name: 'Retry' }));
+    expect(await screen.findByRole('heading', { name: member.name })).toBeInTheDocument();
+  });
+});
