-import { USER_SELECT } from './dto/user.schemas.js';
+import { type UpdateUserDto, USER_SELECT } from './dto/user.schemas.js';
 
 type User = Awaited<ReturnType<UsersService['me']>>;
+type Tx = Prisma.TransactionClient;
+
+// READ COMMITTED, as every transaction that takes a user's lock
+// (sessions.service.ts): what it reads after a lock is what the transaction
+// it waited for committed.
+const USER_TRANSACTION = { isolationLevel: Prisma.TransactionIsolationLevel.ReadCommitted };
 
 @Injectable()
 export class UsersService {
+  private readonly logger = new Logger(UsersService.name);
+
   constructor(private readonly prisma: PrismaService) {}
 
   async me(id: string) {
@@ -45,4 +55,46 @@ export class UsersService {
     if (!user) throw new NotFoundException('User not found');
     return user;
   }
+
+  /**
+   * An admin changes an account, their own included: its role. In one
+   * transaction under the account's lock, the change raises the account's
+   * securityVersion, so its access tokens end at once and the next refresh
+   * carries the new role (its sessions go on). One admin always remains.
+   */
+  async update(adminId: string, id: string, changes: UpdateUserDto): Promise<User> {
+    const user = await this.prisma.$transaction(async (tx) => {
+      if (changes.role !== 'admin') await lockAdmins(tx);
+      await lockUser(tx, id);
+      const current = await tx.user.findUnique({ where: { id }, select: { role: true } });
+      if (!current) throw new NotFoundException('User not found');
+      if (current.role === changes.role) {
+        return tx.user.findUniqueOrThrow({ where: { id }, select: USER_SELECT });
+      }
+      if (current.role === 'admin') await assertAnotherAdmin(tx, id);
+      return tx.user.update({
+        where: { id },
+        data: { role: changes.role, securityVersion: { increment: 1 } },
+        select: USER_SELECT,
+      });
+    }, USER_TRANSACTION);
+    this.logger.log(`User ${id} has the role ${user.role}, set by admin ${adminId}`);
+    return user;
+  }
+}
+
+/**
+ * Locks every admin's row, in one order: a change that may leave the project
+ * without an admin (a demotion) runs one at a time, so two admins demoting
+ * each other at once cannot both succeed, and they wait for each other
+ * instead of deadlocking.
+ */
+async function lockAdmins(tx: Tx): Promise<void> {
+  await tx.$queryRaw`SELECT "id" FROM "users" WHERE "role" = 'admin' ORDER BY "id" FOR UPDATE`;
+}
+
+/** 409 unless an admin other than `id` remains; under lockAdmins. */
+async function assertAnotherAdmin(tx: Tx, id: string): Promise<void> {
+  const others = await tx.user.count({ where: { role: 'admin', id: { not: id } } });
+  if (others === 0) throw new ConflictException('The last admin cannot stop being one');
 }
