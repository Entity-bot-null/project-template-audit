index 0000000..d987cfa
--- /dev/null
+++ b/apps/api/src/users/user-changes.int.spec.ts
@@ -0,0 +1,96 @@
+import { ConflictException } from '@nestjs/common';
+import request from 'supertest';
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'vitest';
+import { MISSING_ID } from '../../test/access.js';
+import { createTestApp, resetDatabase, type TestApp } from '../../test/app.js';
+import { asUser, bearer, seedUser, signIn } from '../../test/auth.js';
+import { envelopeOf } from '../../test/http.js';
+import type { UserResponse } from './dto/user.schemas.js';
+import { UsersService } from './users.service.js';
+
+interface Seeded {
+  id: string;
+  email: string;
+}
+
+// What admins change about accounts (PATCH /api/users/:id), against
+// PostgreSQL: the access rules, the end of the account's access tokens, and
+// the admin that always remains, under concurrency too.
+describe('Changes to users (integration)', () => {
+  let t: TestApp;
+  let admin: Seeded;
+  let member: Seeded;
+
+  beforeAll(async () => {
+    t = await createTestApp();
+  });
+
+  beforeEach(async () => {
+    await resetDatabase(t.prisma);
+    admin = await seedUser(t.prisma, { email: 'admin@example.com', role: 'admin' });
+    member = await seedUser(t.prisma, { email: 'member@example.com' });
+  });
+
+  afterAll(async () => {
+    await t.app.close();
+  });
+
+  const asAdmin = () => asUser(t.app, admin.id, 'admin');
+  const patch = (id: string, body: object) =>
+    request(t.server).patch(`/api/users/${id}`).send(body);
+
+  describe('PATCH /api/users/:id (admins only): the role', () => {
+    it('needs an admin', async () => {
+      await patch(member.id, { role: 'admin' }).expect(401);
+      await patch(member.id, { role: 'admin' }).set(asUser(t.app, member.id)).expect(403);
+      await expect(t.prisma.user.findUnique({ where: { id: member.id } })).resolves.toMatchObject({
+        role: 'member',
+      });
+    });
+
+    it('validates the change and the id, and answers 404 for an account that does not exist', async () => {
+      await patch(member.id, { role: 'owner' }).set(asAdmin()).expect(400);
+      await patch(member.id, { role: 'admin', email: 'x@example.com' }).set(asAdmin()).expect(400);
+      await patch('123', { role: 'admin' }).set(asAdmin()).expect(400);
+      await patch(MISSING_ID, { role: 'admin' }).set(asAdmin()).expect(404);
+    });
+
+    it("changes the role: the account's access tokens end at once, its next refresh carries it", async () => {
+      const browser = await signIn(t.server, member.email);
+      const res = await patch(member.id, { role: 'admin' }).set(asAdmin()).expect(200);
+      expect(envelopeOf<UserResponse>(res).data).toMatchObject({ id: member.id, role: 'admin' });
+
+      await request(t.server).get('/api/users/me').set(bearer(browser.accessToken)).expect(401);
+      const refreshed = await request(t.server)
+        .post('/api/auth/refresh')
+        .set('Cookie', browser.refreshCookie)
+        .expect(200);
+      expect(envelopeOf<{ user: UserResponse }>(refreshed).data.user.role).toBe('admin');
+    });
+
+    it('keeps the last admin, and lets an admin step down while another remains', async () => {
+      const res = await patch(admin.id, { role: 'member' }).set(asAdmin()).expect(409);
+      expect(envelopeOf(res).message).toBe('The last admin cannot stop being one');
+
+      await patch(member.id, { role: 'admin' }).set(asAdmin()).expect(200);
+      await patch(admin.id, { role: 'member' }).set(asAdmin()).expect(200);
+      await expect(t.prisma.user.count({ where: { role: 'admin' } })).resolves.toBe(1);
+    });
+
+    it('lets only one of two admins demoting each other at once succeed', async () => {
+      const second = await seedUser(t.prisma, { email: 'second@example.com', role: 'admin' });
+      // Through the service: over HTTP, the first change can end the other
+      // admin's access token (401) before its request reaches the lock.
+      const users = t.app.get(UsersService);
+      const outcomes = await Promise.allSettled([
+        users.update(admin.id, second.id, { role: 'member' }),
+        users.update(second.id, admin.id, { role: 'member' }),
+      ]);
+      expect(outcomes.map((outcome) => outcome.status).sort()).toEqual(['fulfilled', 'rejected']);
+      expect(outcomes.find((outcome) => outcome.status === 'rejected')?.reason).toBeInstanceOf(
+        ConflictException,
+      );
+      await expect(t.prisma.user.count({ where: { role: 'admin' } })).resolves.toBe(1);
+    });
+  });
+});
