+test('an administrator disables an account: the person is signed out and cannot sign in until it is enabled', async ({
+  page,
+  browser,
+}) => {
+  const person = createAccount('Christine Darden');
+  const theirs = await browser.newContext();
+  const theirPage = await theirs.newPage();
+  await signIn(theirPage, person.email, person.password);
+  await expect(theirPage.getByRole('heading', { name: `Welcome, ${person.name}` })).toBeVisible();
+
+  await signIn(page, ADMIN.email, ADMIN.password);
+  await expect(page.getByRole('heading', { name: 'Welcome, Admin' })).toBeVisible();
+  await openAccount(page, person);
+  page.once('dialog', (dialog) => void dialog.accept());
+  await page.getByRole('button', { name: 'Disable the account' }).click();
+  await expect(
+    page.getByRole('status').filter({ hasText: `${person.name} cannot sign in any more` }),
+  ).toBeVisible();
+
+  // Signed out at once: their next page is the sign-in page.
+  await theirPage.reload();
+  await expect(theirPage).toHaveURL(/\/sign-in$/);
+  await signIn(theirPage, person.email, person.password);
+  await expect(theirPage.getByRole('alert')).toHaveText('Invalid email or password.');
+
+  await page.getByRole('button', { name: 'Enable the account' }).click();
+  await expect(
+    page.getByRole('status').filter({ hasText: `${person.name} can sign in again.` }),
+  ).toBeVisible();
+  await signIn(theirPage, person.email, person.password);
+  await expect(theirPage.getByRole('heading', { name: `Welcome, ${person.name}` })).toBeVisible();
+  await theirs.close();
+});
