+
+  /**
+   * An admin requires a new password of another account (a password that may
+   * have leaked). In one transaction under the account's lock: the time is
+   * set (an earlier one is kept), and every session and access token ends, so
+   * the person is signed out everywhere at once. Their next sign-in with the
+   * right password answers 403 and sends a reset link; the reset clears it.
+   */
+  async requirePasswordChange(adminId: string, id: string): Promise<User> {
+    if (id === adminId) {
+      throw new ConflictException('Change your own password from your account page');
+    }
+    const user = await this.prisma.$transaction(async (tx) => {
+      await lockUser(tx, id);
+      const current = await tx.user.findUnique({
+        where: { id },
+        select: { passwordChangeRequiredAt: true },
+      });
+      if (!current) throw new NotFoundException('User not found');
+      await endSessionsLocked(tx, id);
+      return tx.user.update({
+        where: { id },
+        data: { passwordChangeRequiredAt: current.passwordChangeRequiredAt ?? new Date() },
+        select: USER_SELECT,
+      });
+    }, USER_TRANSACTION);
+    this.logger.log(`User ${id} must choose a new password, required by admin ${adminId}`);
+    return user;
+  }
 }
 
